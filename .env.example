# FlowLedger — Environment Variable Template
#
# Copy this file to .env and edit the values:
#   cp .env.example .env
#
# NEVER commit your .env — it is gitignored.
#
# Used by:
#   docker compose --profile infra up -d
#   docker compose --profile full up --build
# POSTGRES_PASSWORD and API__KEY are REQUIRED for every profile (compose validates
# the whole file): docker compose refuses to start while either is empty.
#
# .NET configuration uses __ (double underscore) as the section separator,
# so  Mx__ApiKey  in an environment variable maps to the config key  Mx:ApiKey.

# ── PostgreSQL ────────────────────────────────────────────────────────────────

# Password for the 'flowledger' PostgreSQL user.
# REQUIRED for all compose profiles.
# The compose YAML constructs ConnectionStrings__flowledger from this value —
# you do NOT need to set ConnectionStrings__flowledger separately.
# Generate a strong random value: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Connection strings (set automatically by compose — no action needed) ──────
# docker-compose.yml derives these from POSTGRES_PASSWORD above.
# Uncomment ONLY if you need to override them (e.g. pointing at an external DB).
# NOTE: compose hard-codes ConnectionStrings__flowledger for the api and worker services, so a value here is NOT picked
# up; use a docker-compose.override.yml instead (see docs/self-hosting/database.md). Use Npgsql syntax for TLS: SSL Mode=VerifyFull.
# ConnectionStrings__flowledger=Host=postgres;Port=5432;Database=flowledger;Username=flowledger;Password=<POSTGRES_PASSWORD>
# ConnectionStrings__redis=redis:6379

# ── Redis ─────────────────────────────────────────────────────────────────────

# Password Redis requires (compose runs it with --requirepass and puts the password in the
# api/worker connection string). If unset, compose falls back to POSTGRES_PASSWORD, but use a
# separate value. Hex only (no comma/semicolon): openssl rand -hex 32
REDIS_PASSWORD=

# ── Backups (compose full profile) ────────────────────────────────────────────
# Backups and pre-migration snapshots are written to the backups_data volume (/data/backups).
# Optional off-site copy via restic (see docs/self-hosting/backups-and-recovery.md):
# Backup__Restic__Repository=b2:YOUR-BUCKET:flowledger
# RESTIC_PASSWORD=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# ── API authentication ────────────────────────────────────────────────────────

# Shared secret that clients must send as a bearer token (config key: Api:Key).
# The Web frontend and Worker both use this to authenticate against the API.
# REQUIRED. Generate a strong random value: openssl rand -hex 32
# (the API refuses to start outside Development with the old dev default key).
API__KEY=

# ── Hosting mode ──────────────────────────────────────────────────────────────
# Compose runs the apps as Production by default. Development enables the
# dev tenant fallback and is for local debugging only.
# ASPNETCORE_ENVIRONMENT=Production
#
# Without OIDC sign-in (below) the Web UI has NO login and refuses to start
# outside Development. Set this to true ONLY on a trusted single-user host
# (all ports are bound to 127.0.0.1 by compose).
# AUTH__ALLOWANONYMOUS=false

# ── MX financial-data integration ────────────────────────────────────────────
#
# By default Mx__Enabled=false and the Simulated (fake-data) provider is used —
# no API credentials are needed and no MX charges are incurred.
#
# To use real bank data, set Mx__Enabled=true and fill in all fields below.
# See docs/architecture/mx-integration.md for the full walkthrough, and
# docs/self-hosting/production.md for secret-rotation guidance.

# Feature flag — false → Simulated provider, true → real MX API.
# Leave false for local dev and CI unless you specifically need live bank data.
Mx__Enabled=false

# Your MX API key (from https://dashboard.mx.com → API Keys).
# Required when Mx__Enabled=true.
# Mx__ApiKey=your-mx-api-key-here

# Your MX client ID (from https://dashboard.mx.com → API Keys).
# Required when Mx__Enabled=true.
# Mx__ClientId=your-mx-client-id-here

# MX base URL.
#   Sandbox:    https://int-api.mx.com   ← use this for testing
#   Production: https://api.mx.com       ← use this for real users
# Required when Mx__Enabled=true.
Mx__BaseUrl=https://int-api.mx.com

# HMAC secret used to verify the signature on inbound MX webhook payloads.
# Set the matching value in your MX dashboard → Webhooks → Signing Secret.
# Required when Mx__Enabled=true.
# Mx__WebhookSecret=your-mx-webhook-secret-here

# Institution code used during the MX Connect widget hand-off flow.
# "mxbank" is MX's standard sandbox test institution and is the default.
# In production the user picks their institution inside the MX Connect widget;
# override here only if your deployment uses a fixed institution code.
# Config key: Mx:Provider:DefaultInstitutionCode
Mx__Provider__DefaultInstitutionCode=mxbank

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────

# OTLP endpoint for traces, metrics, and logs.
# Leave commented out to disable telemetry export (stdout logging still works).
# Example for a local collector: http://otel-collector:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Multi-user sign-in (OIDC, any provider) — see docs/self-hosting/multi-user-auth.md ──
# (compose maps the upper-case names below to Auth__Oidc__* on the web service)
# AUTH__OIDC__AUTHORITY=https://auth.example.com/application/o/flowledger/
# AUTH__OIDC__CLIENTID=
# AUTH__OIDC__CLIENTSECRET=
# TENANCY__LEGACYOWNEREMAIL=you@example.com

# ── Home Assistant alerts (optional) ───────────────────────────────────────────
# The webhook URL is entered in the app (Home Assistant page) and stored write-only and encrypted. A key is REQUIRED (without
# one FlowLedger refuses to store the URL); the api and worker must share the same value:
#   openssl rand -base64 32
# HomeAssistant__EncryptionKey=
# Worker schedule for pushing alerts (default hourly at :05) and a master off switch:
# HomeAssistant__CronExpression=0 5 * * * ?
# HomeAssistant__Enabled=true

# ── Settings NOT forwarded by docker-compose.yml ──────────────────────────────────
# docker-compose.yml passes only an explicit list of variables to the containers (POSTGRES_PASSWORD, API__KEY, AUTH__*,
# TENANCY__LEGACYOWNEREMAIL, HomeAssistant__EncryptionKey) and hard-codes Mx__Enabled=false. Every setting below is
# a valid .NET configuration key, but putting it in .env alone does nothing under compose: add it to the `environment:` of
# the api/worker services in a docker-compose.override.yml (or set it directly in the process environment / AppHost
# user-secrets). Secrets belong in a secrets manager, see docs/self-hosting/production.md.

# Encrypts integration credentials and signing secrets at rest (base64 of 32 bytes; falls back to HomeAssistant__EncryptionKey).
# Without a key FlowLedger refuses to store them. api and worker must share it:  openssl rand -base64 32
# Integrations__EncryptionKey=
# Preferred (v2 envelope, rotation-aware): one key for all stored secrets; keep the old one in ...Previous while rotating.
# Secrets__EncryptionKey=
# Secrets__EncryptionKeyPrevious=

# Per-tenant HMAC signing of the Web -> API tenant assertion (recommended for multi-user stacks; same value on api and web).
# Api__TenantSigningKey=

# ── SimpleFIN Bridge (replaces Simulated/MX; the process is then treated as PRODUCTION data) ──
# The access URL embeds credentials. Produce it with scripts/simplefin-claim.ps1. Never commit it.
# SimpleFin__Enabled=false
# SimpleFin__AccessUrl=
# SimpleFin__HistoryDays=90
# SimpleFin__BackfillDays=0
# SimpleFin__OverlapDays=7

# ── Quiltt embedded connector (see docs/adr/0017-quiltt-embedded-connector.md) ──
# Quiltt__Enabled=false
# Quiltt__Environment=sandbox          # sandbox | production (production = real bank data)
# Quiltt__ApiKeySecret=
# Quiltt__ConnectorId=
# Quiltt__WebhookSecret=
# Quiltt__InitialHistoryDays=730
# Quiltt__OverlapDays=14

# ── MX environment marker and API cost controls ──
# Mx__Environment=sandbox              # must agree with the data_environment marker, see backups-and-recovery.md
# Mx__Provider__DailyCallBudget=500
# Mx__Provider__MonthlyCallBudget=5000
# Mx__Provider__CallsPaused=false

# ── Sync and Worker ──
# Sync__MinIntervalMinutes=30          # minimum gap between syncs per tenant for real providers
# Worker__MaxParallelTenants=1         # 1-16; see docs/self-hosting/database.md before raising

# ── Backups and archive (see docs/self-hosting/backups-and-recovery.md) ──
# Backup__Enabled=true
# Backup__CronExpression=0 15 3 * * ?
# Backup__Directory=
# Backup__KeepLocalSnapshots=30
# Backup__DrillAfterBackup=true
# Backup__Restic__Repository=b2:YOUR-BUCKET:flowledger
# Backup__Restic__PasswordFile=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# ObjectStorage__RootPath=/data/objects   # raw provider payload archive; MUST be a persistent volume (ADR 0007)

# ── Data admin, environment guard, reverse proxy ──
# DataAdmin__Key=                     # REQUIRED outside Development for export/import/backup-now/tenant offboarding (32+ chars, same on api and web; openssl rand -hex 32)
# DataAdmin__AllowRemote=false         # export/import/backup-now accept loopback callers only unless true
# DataEnvironment__AdoptExistingAsProduction=false
# ForwardedHeaders__Enabled=false      # true only when the Web port is reachable solely through your TLS proxy
# Database__MigrateOnStartup=true      # compose sets this for the api
