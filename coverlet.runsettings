<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage collection settings (coverlet.collector). Used by CI via:
    dotnet test with the settings option pointing at this file and the XPlat Code Coverage collector
  Excludes generated/migration code so the numbers reflect hand-written logic.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/Migrations/**/*.cs,**/*.Designer.cs,**/*.g.cs,**/*.generated.cs,**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <Exclude>[*.Tests]*,[*.Tests.*]*</Exclude>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
