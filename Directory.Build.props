<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902</WarningsNotAsErrors>
    <!-- High and critical advisories in any dependency (including transitive) fail the build; low/moderate stay warnings. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Per-rule severities live in .editorconfig (see the #113 ratchet plan there). -->
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- IDE0005 (unused usings) only runs in the build when documentation generation is on. The XML-comment quality warnings that
         switching it on surfaces (missing or malformed docs, unresolved crefs) predate this and are parked here, not fixed: shrink the list as docs are cleaned up. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0419;CS1570;CS1573;CS1574;CS1587;CS1734</NoWarn>
    <RootNamespace>$(MSBuildProjectName.Replace('-', '_'))</RootNamespace>
    <Authors>FlowLedger contributors</Authors>
    <Copyright>Copyright (c) FlowLedger contributors</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/JerrettDavis/FlowLedger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <!-- NuGet lock files (#190): every project commits a packages.lock.json; CI and every Dockerfile restore in locked mode, so a
         floating or tampered dependency fails the restore instead of silently changing the build. Refresh: see CONTRIBUTING.md. -->
    <RestorePackagesWithLockFile Condition="'$(MSBuildProjectExtension)' == '.csproj'">true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Banned APIs (#113): BannedSymbols.txt at the repo root states the rationale per entry. Production code only; tests may print and block. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <!-- Curated Meziantou rule set (#113): every rule parked at none except the ones the tree is held to; reasons in the file and in .editorconfig. -->
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)eng/meziantou.globalconfig" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>
</Project>
