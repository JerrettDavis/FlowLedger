<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- EF Core + PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- In-process sentence embeddings (ONNX) for local categorization / similarity: no external model server -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <!-- Quartz scheduler (Api on-demand sync job; Worker scheduled sync/backup jobs) -->
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="FlowLedger.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowLedger.Application\FlowLedger.Application.csproj" />
    <ProjectReference Include="..\FlowLedger.Domain\FlowLedger.Domain.csproj" />
    <ProjectReference Include="..\FlowLedger.Integrations.Abstractions\FlowLedger.Integrations.Abstractions.csproj" />
    <ProjectReference Include="..\FlowLedger.Integrations.Mx\FlowLedger.Integrations.Mx.csproj" />
    <ProjectReference Include="..\FlowLedger.Integrations.Quiltt\FlowLedger.Integrations.Quiltt.csproj" />
    <ProjectReference Include="..\FlowLedger.Integrations.SimpleFin\FlowLedger.Integrations.SimpleFin.csproj" />
    <ProjectReference Include="..\FlowLedger.Integrations.Simulated\FlowLedger.Integrations.Simulated.csproj" />
    <ProjectReference Include="..\FlowLedger.SharedKernel\FlowLedger.SharedKernel.csproj" />
  </ItemGroup>

</Project>
