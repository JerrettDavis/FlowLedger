@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    [Inject] private FlowLedger.Web.Auth.OidcOptions Oidc { get; set; } = default!;

    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _household;

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        _household = FlowLedger.Web.Auth.HouseholdAccess.IsHousehold(user, Oidc);
    }
}
