@inherits LayoutComponentBase
@inject FlowLedgerApiClient ApiClient
@inject SyncCoordinator Sync
@inject ILogger<MainLayout> Logger
@inject IJSRuntime JS
@inject ThemeService ThemeService
@inject DisplaySettingsService DisplayService
@inject PersistentComponentState Persisted
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable

@* ObserveSystemDarkModeChange tells MudBlazor to watch prefers-color-scheme and
   fire IsDarkModeChanged when the OS preference changes at runtime.
   IsDarkMode is one-way bound from our ThemeService so we remain the single
   source of truth; IsDarkModeChanged lets MudBlazor notify us of system changes. *@
<MudThemeProvider Theme="FlowLedgerTheme.Instance"
                  IsDarkMode="ThemeService.IsDarkMode"
                  ObserveSystemDarkModeChange="true"
                  IsDarkModeChanged="OnSystemPreferenceChanged" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="fl-skip-link" href="#main-content">Skip to main content</a>

<MudLayout>
    <AppBar Status="_status" IsOwner="_isOwner" OnToggleDrawer="ToggleDrawer" OnToggleTheme="ToggleTheme" />

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always" Elevation="0" Width="256px" Class="fl-drawer" aria-label="Sidebar">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Class="fw-bold">Navigation</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <main id="main-content" tabindex="-1">
            <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 fl-page">
                <CascadingValue Value="_status">
                    @Body
                </CascadingValue>
            </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private LayoutStatus _status = LayoutStatus.Unknown;
    private const string StatusStateKey = "fl-layout-status";
    private const string DisplayStateKey = "fl-display-settings";
    private PersistingComponentStateSubscription _persistSubscription;

    // True once the user has made an explicit choice that we've persisted;
    // while false, runtime OS-preference changes are applied.
    private bool _hasUserOverride = false;

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Read persisted preference and system preference from the browser.
        // All JS calls are wrapped — failures fall back gracefully.
        bool? persisted = null;
        bool systemPrefersDark = false;

        try
        {
            var raw = await JS.InvokeAsync<string?>("FlowLedgerTheme.getPreference");
            if (raw is "dark")
                persisted = true;
            else if (raw is "light")
                persisted = false;
            // anything else (null / unexpected string) → no persisted pref
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "Could not read theme preference from localStorage; falling back to system preference");
        }

        try
        {
            systemPrefersDark = await JS.InvokeAsync<bool>("FlowLedgerTheme.getSystemPrefersDark");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "Could not read system color-scheme preference; defaulting to light mode");
        }

        _hasUserOverride = persisted.HasValue;
        ThemeService.Initialize(persisted, systemPrefersDark);

        Sync.StartAutoSync();
        // StateHasChanged is called by the ThemeChanged event that Initialize fires.
    }

    public void Dispose()
    {
        _persistSubscription.Dispose();
        ThemeService.ThemeChanged -= OnThemeChanged;
    }

    // ── Theme helpers ─────────────────────────────────────────────────────────

    private void OnThemeChanged() => InvokeAsync(async () =>
    {
        StateHasChanged();
        try { await JS.InvokeVoidAsync("FlowLedgerTheme.applyScheme", ThemeService.IsDarkMode); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException) { Logger.LogDebug(ex, "Could not sync data-theme attribute"); }
    });

    /// <summary>
    /// Fired by MudThemeProvider when the OS/browser preference changes at runtime
    /// (requires ObserveSystemDarkModeChange="true").
    /// </summary>
    private async Task OnSystemPreferenceChanged(bool systemIsDark)
    {
        ThemeService.ApplySystemPreference(systemIsDark, _hasUserOverride);
        await Task.CompletedTask;
    }

    /// <summary>
    /// Explicit user toggle — persists choice to localStorage and sets the
    /// override flag so future OS-preference changes are ignored.
    /// </summary>
    private async Task ToggleTheme()
    {
        var newDark = !ThemeService.IsDarkMode;
        ThemeService.SetDarkMode(newDark);
        _hasUserOverride = true;

        try
        {
            await JS.InvokeAsync<bool>("FlowLedgerTheme.setPreference", newDark ? "dark" : "light");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "Could not persist theme preference to localStorage; preference will not survive reload");
        }
    }

    // ── Drawer ───────────────────────────────────────────────────────────────

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // ── Identity and status ──────────────────────────────────────────────────

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Inject] private FlowLedger.Web.Auth.OidcOptions Oidc { get; set; } = default!;

    // Only the household owner can link banks (the API refuses everyone else), so other users never see the action.
    private bool _isOwner = true;

    protected override async Task OnParametersSetAsync() =>
        _isOwner = FlowLedger.Web.Auth.HouseholdAccess.IsHousehold(AuthState is null ? null : (await AuthState).User, Oidc);

    protected override async Task OnInitializedAsync()
    {
        // Display currency/locale: read from the cookie on the prerender request, then carried to the circuit.
        if (HttpContext is { } http)
        {
            DisplayService.Set(DisplayCultureMiddleware.ReadSettings(http));
        }
        else if (Persisted.TryTakeFromJson<DisplaySettings>(DisplayStateKey, out var display) && display is not null)
        {
            DisplayService.Set(display);
        }

        DisplayService.ApplyToCurrentThread();

        // Prerender loads the status once and hands it to the interactive circuit, so a page load
        // issues one set of API calls (both in parallel) instead of two sequential sets.
        _persistSubscription = Persisted.RegisterOnPersisting(() =>
        {
            Persisted.PersistAsJson(DisplayStateKey, DisplayService.Current);
            if (_status.IsKnown)
            {
                Persisted.PersistAsJson(StatusStateKey, _status);
            }

            return Task.CompletedTask;
        });

        if (Persisted.TryTakeFromJson<LayoutStatus>(StatusStateKey, out var restored) && restored is { IsKnown: true })
        {
            _status = restored;
            return;
        }

        _status = await LayoutStatusLoader.LoadAsync(ApiClient);
    }
}
