@inherits LayoutComponentBase
@inject FlowLedgerApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILogger<MainLayout> Logger
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ThemeService ThemeService
@implements IDisposable

@* ObserveSystemDarkModeChange tells MudBlazor to watch prefers-color-scheme and
   fire IsDarkModeChanged when the OS preference changes at runtime.
   IsDarkMode is one-way bound from our ThemeService so we remain the single
   source of truth; IsDarkModeChanged lets MudBlazor notify us of system changes. *@
<MudThemeProvider Theme="FlowLedgerTheme.Instance"
                  IsDarkMode="ThemeService.IsDarkMode"
                  ObserveSystemDarkModeChange="true"
                  IsDarkModeChanged="OnSystemPreferenceChanged" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Color="Color.Surface" Elevation="0" Class="fl-appbar" aria-label="FlowLedger application bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       aria-label="Toggle navigation drawer" />
        <MudText Typo="Typo.h6" Class="ml-2">FlowLedger</MudText>
        <MudSpacer />
        @if (_syncing)
        {
            <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="mr-2" aria-label="Syncing" />
        }
        @if (_backupAlert is not null && _environment == "production")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Href="data"
                     aria-label="Backup warning">@_backupAlert</MudChip>
        }
        @if (_environment is "demo" or "sandbox")
        {
            <MudChip T="string" Size="Size.Small" Color="@(_environment == "demo" ? Color.Warning : Color.Info)" Variant="Variant.Outlined"
                     aria-label="@($"Data environment {_environment}")">@_environment.ToUpperInvariant() DATA</MudChip>
        }
        @if (_environment == "production")
        {
            <MudTooltip Text="Link a bank or credit union (opens your provider's secure widget)">
                <MudButton StartIcon="@Icons.Material.Filled.AccountBalance"
                           Color="Color.Inherit"
                           Variant="Variant.Text"
                           OnClick="ConnectBank"
                           Disabled="_syncing"
                           aria-label="Connect bank">
                    Connect bank
                </MudButton>
            </MudTooltip>
            <MudTooltip Text="Fetch new data from your connected institutions">
                <MudButton StartIcon="@Icons.Material.Filled.CloudSync"
                           Color="Color.Inherit"
                           Variant="Variant.Text"
                           OnClick="SyncNow"
                           Disabled="_syncing"
                           aria-label="Sync now">
                    Sync now
                </MudButton>
            </MudTooltip>
        }
        else
        {
            <MudTooltip Text="Connect simulated provider and sync demo data">
                <MudButton StartIcon="@Icons.Material.Filled.CloudSync"
                           Color="Color.Inherit"
                           Variant="Variant.Text"
                           OnClick="ConnectAndSync"
                           Disabled="_syncing"
                           aria-label="Connect and sync demo data">
                    Connect &amp; Sync
                </MudButton>
            </MudTooltip>
        }
        <MudTooltip Text="@(ThemeService.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleTheme"
                           aria-label="@(ThemeService.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always" Elevation="0" Width="256px" Class="fl-drawer" aria-label="Main navigation">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Class="fw-bold">Navigation</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 fl-page">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _syncing = false;
    private string _environment = "unknown";
    private string? _backupAlert;

    // ── Auto-sync ─────────────────────────────────────────────────────────────
    // While the app is on screen: sync on load if the last sync is > 1h old, then re-check every few
    // minutes and sync hourly. Hidden tabs never sync (the Worker covers that daily). The server still
    // enforces single-flight, its minimum interval and the provider call budget; any failure or
    // throttle backs the browser off so it never hammers a limited API.
    private static readonly TimeSpan AutoSyncInterval = TimeSpan.FromHours(1);
    private static readonly TimeSpan AutoSyncTick = TimeSpan.FromMinutes(3);
    private static readonly TimeSpan AutoSyncBackoff = TimeSpan.FromHours(2);
    private readonly CancellationTokenSource _autoCts = new();
    private DateTimeOffset? _lastSyncedAt;
    private DateTimeOffset _autoBackoffUntil = DateTimeOffset.MinValue;
    private TimeSpan _serverMinInterval = TimeSpan.FromMinutes(30);

    // True once the user has made an explicit choice that we've persisted;
    // while false, runtime OS-preference changes are applied.
    private bool _hasUserOverride = false;

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Read persisted preference and system preference from the browser.
        // All JS calls are wrapped — failures fall back gracefully.
        bool? persisted = null;
        bool systemPrefersDark = false;

        try
        {
            var raw = await JS.InvokeAsync<string?>("FlowLedgerTheme.getPreference");
            if (raw is "dark")
                persisted = true;
            else if (raw is "light")
                persisted = false;
            // anything else (null / unexpected string) → no persisted pref
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "Could not read theme preference from localStorage; falling back to system preference");
        }

        try
        {
            systemPrefersDark = await JS.InvokeAsync<bool>("FlowLedgerTheme.getSystemPrefersDark");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "Could not read system color-scheme preference; defaulting to light mode");
        }

        _hasUserOverride = persisted.HasValue;
        ThemeService.Initialize(persisted, systemPrefersDark);

        _ = RunAutoSyncLoopAsync(_autoCts.Token);
        // StateHasChanged is called by the ThemeChanged event that Initialize fires.
    }

    public void Dispose()
    {
        _autoCts.Cancel();
        _autoCts.Dispose();
        ThemeService.ThemeChanged -= OnThemeChanged;
    }

    // ── Theme helpers ─────────────────────────────────────────────────────────

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Fired by MudThemeProvider when the OS/browser preference changes at runtime
    /// (requires ObserveSystemDarkModeChange="true").
    /// </summary>
    private async Task OnSystemPreferenceChanged(bool systemIsDark)
    {
        ThemeService.ApplySystemPreference(systemIsDark, _hasUserOverride);
        await Task.CompletedTask;
    }

    /// <summary>
    /// Explicit user toggle — persists choice to localStorage and sets the
    /// override flag so future OS-preference changes are ignored.
    /// </summary>
    private async Task ToggleTheme()
    {
        var newDark = !ThemeService.IsDarkMode;
        ThemeService.SetDarkMode(newDark);
        _hasUserOverride = true;

        try
        {
            await JS.InvokeAsync<bool>("FlowLedgerTheme.setPreference", newDark ? "dark" : "light");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "Could not persist theme preference to localStorage; preference will not survive reload");
        }
    }

    // ── Drawer ───────────────────────────────────────────────────────────────

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // ── Connect & Sync ───────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var env = await ApiClient.GetEnvironmentAsync();
        _environment = env?.Environment ?? "unknown";
        var data = await ApiClient.GetDataStatusAsync();
        _backupAlert = data is null ? null
            : data.Backup.Stale ? "No recent successful backup — open Data & Backups"
            : !data.Backup.OffsiteConfigured && _environment == "production" ? "No off-site backup configured"
            : null;
    }

    private async Task ConnectBank()
    {
        var info = await ApiClient.GetProviderInfoAsync();
        if (info is { UsesWidget: false, ManageUrl: { Length: > 0 } manage })
        {
            // SimpleFIN Bridge: institutions are linked on the Bridge site; the access URL is already configured here.
            await JS.InvokeVoidAsync("open", manage, "_blank");
            Snackbar.Add($"{info.Provider}: link or re-authenticate institutions on the Bridge page, then press Sync now.", Severity.Info);
            return;
        }

        var ok = await DialogService.ShowMessageBoxAsync(
            "Connect a bank",
            "This opens your provider's secure connection widget. Creating the connection is a billable provider call, and it is only made once. Continue?",
            yesText: "Continue", cancelText: "Cancel");
        if (ok != true)
        {
            return;
        }

        try
        {
            var url = await ApiClient.BeginBankConnectionAsync();
            if (string.IsNullOrWhiteSpace(url))
            {
                Snackbar.Add("The provider did not return a connection link.", Severity.Warning);
                return;
            }

            await JS.InvokeVoidAsync("open", url, "_blank");
            Snackbar.Add("Finish linking in the new tab, then press Sync now.", Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Connect bank failed");
            Snackbar.Add($"Connect failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task RunAutoSyncLoopAsync(CancellationToken ct)
    {
        try
        {
            await AutoSyncIfDueAsync();
            using var timer = new PeriodicTimer(AutoSyncTick);
            while (await timer.WaitForNextTickAsync(ct))
            {
                await AutoSyncIfDueAsync();
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Auto-sync loop stopped");
        }
    }

    private async Task AutoSyncIfDueAsync()
    {
        if (_syncing || DateTimeOffset.UtcNow < _autoBackoffUntil)
        {
            return;
        }

        try
        {
            if (!await JS.InvokeAsync<bool>("FlowLedgerPage.isVisible"))
            {
                return; // not on display: leave it to the daily Worker sync
            }

            // Source of truth is the server (survives reloads and covers syncs from other processes).
            var status = await ApiClient.GetSyncStatusAsync();
            if (status is null)
            {
                return;
            }

            _lastSyncedAt = status.LastSyncedAt;
            _serverMinInterval = TimeSpan.FromMinutes(Math.Max(0, status.MinIntervalMinutes));
            var wait = (status.LastSyncedAt is { } last ? last + AutoSyncInterval : DateTimeOffset.MinValue)
                       - DateTimeOffset.UtcNow;
            if (wait > TimeSpan.Zero || status.Provider == "Simulated")
            {
                return;
            }

            await InvokeAsync(() => RunSyncAsync(auto: true));
        }
        catch (Exception ex)
        {
            _autoBackoffUntil = DateTimeOffset.UtcNow + AutoSyncBackoff;
            Logger.LogWarning(ex, "Auto-sync check failed; backing off for {Backoff}", AutoSyncBackoff);
        }
    }

    private Task SyncNow() => RunSyncAsync(auto: false);

    private async Task RunSyncAsync(bool auto)
    {
        _syncing = true;
        if (auto) StateHasChanged();
        try
        {
            var result = await ApiClient.SyncAsync();
            if (auto)
            {
                if (result is { TransactionsAdded: > 0 })
                {
                    Snackbar.Add($"Auto-sync: {result.TransactionsAdded} new transactions", Severity.Info);
                }
                return;
            }

            Snackbar.Add(result is not null
                ? $"Sync complete — {result.TransactionsAdded} new transactions"
                : "Sync complete", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sync failed");
            if (auto)
            {
                // Throttled / budget / needs-reauth / provider outage: stay quiet and back off.
                _autoBackoffUntil = DateTimeOffset.UtcNow + AutoSyncBackoff;
            }
            else
            {
                Snackbar.Add($"Sync failed: {ex.Message}", Severity.Error);
            }
        }
        finally
        {
            _syncing = false;
            if (auto) StateHasChanged();
        }
    }

    private async Task ConnectAndSync()
    {
        _syncing = true;
        try
        {
            await ApiClient.ConnectAsync();
            var result = await ApiClient.SyncAsync();
            var msg = result is not null
                ? $"Sync complete — {result.AccountsUpserted} accounts, {result.TransactionsAdded} transactions added, {result.TransactionsSkipped} skipped, {result.RecurringFlowsAdded} recurring flows added"
                : "Sync complete";
            Snackbar.Add(msg, Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Connect & Sync failed");
            Snackbar.Add($"Sync failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncing = false;
        }
    }
}
