<MudDialog aria-labelledby="secret-dialog-title">
    <TitleContent>
        <MudText Typo="Typo.h6" id="secret-dialog-title">Signing secret</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            Copy this now. FlowLedger stores it encrypted and can't show it again; to get a new one, rotate it.
        </MudAlert>
        <MudTextField T="string" Value="Secret" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" OnAdornmentClick="CopyAsync"
                      AdornmentAriaLabel="Copy secret" Class="fl-mono" />
        <MudText Typo="Typo.body2" Class="mt-3">
            Verify each delivery by computing <code>HMAC-SHA256(secret, timestamp + "." + rawBody)</code> and comparing it with the
            <code>X-FlowLedger-Signature</code> header (<code>sha256=&lt;hex&gt;</code>). Reject requests whose
            <code>X-FlowLedger-Timestamp</code> is more than five minutes old.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Done">I've saved it</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    [Parameter] public string Secret { get; set; } = "";

    private void Done() => MudDialog.Close();

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", Secret);
            Snackbar.Add("Copied.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Couldn't copy. Select the text and copy it manually.", Severity.Warning);
        }
    }
}
