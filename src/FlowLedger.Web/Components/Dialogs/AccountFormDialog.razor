@inject IDialogService DialogService

<MudDialog aria-labelledby="account-dialog-title">
    <TitleContent>
        <MudText Typo="Typo.h6" id="account-dialog-title">@(Account is null ? "Create Account" : "Edit Account")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" aria-label="Account form">
            @if (Account is null)
            {
                <!-- Create mode: all fields -->
                <MudTextField @bind-Value="_name" Label="Name" Required="true" RequiredError="Name is required"
                              aria-required="true" aria-label="Account name" Class="mb-3" />
                <MudSelect @bind-Value="_accountType" Label="Account Type" Required="true"
                           aria-required="true" aria-label="Account type" Class="mb-3">
                    @foreach (var t in AccountTypes)
                    {
                        <MudSelectItem Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField @bind-Value="_startingBalance" Label="Starting Balance" Format="F2"
                                 aria-label="Starting balance" Class="mb-3" />
                <MudTextField @bind-Value="_currency" Label="Currency" MaxLength="3"
                              aria-label="Currency code" Class="mb-3" />
                <MudTextField @bind-Value="_institution" Label="Institution (optional)"
                              aria-label="Institution name" Class="mb-3" />
            }
            else
            {
                <!-- Edit mode: name and type. A type chosen here is pinned: provider sync will not overwrite it. -->
                <MudTextField @bind-Value="_name" Label="Name" Required="true" RequiredError="Name is required"
                              aria-required="true" aria-label="Account name" Class="mb-3" />
                <MudSelect @bind-Value="_accountType" Label="Account Type"
                           HelperText="@TypeHelperText"
                           aria-label="Account type" Class="mb-3">
                    @foreach (var t in AccountTypes)
                    {
                        <MudSelectItem Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">Tracking &amp; reporting</MudText>

                <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Primary" Label="Enabled"
                           aria-label="Account enabled" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    @(_enabled
                        ? "Syncing, and included in balances, net worth, reports and forecasts."
                        : "Turned off: sync stops and the account disappears from every screen, report and total. Your data is kept - turn it back on any time.")
                </MudText>

                @if (_enabled)
                {
                    <MudSelect T="string" @bind-Value="_mode" Label="Treat this account as" Class="mb-1"
                               aria-label="Account mode">
                        <MudSelectItem Value="@("Standard")">Everyday account</MudSelectItem>
                        <MudSelectItem Value="@("Holding")">Holding (balance tracking)</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                        @(_mode == "Holding"
                            ? "For investments, retirement and other holdings. Balance and history count toward net worth and you can open the account to see its activity, but its transactions stay out of Transactions, the dashboard, spending, recurring detection and reports."
                            : "A normal account: its transactions appear everywhere.")
                    </MudText>

                    <MudSwitch T="bool" Value="@(_mode == "Holding" || _hideTransactions)" ValueChanged="@((bool v) => _hideTransactions = v)"
                               Disabled="@(_mode == "Holding")" Color="Color.Primary" Label="Hide transactions from everyday views"
                               aria-label="Hide transactions" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                        @(_mode == "Holding"
                            ? "Always on for holdings."
                            : "Keeps this account's activity out of the default Transactions list, dashboard, spending and reports. Pick the account in a filter to see it.")
                    </MudText>
                }
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" aria-label="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Variant="Variant.Filled"
                   aria-label="@(Account is null ? "Create account" : "Save changes")">
            @(Account is null ? "Create" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public FlowLedger.Contracts.AccountDto? Account { get; set; }

    private MudForm _form = default!;
    private string _name = "";
    private string _accountType = "Checking";
    private decimal _startingBalance = 0m;
    private string _currency = "USD";
    private string? _institution;
    private bool _enabled = true;
    private string _mode = "Standard";
    private bool _hideTransactions;

    private static readonly string[] AccountTypes =
    [
        "Checking", "Savings", "CreditCard", "Loan", "Mortgage",
        "Investment", "Cash", "ManualAsset", "ManualLiability"
    ];

    protected override void OnParametersSet()
    {
        if (Account is not null)
        {
            _name = Account.Name;
            _accountType = Account.AccountType;
            _currency = Account.BalanceCurrency;
            _institution = Account.Institution;
            _enabled = Account.IsActive;
            _mode = Account.Mode;
            _hideTransactions = Account.HideTransactions;
        }
    }

    private string TypeHelperText =>
        Account is { TypeLockedByUser: true } ? "Set manually - sync will not change it."
        : "Changing the type pins it so sync will not change it back.";

    /// <summary>Outcome of the edit dialog: which parts (name, type) actually changed.</summary>
    public sealed record AccountEditResult(string? NewName, string? NewType, FlowLedger.Contracts.AccountSettingsRequest? Settings = null);

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        object result = Account is null
            ? new FlowLedger.Contracts.CreateAccountRequest(
                _name, _accountType, _startingBalance, _currency, _institution, null)
            : new AccountEditResult(
                _name != Account.Name ? _name : null,
                _accountType != Account.AccountType ? _accountType : null,
                _enabled != Account.IsActive || _mode != Account.Mode || _hideTransactions != Account.HideTransactions
                    ? new FlowLedger.Contracts.AccountSettingsRequest(_enabled, _mode, _mode == "Holding" || _hideTransactions)
                    : null);

        MudDialog.Close(DialogResult.Ok(result));
    }
}
