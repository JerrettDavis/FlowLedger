@namespace FlowLedger.Web.Components.Shared

@* The one page heading: an h1 that receives focus after navigation (tabindex -1), an optional subtitle, and a right-aligned
   action area that wraps on narrow screens. Pages must not hand-roll their own header row. *@
<div class="fl-page-header @Class">
    <div class="fl-page-header__title">
        @Lead
        <MudText Typo="Typo.h4" HtmlTag="h1" tabindex="-1">@Title</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
        }
        @Description
    </div>
    @if (ChildContent is not null)
    {
        <div class="fl-page-header__actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>Content above the title (for example a back link).</summary>
    [Parameter] public RenderFragment? Lead { get; set; }

    /// <summary>Rich content below the title, for subtitles that need markup.</summary>
    [Parameter] public RenderFragment? Description { get; set; }

    /// <summary>Page actions, shown to the right of the title.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
