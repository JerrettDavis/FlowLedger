@namespace FlowLedger.Web.Components.Shared

@* Full-page message for errors and dead ends: one h1, a plain-language explanation, and a way back. *@
<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3" Class="pa-8">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="@IconColor" />
    <MudText Typo="Typo.h4" HtmlTag="h1" Align="Align.Center" tabindex="-1">@Title</MudText>
    @if (!string.IsNullOrEmpty(Description))
    {
        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">@Description</MudText>
    }
    @ChildContent
    <MudStack Row="true" Spacing="2" Justify="Justify.Center">
        @Actions
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home">Back to dashboard</MudButton>
    </MudStack>
</MudStack>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public string? Description { get; set; }
    [Parameter] public Color IconColor { get; set; } = Color.Secondary;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra buttons shown before the "Back to dashboard" link.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
