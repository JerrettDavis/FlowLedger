<MudDialog aria-labelledby="dismiss-flag-title">
    <TitleContent>
        <MudText Typo="Typo.h6" id="dismiss-flag-title">Dismiss alert</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            <strong>@Merchant</strong> will no longer appear under Suspicious Activity.
        </MudText>
        <MudTextField @bind-Value="Note" Label="Note (optional)" Lines="2" MaxLength="500" AutoFocus="true"
                      Placeholder="e.g. Verified with the merchant, expected charge" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" aria-label="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" aria-label="Dismiss alert">Dismiss</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Merchant { get; set; } = "";
    [Parameter] public string? Note { get; set; }

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok(Note?.Trim() ?? ""));
}
