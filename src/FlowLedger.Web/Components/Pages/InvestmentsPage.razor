@page "/investments"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient

<PageTitle>Investments — FlowLedger</PageTitle>

<PageHeader Title="Investment performance">
        <DateRangeSelector Label="Range" Preset="@_preset" From="@(_from ?? default)" To="@_to"
                           Presets="@RangePresets" Changed="OnRangeChanged" />
</PageHeader>
<MudText Typo="Typo.body2" Class="mb-4 fl-muted">
    Growth of each investment account, with deposits and withdrawals taken out so moving money in isn't counted as a gain.
    Needs balance history, which builds up with every sync.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_accounts is null || _accounts.Count == 0)
{
    <MudText Typo="Typo.body2" Class="fl-muted">No investment accounts found.</MudText>
}
else
{
    @foreach (var a in _accounts)
    {
        <MudPaper Class="pa-4 mb-3" Outlined="true">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle1">@a.Name</MudText>
                <MudText Class="fl-num">@Format.Money(a.Balance)</MudText>
            </div>
            @if (a.Periods.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="fl-muted">Not enough balance history yet — check back after another sync.</MudText>
            }
            else
            {
                <div class="fl-periods">
                    @foreach (var p in a.Periods)
                    {
                        <div class="fl-period">
                            <div class="d-flex justify-space-between align-center">
                                <span class="fl-tile__label">@p.Period</span>
                                <span class="fl-pill @(p.Gain >= 0 ? "fl-pill--pos" : "fl-pill--neg")">@(p.GainPercent is { } g ? $"{g:+0.00;-0.00;0.00}%" : "–")</span>
                            </div>
                            <div class="fl-tile__value fl-num @(p.Gain >= 0 ? "fl-pos" : "fl-neg")">@Format.Signed(p.Gain)</div>
                            <MudText Typo="Typo.caption" Class="fl-muted">Started @Format.Money(p.StartBalance) · deposits @Format.Money(p.NetContributions)@(p.Days < DaysFor(p.Period) ? $" · {p.Days}d of history" : "")</MudText>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    }
}

@code {
    private List<FlowLedger.Web.ApiClient.AccountPerformanceDto>? _accounts;
    private bool _loading = true;

    private static int DaysFor(string period) => period switch { "30 days" => 30, "90 days" => 90, "1 year" => 365, _ => 0 };

    // "Standard" keeps the classic 30 days / 90 days / 1 year tiles; any other choice shows one tile for that window.
    private static readonly string[] RangePresets =
        ["Standard", "Last 30 days", "Last 90 days", "Last 6 months", "Year to date", "Last 12 months", "All time", "Custom"];
    private string _preset = "Standard";
    private DateOnly? _from;
    private DateOnly _to = DateOnly.FromDateTime(DateTime.Today);

    private async Task OnRangeChanged(DateRangeSelector.DateRange r)
    {
        _preset = r.Preset;
        _from = r.Preset == "Standard" ? null : r.From;
        _to = r.To;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _accounts = _preset == "Standard"
            ? await ApiClient.GetInvestmentPerformanceAsync()
            : await ApiClient.GetInvestmentPerformanceAsync(_from ?? new DateOnly(2000, 1, 1), _to);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }
}
