@page "/budgets"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Budgets — FlowLedger</PageTitle>

<PageHeader Title="Budgets">
        <div class="d-flex align-center" style="gap:4px" role="group" aria-label="Budget month">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" OnClick="() => ShiftMonthAsync(-1)" aria-label="Previous month" />
            <MudText Typo="Typo.subtitle1" Class="fl-num" aria-live="polite" Style="min-width:min(130px,100%);text-align:center">@_month.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" OnClick="() => ShiftMonthAsync(1)" aria-label="Next month" />
            <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(_month == CurrentMonth)" OnClick="() => SetMonthAsync(CurrentMonth)">This month</MudButton>
        </div>
</PageHeader>
<MudText Typo="Typo.body2" Class="mb-4 fl-muted">
    Monthly limits per category, tracked against this month's spending. Transfers between your own accounts never count.
    A budget on a parent category (for example Food) covers its sub-categories.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_data is null)
{
    <MudAlert Severity="Severity.Error">Could not load budgets.</MudAlert>
}
else
{
    @if (_data.Budgets.Count(b => b.Over) is > 0 and var over)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">@over budget(s) over the limit this month.</MudAlert>
    }

    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Add or change a budget</MudText>
        @if (_feedback.Summary is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@_feedback.Summary</MudAlert>
        }
        <div class="d-flex align-center gap-3 flex-wrap">
            <MudSelect T="string" Value="_category" ValueChanged="OnCategoryChanged" Label="Category" Style="min-width:min(240px,100%)" Margin="Margin.Dense"
                       Error="@(_feedback.Has("category") || _feedback.Has("budget"))" ErrorText="@(_feedback.For("category") ?? _feedback.For("budget"))">
                @foreach (var c in Choices)
                {
                    <MudSelectItem Value="@c">@c@(SpentFor(c) > 0 ? $"  ({Format.Money(SpentFor(c))} this month)" : "")</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="decimal" Value="_limit" ValueChanged="OnLimitChanged" Label="Monthly limit" Min="0" Style="max-width:180px" Margin="Margin.Dense"
                             Adornment="Adornment.Start" AdornmentText="@Format.CurrencyAdornment" aria-label="Monthly limit" />
            <MudCheckBox T="bool" @bind-Value="_rollover" Label="Roll over unspent" Dense="true" aria-label="Roll over what is left unspent into next month" data-testid="budget-rollover" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(FormRules.Budget(_category) is not null)" aria-describedby="budget-reason">Save budget</MudButton>
        </div>
        <SubmitReason Id="budget-reason" Reason="@FormRules.Budget(_category)" />
    </MudPaper>

    @if (_data.Budgets.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="fl-muted">No budgets yet. Pick a category above, or use the suggestions below.</MudText>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            @foreach (var b in _data.Budgets)
            {
                <div class="mb-4">
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.subtitle2">@b.Category</MudText>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.body2" Color="@(b.Over ? Color.Error : Color.Default)" Class="fl-num">
                                @Format.Money(b.Spent) of @Format.Money(b.MonthlyLimit + b.Carried)
                                @(b.Over ? $" — over by {Format.Money(-b.Remaining)}" : $" — {Format.Money(b.Remaining)} left")
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(b))" aria-label="@($"Edit budget for {b.Category}")" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => Remove(b.Category, b.Version))" aria-label="@($"Remove budget for {b.Category}")" />
                        </div>
                    </div>
                    @if (b.Rollover)
                    {
                        <MudText Typo="Typo.caption" Class="fl-muted" data-testid="budget-carried">
                            Rollover on: @Format.Money(b.Carried) carried from last month on top of the @Format.Money(b.MonthlyLimit) limit.
                        </MudText>
                    }
                    <MudProgressLinear Value="@Math.Min(100, b.PercentUsed)" Color="@(b.Over ? Color.Error : b.PercentUsed >= 80 ? Color.Warning : Color.Success)" Size="Size.Medium" Class="mt-1"
                                       aria-valuetext="@($"{ChartSummary.ProgressText(b.Category, b.PercentUsed, "of budget used")}{(b.Over ? ", over budget" : "")}")" />
                </div>
            }
        </MudPaper>
    }

    @if (Suggestions.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-2">Suggestions from this month's spending</MudText>
        <div class="d-flex gap-2 flex-wrap">
            @foreach (var s in Suggestions)
            {
                <MudChip T="string" Variant="Variant.Outlined" OnClick="@(() => Suggest(s.Key, s.Value))">@s.Key — @Format.Money(s.Value) so far</MudChip>
            }
        </div>
    }
}

@code {
    private FlowLedger.Web.ApiClient.BudgetsDto? _data;
    private bool _loading = true;
    private string? _category;
    private decimal _limit;
    private bool _rollover;
    private readonly FormFeedback _feedback = new();

    // Editing the limit clears the previous server verdict, so a stale message never sits next to a corrected value.
    private void OnLimitChanged(decimal value)
    {
        _limit = value;
        _feedback.Clear();
    }

    private IEnumerable<string> Choices => _data is null
        ? []
        : _data.SpendByCategory.Keys.Where(k => k != "Uncategorized").Concat(_data.Budgets.Select(b => b.Category)).Distinct().OrderBy(k => k);

    private decimal SpentFor(string category) =>
        _data is not null && _data.SpendByCategory.TryGetValue(category, out var v) ? v : 0m;

    private List<KeyValuePair<string, decimal>> Suggestions => _data is null
        ? []
        : _data.SpendByCategory
            .Where(kv => kv.Key != "Uncategorized" && kv.Key != "Transfer" && _data.Budgets.All(b => b.Category != kv.Key))
            .OrderByDescending(kv => kv.Value).Take(6).ToList();

    private static DateOnly CurrentMonth => new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly _month = CurrentMonth;

    private async Task ShiftMonthAsync(int months) => await SetMonthAsync(_month.AddMonths(months));

    private async Task SetMonthAsync(DateOnly month)
    {
        _month = month;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _data = await ApiClient.GetBudgetsAsync(_month == CurrentMonth ? null : _month);
        _loading = false;
    }

    // Picking a category that already has a budget shows its current rollover setting, so saving never switches it off by accident.
    private void OnCategoryChanged(string? category)
    {
        _category = category;
        if (_data?.Budgets.FirstOrDefault(b => b.Category == category) is { } existing)
        {
            _limit = existing.MonthlyLimit;
            _rollover = existing.Rollover;
        }
        else
        {
            _rollover = false;
        }
    }

    private void Edit(FlowLedger.Web.ApiClient.BudgetStatusDto budget)
    {
        _category = budget.Category;
        _limit = budget.MonthlyLimit;
        _rollover = budget.Rollover;
    }

    private void Suggest(string category, decimal spent)
    {
        _category = category;
        _limit = Math.Ceiling(spent / 50m) * 50m + 50m; // a rounded limit slightly above current spend
    }

    private async Task Save()
    {
        _feedback.Clear();
        try
        {
            var expected = _data?.Budgets.FirstOrDefault(b => b.Category == _category!.Trim())?.Version;
            await ApiClient.SetBudgetAsync(_category!, _limit, expected, rollover: _rollover);
            Snackbar.Add("Budget saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (_feedback.TryCaptureFields(ex))
        {
            // Stay on the form: the summary and the field messages are now rendered.
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
            if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
            {
                await LoadAsync(); // pick up the current versions
            }
        }
    }

    private async Task Remove(string category, uint version)
    {
        if (!await DialogService.ConfirmAsync("Remove budget", $"Remove the {category} budget? Spending in that category is not affected.", "Remove"))
        {
            return;
        }

        try
        {
            await ApiClient.DeleteBudgetAsync(category, version);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
            if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
            {
                await LoadAsync(); // pick up the current versions
            }
        }
    }
}
