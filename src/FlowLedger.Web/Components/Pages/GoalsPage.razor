@page "/goals"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Goals — FlowLedger</PageTitle>

<PageHeader Title="Savings goals">
        <DateRangeSelector Label="Target date" Presets="@DateRangeSelector.ForwardPresets" Preset="@_rangePreset"
                           From="@(_rangeFrom ?? default)" To="@_rangeTo" Changed="OnRangeChanged" />
</PageHeader>
<MudText Typo="Typo.body2" Class="mb-4 fl-muted">
    Set a target (emergency fund, vacation, down payment), track what you've set aside, and see the monthly amount needed to hit your date.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@(_editId is null ? "New goal" : "Edit goal")</MudText>
        @if (_feedback.Summary is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@_feedback.Summary</MudAlert>
        }
        <div class="d-flex align-center gap-3 flex-wrap">
            <MudTextField T="string" Immediate="true" Value="_name" ValueChanged="OnNameChanged" Label="Name" Style="min-width:min(220px,100%)" Margin="Margin.Dense"
                          Error="@(_feedback.Has("name") || _feedback.Has("goal"))" ErrorText="@(_feedback.For("name") ?? _feedback.For("goal"))" />
            <MudNumericField T="decimal" Immediate="true" Value="_target" ValueChanged="OnTargetChanged" Label="Target" Min="0" Style="max-width:160px" Margin="Margin.Dense"
                             Adornment="Adornment.Start" AdornmentText="@Format.CurrencyAdornment" aria-label="Target" />
            <MudSelect T="Guid?" @bind-Value="_linkedAccountId" ToStringFunc="@AccountName" Label="Track with account (optional)" Style="min-width:min(240px,100%)" Margin="Margin.Dense" Clearable="true"
                       HelperText="@(_linkedAccountId is null ? null : "Progress follows this account's balance.")" aria-label="Track with account"
                       Error="@_feedback.Has("linkedAccountId")" ErrorText="@_feedback.For("linkedAccountId")">
                @foreach (var a in _accounts)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)a.Id)">@a.Name (@Format.Money(a.BalanceAmount))</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="decimal" Immediate="true" @bind-Value="_saved" Label="Saved so far" Min="0" Style="max-width:160px" Margin="Margin.Dense"
                             Disabled="@(_linkedAccountId is not null)" Adornment="Adornment.Start" AdornmentText="@Format.CurrencyAdornment" aria-label="Saved so far" />
            <MudDatePicker @bind-Date="_date" Label="Target date (optional)" Margin="Margin.Dense" Style="max-width:200px" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(FormRules.Goal(_name, _target) is not null)" aria-describedby="goal-reason">Save goal</MudButton>
            @if (_editId is not null)
            {
                <MudButton OnClick="Reset">Cancel</MudButton>
            }
        </div>
        <SubmitReason Id="goal-reason" Reason="@FormRules.Goal(_name, _target)" />
    </MudPaper>

    @if (_goals is null || _goals.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="fl-muted">No goals yet. Add one above.</MudText>
    }
    else
    {
        <MudPaper Class="pa-4" Outlined="true">
            @foreach (var g in _goals.Where(InRange))
            {
                <div class="mb-4">
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.subtitle2">@g.Name @(g.Complete ? "🎉" : "")</MudText>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.body2" Class="fl-num">
                                @Format.Money(g.CurrentAmount ?? g.SavedAmount) of @Format.Money(g.TargetAmount)
                                @(g.TargetDate is { } d ? $" · by {d:MMM yyyy}" : "")
                                @(g.MonthlyNeeded is { } m ? $" · {Format.Money(m)}/mo needed" : "")
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(g))" aria-label="@($"Edit {g.Name}")" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => Remove(g))" aria-label="@($"Remove {g.Name}")" />
                        </div>
                    </div>
                    @if (g.LinkedAccountName is not null)
                    {
                        <MudText Typo="Typo.caption" Class="fl-muted fl-num">
                            Tracking @g.LinkedAccountName@(g.AccountMonthlyTrend is { } t ? $" · {(t >= 0 ? "+" : "")}{Format.Money(t)}/mo over the last 90 days" : " · not enough history for a trend yet")
                        </MudText>
                    }
                    <MudProgressLinear Value="@g.PercentComplete" Color="@(g.Complete ? Color.Success : Color.Primary)" Size="Size.Medium" Class="mt-1"
                                       aria-valuetext="@($"{ChartSummary.ProgressText(g.Name, g.PercentComplete, "complete")}{(g.Complete ? ", goal reached" : "")}")" />
                </div>
            }
        </MudPaper>
    }
}

@code {
    private List<FlowLedger.Web.ApiClient.GoalDto>? _goals;
    private bool _loading = true;
    private Guid? _editId;
    private uint? _editVersion;
    private string? _name;
    private decimal _target;
    private decimal _saved;
    private DateTime? _date;
    private Guid? _linkedAccountId;

    // The select shows what ToStringFunc returns for the chosen value, so map the id to the account's name (never the raw GUID).
    private string AccountName(Guid? id) => id is { } v ? _accounts.FirstOrDefault(a => a.Id == v)?.Name ?? "" : "";
    private List<FlowLedger.Contracts.AccountDto> _accounts = [];
    private readonly FormFeedback _feedback = new();

    // Editing a field clears the previous server verdict, so a stale message never sits next to a corrected value.
    private void OnNameChanged(string? value)
    {
        _name = value;
        _feedback.Clear();
    }

    private void OnTargetChanged(decimal value)
    {
        _target = value;
        _feedback.Clear();
    }

    private string _rangePreset = "All time";
    private DateOnly? _rangeFrom;
    private DateOnly _rangeTo = DateOnly.FromDateTime(DateTime.Today);

    private void OnRangeChanged(DateRangeSelector.DateRange r)
    {
        _rangePreset = r.Preset;
        _rangeFrom = r.From;
        _rangeTo = r.To;
    }

    // "All time" shows every goal (including ones with no target date); any other window keeps goals whose target date falls inside it.
    private bool InRange(FlowLedger.Web.ApiClient.GoalDto g) =>
        _rangePreset == "All time" || (g.TargetDate is { } d && d >= (_rangeFrom ?? DateOnly.MinValue) && d <= _rangeTo);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _goals = await ApiClient.GetGoalsAsync();
        try
        {
            _accounts = (await ApiClient.GetAccountsAsync()).Where(a => a.IsActive).ToList();
        }
        catch (Exception ex) when (ex is FlowLedger.Web.ApiClient.ApiClientException or HttpRequestException or TaskCanceledException)
        {
            _accounts = []; // the picker is optional: goals still work without it
        }

        _loading = false;
    }

    private void Edit(FlowLedger.Web.ApiClient.GoalDto g)
    {
        _editId = g.Id; _editVersion = g.Version; _name = g.Name; _target = g.TargetAmount; _saved = g.SavedAmount; _linkedAccountId = g.LinkedAccountId;
        _date = g.TargetDate?.ToDateTime(TimeOnly.MinValue);
    }

    private void Reset()
    {
        _editId = null; _editVersion = null; _name = null; _target = 0; _saved = 0; _date = null; _linkedAccountId = null;
        _feedback.Clear();
    }

    private async Task Save()
    {
        _feedback.Clear();
        try
        {
            await ApiClient.SaveGoalAsync(_editId, _name!, _target, _saved, _date is { } d ? DateOnly.FromDateTime(d) : null, _editVersion, _linkedAccountId);
            Snackbar.Add("Goal saved.", Severity.Success);
            Reset();
            await LoadAsync();
        }
        catch (Exception ex) when (_feedback.TryCaptureFields(ex))
        {
            // Stay on the form: the summary and the field messages are now rendered.
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
            if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
            {
                Reset(); // the edit form holds a stale version; start over from what is stored now
                await LoadAsync();
            }
        }
    }

    private async Task Remove(FlowLedger.Web.ApiClient.GoalDto g)
    {
        if (!await DialogService.ConfirmAsync("Remove goal", $"Remove the goal \"{g.Name}\"? Its saved progress is discarded.", "Remove"))
        {
            return;
        }

        try
        {
            await ApiClient.DeleteGoalAsync(g.Id, g.Version);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
            if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
            {
                await LoadAsync(); // pick up the current versions
            }
        }
    }
}
