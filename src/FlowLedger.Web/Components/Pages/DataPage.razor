@page "/data"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Data &amp; Backups — FlowLedger</PageTitle>

<PageHeader Title="Data & Backups" />
<MudText Typo="Typo.body2" Class="mb-4 fl-muted">Where your data lives, how safe it is, and what the bank connection costs.</MudText>

@if (!_household)
{
    <MudAlert Severity="Severity.Info">
Data &amp; Backups covers the whole installation and is only available to the household owner.
If you are the owner and signed in before this was added, sign in again to refresh your access.
<MudButton Variant="Variant.Outlined" Size="Size.Small" Class="ml-2" OnClick="SignInAgain">Sign in again</MudButton>
</MudAlert>
}
else if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_status is null)
{
    <MudAlert Severity="Severity.Error">Could not load data status.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Backups</MudText>
                @if (_status.Backup.Healthy)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                        Healthy — last successful backup @Ago(_status.Backup.LastSuccessUtc)
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                        @(_status.Backup.LastRun is null
                            ? "No backup has run yet."
                            : _status.Backup.LastRun.Ok
                                ? "Last backup is more than 36 hours old."
                                : "Last backup FAILED: " + _status.Backup.LastRun.Error)
                    </MudAlert>
                }
                <div class="fl-periods">
                    <div class="fl-period"><div class="fl-tile__label">Off-site copy</div><div class="fl-tile__value @(_status.Backup.OffsiteConfigured ? "fl-pos" : "fl-neg")" style="font-size:1.1rem">@(_status.Backup.OffsiteConfigured ? "Configured" : "Not configured")</div></div>
                    <div class="fl-period"><div class="fl-tile__label">Last run</div><div class="fl-tile__value" style="font-size:1.1rem">@(_status.Backup.LastRun is null ? "—" : Ago(_status.Backup.LastRun.FinishedUtc))</div></div>
                    <div class="fl-period"><div class="fl-tile__label">Rows backed up</div><div class="fl-tile__value fl-num" style="font-size:1.1rem">@(_status.Backup.LastRun is { } lastRun ? Format.Count(lastRun.Rows) : "—")</div></div>
                    <div class="fl-period"><div class="fl-tile__label">Restore drill</div><div class="fl-tile__value @(_status.Backup.LastRun?.DrillOk is { } dd ? (dd ? "fl-pos" : "fl-neg") : "")" style="font-size:1.1rem">@(_status.Backup.LastRun?.DrillOk is { } d ? (d ? "Passed" : "FAILED") : "—")</div></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_status.Backup.LastRun?.OffsiteDetail))
                {
                    <MudText Typo="Typo.caption" Class="d-block mt-2 fl-muted">Off-site: @_status.Backup.LastRun!.OffsiteDetail</MudText>
                }
                <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="_running" OnClick="BackupNow">
                    @(_running ? "Backing up…" : "Back up now")
                </MudButton>
                <MudButton Class="mt-3 ml-2" Variant="Variant.Outlined" Disabled="_exporting" OnClick="ExportAll">
                    @(_exporting ? "Exporting…" : "Export all data (.zip)")
                </MudButton>
                <div class="d-flex align-center mt-3" style="gap:8px;flex-wrap:wrap">
                    <DateRangeSelector Label="Transactions range" Preset="@_rangePreset" From="@(_rangeFrom ?? default)" To="@_rangeTo" Changed="OnRangeChanged" />
                    <MudButton Variant="Variant.Outlined" Disabled="_exportingCsv" OnClick="ExportTransactionsCsv">
                        @(_exportingCsv ? "Exporting…" : "Export transactions (.csv)")
                    </MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="d-block mt-2 fl-muted">
                    The export holds one CSV per table plus a hashed manifest. It can be imported into an empty database (POST /api/data/import).
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Bank connection usage (@_status.ProviderUsage.Provider)</MudText>
                @if (_status.ProviderUsage.Paused)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">Provider calls are PAUSED (kill switch on).</MudAlert>
                }
                <MudText Typo="Typo.body2">Today: @_status.ProviderUsage.CallsToday of @Budget(_status.ProviderUsage.DailyBudget)</MudText>
                <MudProgressLinear Value="@Pct(_status.ProviderUsage.CallsToday, _status.ProviderUsage.DailyBudget)" Class="mb-3" aria-label="Provider calls today" />
                <MudText Typo="Typo.body2">This month: @_status.ProviderUsage.CallsThisMonth of @Budget(_status.ProviderUsage.MonthlyBudget)</MudText>
                <MudProgressLinear Value="@Pct(_status.ProviderUsage.CallsThisMonth, _status.ProviderUsage.MonthlyBudget)" Class="mb-3" aria-label="Provider calls this month" />
                @if (_status.ProviderUsage.ByEndpoint.Count > 0)
                {
                    <MudText Typo="Typo.overline" Class="fl-muted">Endpoints this month</MudText>
                    var topCalls = Math.Max(1, _status.ProviderUsage.ByEndpoint.Max(x => x.Calls));
                    @foreach (var e in _status.ProviderUsage.ByEndpoint)
                    {
                        <div class="mb-2">
                            <div class="fl-acard__row"><span>@e.Method @e.Path</span><span class="fl-num">@e.Calls</span></div>
                            <div class="fl-meter mt-1"><span style="width:@((100.0 * e.Calls / topCalls).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                        </div>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="fl-muted">No provider calls recorded this month.</MudText>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Recent backup runs</MudText>
                <div class="fl-list">
                    @foreach (var r in _status.Backup.Runs)
                    {
                        <div class="fl-li">
                            <span class="fl-dot @(r.Ok ? "fl-tone-cash" : "fl-tone-loan")" style="@(r.Ok ? "background:var(--mud-palette-success)" : "")"></span>
                            <div class="fl-li__main">
                                <div class="fl-li__title">@r.FinishedUtc.ToLocalTime().ToString("g") · @(r.Ok ? "OK" : "FAILED")</div>
                                <div class="fl-li__sub">@(r.Error ?? r.OffsiteDetail ?? "")</div>
                            </div>
                            <span class="fl-pill fl-hide-md">@Format.Count(r.Rows) rows</span>
                            <span class="fl-pill fl-hide-lg @(r.DrillOk is { } dr ? (dr ? "fl-pill--pos" : "fl-pill--neg") : "")">drill @(r.DrillOk is { } d2 ? (d2 ? "pass" : "FAIL") : "—")</span>
                            <span class="fl-pill fl-hide-md @(r.OffsiteOk is { } of ? (of ? "fl-pill--pos" : "fl-pill--neg") : "")">off-site @(r.OffsiteOk is { } o ? (o ? "ok" : "FAIL") : "n/a")</span>
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private FlowLedger.Web.ApiClient.DataStatusDto? _status;
    private bool _loading = true;
    private bool _running;
    private bool _exporting;
    private bool _household;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Inject] private FlowLedger.Web.Auth.OidcOptions Oidc { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // UI gate only; the API refuses /api/data for any non-household tenant regardless (403).
        _household = FlowLedger.Web.Auth.HouseholdAccess.IsHousehold(AuthState is null ? null : (await AuthState).User, Oidc);
        if (_household)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _status = await ApiClient.GetDataStatusAsync();
        _loading = false;
    }

    private async Task BackupNow()
    {
        _running = true;
        try
        {
            await ApiClient.BackupNowAsync();
            Snackbar.Add("Backup complete and verified.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
        }
        finally
        {
            _running = false;
            await LoadAsync();
        }
    }

    private string _rangePreset = "Last 12 months";
    private DateOnly? _rangeFrom = DateRangeSelector.Resolve("Last 12 months").From;
    private DateOnly _rangeTo = DateRangeSelector.Resolve("Last 12 months").To;
    private bool _exportingCsv;

    private void OnRangeChanged(DateRangeSelector.DateRange r)
    {
        _rangePreset = r.Preset;
        _rangeFrom = r.From;
        _rangeTo = r.To;
    }

    private static string Csv(string? v) => "\"" + (v ?? "").Replace("\"", "\"\"") + "\"";

    private async Task ExportTransactionsCsv()
    {
        _exportingCsv = true;
        try
        {
            var sb = new System.Text.StringBuilder("date,description,merchant,amount,direction,status\n");
            var skip = 0;
            const int page = 500;
            while (true)
            {
                var batch = await ApiClient.GetTransactionsAsync(null, _rangeFrom, _rangeTo, skip, page);
                foreach (var t in batch)
                {
                    var signed = t.Direction == "Credit" ? t.Amount : -t.Amount;
                    sb.Append(t.EffectiveDate.ToString("yyyy-MM-dd")).Append(',').Append(Csv(t.Description)).Append(',').Append(Csv(t.MerchantName))
                      .Append(',').Append(signed.ToString(System.Globalization.CultureInfo.InvariantCulture)).Append(',').Append(t.Direction)
                      .Append(',').Append(t.Status).Append('\n');
                }

                if (batch.Count < page)
                {
                    break;
                }

                skip += page;
            }

            var bytes = new System.Text.UTF8Encoding(true).GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            using var ms = new MemoryStream(bytes);
            using var reference = new DotNetStreamReference(ms);
            await JS.InvokeVoidAsync("flowledgerDownload", $"transactions-{_rangeFrom:yyyyMMdd}-{_rangeTo:yyyyMMdd}.csv", reference);
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
        }
        finally
        {
            _exportingCsv = false;
        }
    }

    private async Task ExportAll()
    {
        _exporting = true;
        try
        {
            var bytes = await ApiClient.ExportAllAsync();
            if (bytes is not null)
            {
                using var ms = new MemoryStream(bytes);
                using var reference = new DotNetStreamReference(ms);
                await JS.InvokeVoidAsync("flowledgerDownload", $"flowledger-export-{DateTime.Now:yyyyMMdd-HHmm}.zip", reference);
            }
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string Ago(DateTimeOffset? t)
    {
        if (t is null)
        {
            return "never";
        }

        var d = DateTimeOffset.UtcNow - t.Value;
        return d.TotalMinutes < 1 ? "just now"
            : d.TotalHours < 1 ? $"{(int)d.TotalMinutes} min ago"
            : d.TotalDays < 1 ? $"{(int)d.TotalHours} h ago"
            : $"{(int)d.TotalDays} d ago";
    }

    private static string Budget(int b) => b <= 0 ? "unlimited" : Format.Count(b);

    private static double Pct(long used, int budget) => budget <= 0 ? 0 : Math.Min(100, used * 100.0 / budget);

    private void SignInAgain() => Nav.NavigateTo("/auth/relogin?returnUrl=%2Fdata", forceLoad: true);
}
