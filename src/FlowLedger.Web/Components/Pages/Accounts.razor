@page "/accounts"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Accounts> Logger
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Accounts — FlowLedger</PageTitle>

<div class="d-flex align-center justify-space-between mb-4 fl-enter">
    <MudText Typo="Typo.h4" HtmlTag="h1" tabindex="-1">Accounts</MudText>
    <div class="d-flex align-center" style="gap:8px;flex-wrap:wrap">
    <DateRangeSelector Label="Change over" Preset="@_rangePreset" From="@(_rangeFrom ?? default)" To="@_rangeTo" Changed="OnRangeChanged" />
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Color="Color.Primary"
               Variant="Variant.Filled"
               OnClick="OpenCreateDialog"
               aria-label="Add new account">
        Add Account
    </MudButton>
    </div>
</div>

@if (_loading)
{
    <CardSkeleton Height="40px" Count="6" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (!_loading && _error is null && _accounts.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.AccountBalance"
                Title="No accounts yet"
                Description="@($"Add an account manually. {OnboardingCopy.LoadData(Status?.Environment)}")">
        <Action>
            <MudButton StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="OpenCreateDialog"
                       aria-label="Add new account">
                Add Account
            </MudButton>
        </Action>
    </EmptyState>
}

@if (!_loading && _accounts.Count > 0)
{
    var active = _accounts.Where(x => x.IsActive).ToList();
    var gross = active.Sum(x => Math.Abs(x.BalanceAmount));
    var groups = Groups(active).Where(x => x.Items.Count > 0).ToList();
    var shares = groups.Select(g => new AllocationItem(g.Title, g.Tone,
        gross == 0 ? 0 : (double)(g.Items.Sum(x => Math.Abs(x.BalanceAmount)) / gross * 100))).ToList();
    <div class="fl-alloc mb-1" aria-hidden="true">
        @foreach (var s in shares)
        {
            <div class="fl-alloc__seg fl-tone-@s.Tone" style="width:@(s.Percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%" title="@s.Title"></div>
        }
    </div>
    <AllocationLegend Items="shares" />

    @foreach (var g in groups.Append(new AccountGroup("Disabled", "off", _accounts.Where(x => !x.IsActive).ToList())).Where(x => x.Items.Count > 0))
    {
        <section class="mb-4" aria-label="@g.Title accounts">
            <div class="fl-section__head">
                <span class="fl-dot fl-tone-@g.Tone"></span>
                <MudText Typo="Typo.subtitle1">@g.Title</MudText>
                <MudText Typo="Typo.caption" Class="fl-muted">@g.Items.Count account@(g.Items.Count == 1 ? "" : "s")</MudText>
                <span class="fl-spacer"></span>
                @if (g.Tone != "off")
                {
                    <MudText Typo="Typo.subtitle1" Class="fl-num" Color="@(g.Items.Sum(x => x.BalanceAmount) >= 0 ? Color.Default : Color.Error)">@Format.Money(g.Items.Sum(x => x.BalanceAmount))</MudText>
                }
            </div>
            <MudPaper Class="fl-list" Outlined="true">
                @foreach (var acct in g.Items)
                {
                    <div class="fl-li @(acct.IsActive ? "" : "fl-li--off")">
                        <MudAvatar Color="@AccountColor(acct.AccountType)" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@AccountIcon(acct.AccountType)" />
                        </MudAvatar>
                        <div class="fl-li__main">
                            <div class="fl-li__title">
                                <a href="@($"transactions?account={acct.Id}")" class="fl-li__link">@acct.Name</a>
                                @if (acct.TypeLockedByUser)
                                {
                                    <MudTooltip Text="Set manually - sync will not change it">
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="ml-1" aria-label="Type set manually" />
                                    </MudTooltip>
                                }
                            </div>
                            <div class="fl-li__sub">
                                @acct.AccountType@(string.IsNullOrWhiteSpace(acct.Institution) || acct.Institution.Contains('.') ? "" : " · " + acct.Institution)
                                @if (acct.IsActive && acct.Mode == "Holding")
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ml-1">Holding</MudChip>
                                }
                                else if (acct.IsActive && acct.HideTransactions)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-1">Hidden</MudChip>
                                }
                            </div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="fl-data-source fl-hide-md">@SourceLabel(acct.Id)</MudChip>
                        @if (SourceIssue(acct.Id) is { } sourceIssue)
                        {
                            <ConnectionHealthBadge Issue="sourceIssue" Compact="true" />
                        }
                        @if (_household)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Class="fl-hide-md"
                                           OnClick="() => OpenConnectorDialog(acct)"
                                           aria-label="@($"Change data source for {acct.Name}")" />
                        }
                        @if (_changes.TryGetValue(acct.Name, out var ch) && ch.End != ch.Start)
                        {
                            <span class="fl-num fl-hide-md @(ch.End - ch.Start >= 0 ? "fl-pos" : "fl-neg")" style="font-size:.8rem" title="Change over @_rangePreset">@Format.SignedWithPercent(ch.End - ch.Start, ch.Start)</span>
                        }
                        <span class="fl-li__amt fl-num @(acct.BalanceAmount < 0 ? "fl-neg" : "")">@Format.Money(acct.BalanceAmount, acct.BalanceCurrency)</span>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="() => OpenEditDialog(acct)" aria-label="@($"Edit account {acct.Name}")" />
                    </div>
                }
            </MudPaper>
        </section>
    }
}

@code {
    /// <summary>Environment from the layout; drives which empty-state instruction is shown.</summary>
    [CascadingParameter] private FlowLedger.Web.Services.LayoutStatus? Status { get; set; }

    private bool _loading = true;
    private string? _error;
    private List<FlowLedger.Web.ApiClient.AccountDto> _accounts = [];
    private Dictionary<Guid, FlowLedger.Web.ApiClient.AccountConnectorLinkDto> _links = [];
    private List<FlowLedger.Web.ApiClient.ConnectorDto> _connectors = [];
    private bool _household;
    private string _rangePreset = "Last 30 days";
    private DateOnly? _rangeFrom = DateRangeSelector.Resolve("Last 30 days").From;
    private DateOnly _rangeTo = DateRangeSelector.Resolve("Last 30 days").To;
    private Dictionary<string, (decimal Start, decimal End)> _changes = [];

    private async Task OnRangeChanged(DateRangeSelector.DateRange r)
    {
        _rangePreset = r.Preset;
        _rangeFrom = r.From;
        _rangeTo = r.To;
        await LoadChangesAsync();
    }

    private async Task LoadChangesAsync()
    {
        try { _changes = await ApiClient.GetSeriesChangesAsync("balance_history", "account", "balance", _rangeFrom, _rangeTo); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to load balance changes"); _changes = []; }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Inject] private FlowLedger.Web.Auth.OidcOptions Oidc { get; set; } = default!;

    private sealed record AccountGroup(string Title, string Tone, List<FlowLedger.Web.ApiClient.AccountDto> Items);

    private static IEnumerable<AccountGroup> Groups(List<FlowLedger.Web.ApiClient.AccountDto> list)
    {
        List<FlowLedger.Web.ApiClient.AccountDto> Of(params string[] t) => list.Where(a => t.Contains(a.AccountType)).OrderByDescending(a => Math.Abs(a.BalanceAmount)).ToList();
        var known = new[] { "Checking", "Savings", "Cash", "CreditCard", "Loan", "Mortgage", "Investment" };
        yield return new AccountGroup("Cash", "cash", Of("Checking", "Savings", "Cash"));
        yield return new AccountGroup("Credit cards", "credit", Of("CreditCard"));
        yield return new AccountGroup("Loans", "loan", Of("Loan", "Mortgage"));
        yield return new AccountGroup("Investments", "invest", Of("Investment"));
        yield return new AccountGroup("Other", "other", list.Where(a => !known.Contains(a.AccountType)).ToList());
    }

    private static string AccountIcon(string type) => type switch
    {
        "Checking" => Icons.Material.Filled.AccountBalance,
        "Savings" => Icons.Material.Filled.Savings,
        "CreditCard" => Icons.Material.Filled.CreditCard,
        "Loan" or "Mortgage" => Icons.Material.Filled.Home,
        "Investment" => Icons.Material.Filled.ShowChart,
        "Cash" => Icons.Material.Filled.Payments,
        _ => Icons.Material.Filled.AccountBalanceWallet
    };

    private static Color AccountColor(string type) => type switch
    {
        "Checking" => Color.Primary,
        "Savings" => Color.Success,
        "CreditCard" => Color.Warning,
        "Loan" or "Mortgage" => Color.Error,
        "Investment" => Color.Info,
        _ => Color.Default
    };

    private string SourceLabel(Guid accountId) =>
        !_links.TryGetValue(accountId, out var l) ? "Not linked"
        : l.ConnectorId == "manual" ? "Manual"
        : _connectors.FirstOrDefault(c => c.Id == l.ConnectorId)?.Name ?? l.ConnectorId;

    private FlowLedger.Web.ApiClient.ConnectionIssueDto? SourceIssue(Guid accountId) =>
        _links.TryGetValue(accountId, out var l) && _connectors.FirstOrDefault(c => c.Id == l.ConnectorId) is { } c
            ? FlowLedger.Web.Connections.ConnectionHealth.Worst(c.Connections)
            : null;

    private async Task OpenConnectorDialog(FlowLedger.Web.ApiClient.AccountDto account)
    {
        _links.TryGetValue(account.Id, out var link);
        var dialog = await DialogService.ShowAsync<AccountConnectorDialog>("Data source",
            new DialogParameters<AccountConnectorDialog>
            {
                { x => x.Account, account },
                { x => x.Connectors, _connectors },
                { x => x.CurrentConnector, link?.ConnectorId },
                { x => x.CurrentProviderAccountId, link?.ProviderAccountId },
            });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Data source updated", Severity.Success);
            await LoadAsync();
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _accounts = await ApiClient.GetAccountsAsync(includeInactive: true);
            _household = FlowLedger.Web.Auth.HouseholdAccess.IsHousehold(AuthState is null ? null : (await AuthState).User, Oidc);
            await LoadChangesAsync();
            _links = (await ApiClient.GetAccountConnectorsAsync()).ToDictionary(l => l.AccountId);
            _connectors = _household ? (await ApiClient.GetConnectorsAsync())?.Connectors ?? [] : [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load accounts");
            _error = ex is FlowLedger.Web.ApiClient.ApiClientException ace
                ? ace.Message
                : "Failed to load accounts. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<AccountFormDialog>("Create Account",
            new DialogParameters<AccountFormDialog> { { x => x.Account, null } });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FlowLedger.Web.ApiClient.CreateAccountRequest req })
        {
            try
            {
                await ApiClient.CreateAccountAsync(req);
                Snackbar.Add("Account created", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to create account");
                Snackbar.AddFailure(ex, fallback: "Couldn't create account. Please try again.");
            }
        }
    }

    private async Task OpenEditDialog(FlowLedger.Web.ApiClient.AccountDto account)
    {
        var dialog = await DialogService.ShowAsync<AccountFormDialog>("Edit Account",
            new DialogParameters<AccountFormDialog> { { x => x.Account, account } });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AccountFormDialog.AccountEditResult edit })
        {
            try
            {
                if (edit.NewName is not null)
                {
                    await ApiClient.UpdateAccountAsync(account.Id, new FlowLedger.Web.ApiClient.UpdateAccountRequest(edit.NewName));
                }

                if (edit.NewType is not null)
                {
                    await ApiClient.ChangeAccountTypeAsync(account.Id, new FlowLedger.Web.ApiClient.ChangeAccountTypeRequest(edit.NewType));
                }

                if (edit.Settings is not null)
                {
                    await ApiClient.UpdateAccountSettingsAsync(account.Id, edit.Settings);
                }

                Snackbar.Add(edit.NewType is not null ? "Account updated - type pinned" : "Account updated", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to update account {AccountId}", account.Id);
                Snackbar.AddFailure(ex, fallback: "Couldn't update account. Please try again.");
            }
        }
    }
}
