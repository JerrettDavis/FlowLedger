@page "/"
@rendermode InteractiveServer
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject ILogger<Home> Logger
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Dashboard — FlowLedger</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>

<AlertsPanel />

<style>
    .fl-account-strip { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 4px; }
    .fl-account-chip { display: flex; flex-direction: column; align-items: center; min-width: 96px; max-width: 120px;
        padding: 8px; border-radius: 12px; text-decoration: none; color: inherit; border: 1px solid var(--mud-palette-divider); }
    .fl-account-chip:hover, .fl-account-chip:focus-visible { background: var(--mud-palette-action-default-hover); }
    .fl-account-chip__name { font-size: 12px; font-weight: 500; margin-top: 6px; text-align: center; overflow: hidden;
        text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
    .fl-account-chip__bal { font-size: 11px; opacity: .75; }
</style>

@if (!_loading && _accounts.Count > 0)
{
    <nav class="fl-account-strip mb-4" aria-label="Accounts">
        @foreach (var a in _accounts.Where(x => x.IsActive))
        {
            var linked = !string.IsNullOrWhiteSpace(a.ExternalAccountRef) || !string.IsNullOrWhiteSpace(a.Institution);
            <a class="fl-account-chip" href="@($"transactions?account={a.Id}")"
               title="@a.Name — @Format.Money(a.BalanceAmount)" aria-label="@($"{a.Name}, balance {Format.Money(a.BalanceAmount)}. View transactions")">
                <MudBadge Content="@("")" Dot="true" Color="Color.Success" Visible="@linked" Overlap="true">
                    <MudAvatar Color="@AccountColor(a.AccountType)" Variant="Variant.Filled">
                        <MudIcon Icon="@AccountIcon(a.AccountType)" />
                    </MudAvatar>
                </MudBadge>
                <span class="fl-account-chip__name">@a.Name</span>
                <span class="fl-account-chip__bal fl-num">@Format.Money(a.BalanceAmount)</span>
            </a>
        }
    </nav>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (_loading)
{
    <div aria-label="Loading dashboard">
        <!-- KPI skeleton row -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="6">
                <CardSkeleton Height="120px" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <CardSkeleton Height="120px" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <CardSkeleton Height="120px" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <CardSkeleton Height="120px" />
            </MudItem>
        </MudGrid>
        <!-- Chart + flows skeleton row -->
        <MudGrid>
            <MudItem xs="12" md="8">
                <CardSkeleton Height="300px" />
            </MudItem>
            <MudItem xs="12" md="4">
                <CardSkeleton Height="300px" />
            </MudItem>
        </MudGrid>
    </div>
}
else
{
    <!-- Summary cards -->
    <MudGrid Class="mb-4">

        <!-- Hero: Total Balance -->
        <MudItem xs="12" md="6">
            <MudCard Class="fl-hero fl-card-hover fl-enter fl-enter-1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="Color.Primary">Cash</MudText>
                    <MudText Typo="Typo.h3" Class="fl-num" aria-label="Cash balance">@Format.Money(_cash)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Checking &amp; savings &nbsp;·&nbsp; Credit @Format.Money(_credit) &nbsp;·&nbsp; Loans @Format.Money(_loans) &nbsp;·&nbsp; Investments @Format.Money(_investments)
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Net Worth -->
        <MudItem xs="12" sm="6" md="2">
            <MudCard Class="fl-card-hover fl-enter fl-enter-2">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Net Worth</MudText>
                    <MudText Typo="Typo.h5" Class="fl-num" Color="@Format.Delta(_netWorth)" aria-label="Net worth">@Format.Money(_netWorth)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(_assetSummary is { AssetCount: > 0 } ? "Incl. tracked assets" : "Assets minus liabilities")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Forecast Low -->
        <MudItem xs="12" sm="6" md="2">
            <MudCard Class="fl-card-hover fl-enter fl-enter-3">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="@(_lowWaterMark < 0 ? Color.Error : Color.Warning)">Forecast Low</MudText>
                    <MudText Typo="Typo.h5" Class="fl-num" Color="@Format.Delta(_lowWaterMark)" aria-label="Forecast low water mark">@Format.Money(_lowWaterMark)</MudText>
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(_lowWaterMarkDate.HasValue ? $"on {Format.DayMonth(_lowWaterMarkDate.Value)}" : "3-month horizon")
                        </MudText>
                        @if (_lowWaterMark < 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="pa-0" Style="height:18px;font-size:10px">Below zero</MudChip>
                        }
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Overdraft Risk -->
        <MudItem xs="12" sm="6" md="2">
            <MudCard Class="fl-card-hover fl-enter fl-enter-4">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="@(_overdraftCount > 0 ? Color.Error : Color.Success)">Overdraft Risk</MudText>
                    <MudText Typo="Typo.h5" Class="fl-num" Color="@(_overdraftCount > 0 ? Color.Error : Color.Success)" aria-label="Overdraft warnings">
                        @(_overdraftCount > 0 ? $"{_overdraftCount} warning(s)" : "None")
                    </MudText>
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Next 3 months</MudText>
                        @if (_overdraftCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="pa-0" Style="height:18px;font-size:10px">
                                <MudIcon Icon="@Icons.Material.Outlined.Warning" Size="Size.Small" />
                            </MudChip>
                        }
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>

    <div class="fl-masonry">
        <!-- Insights: spending by category -->
        @if (_insights is { SpendingByCategory.Count: > 0 })
        {
            <div class="fl-masonry-item">
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Spending this month</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">By category, excluding transfers between your accounts</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_spendSeries" ChartLabels="@_spendLabels" Width="180px" Height="180px" />
                        <MudSimpleTable Dense="true" Elevation="0">
                            <tbody>
                                @foreach (var c in _insights.SpendingByCategory)
                                {
                                    <tr><td>@c.Category</td><td class="text-right fl-num">@Format.Money(c.Amount)</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </div>
        }

        <!-- Insights: income vs spending -->
        @if (_insights is { CashFlow.Count: > 0 })
        {
            <div class="fl-masonry-item">
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Income vs spending</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Last 6 months, excluding transfers</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_flowSeries" ChartLabels="@_flowLabels" Width="100%" Height="220px" />
                    </MudCardContent>
                </MudCard>
            </div>
        }

        <!-- Insights: net worth trend -->
        @if (_insights is { NetWorth.Count: > 1 })
        {
            <div class="fl-masonry-item">
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Net worth trend</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Account balances captured at each sync (assets are valued separately)</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@_netWorthSeries" ChartLabels="@_netWorthLabels" Width="100%" Height="220px" />
                    </MudCardContent>
                </MudCard>
            </div>
        }

        <!-- Balance Projection Chart -->
        <div class="fl-masonry-item">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Balance Projection</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">3-month household cash balance forecast</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_forecastPoints.Count >= 2)
                    {
                        <div style="height:220px;overflow:hidden" role="img" aria-label="Balance projection chart">
                            @((MarkupString)SvgChart.BuildBalanceProjection(
                                _forecastPoints,
                                zeroLine: 0m,
                                breaches: _breachDates,
                                lowWaterMark: _lwmTuple))
                        </div>
                    }
                    else
                    {
                        <EmptyState Icon="@Icons.Material.Outlined.ShowChart"
                                    Title="No forecast yet"
                                    Description="Click &quot;Connect &amp; Sync&quot; to load demo data." />
                    }
                </MudCardContent>
            </MudCard>
        </div>

        <!-- Upcoming Flows -->
        <div class="fl-masonry-item">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Upcoming Flows</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Next 14 days</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="max-height:260px;overflow-y:auto">
                    @if (_upcomingFlows.Count > 0)
                    {
                        <MudList T="UpcomingFlow" Dense="true" aria-label="Upcoming flows list">
                            @foreach (var f in _upcomingFlows)
                            {
                                <MudListItem>
                                    <div class="d-flex justify-space-between align-center w-100">
                                        <div>
                                            <MudText Typo="Typo.body2" Style="font-weight:500">@f.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Format.DayMonth(f.Date)</MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="fl-num" Color="@Format.Delta(f.IsCredit ? f.Amount : -f.Amount)">
                                            @Format.Signed(f.IsCredit ? f.Amount : -f.Amount)
                                        </MudText>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <EmptyState Icon="@Icons.Material.Outlined.CalendarMonth"
                                    Title="No upcoming flows"
                                    Description="No scheduled transactions in the next 14 days." />
                    }
                </MudCardContent>
            </MudCard>
        </div>

        @if (_assetSummary is { AssetCount: > 0 })
        {
            <div class="fl-masonry-item">
                <MudCard Class="fl-card-hover">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Assets</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@_assetSummary.AssetCount item(s) tracked</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Href="assets" Size="Size.Small" Variant="Variant.Text" aria-label="View all assets">View all</MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-end mb-3">
                            <div>
                                <MudText Typo="Typo.h5" Class="fl-num" aria-label="Total asset value">@Format.Money(_assetSummary.TotalValue)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Estimated value today</MudText>
                            </div>
                            @if (_assetSummary.TotalCost > 0)
                            {
                                <div class="text-right">
                                    <MudText Typo="Typo.body1" Class="fl-num" Color="@Format.Delta(_assetSummary.UnrealizedGainLoss)">@Format.Signed(_assetSummary.UnrealizedGainLoss)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">vs. @Format.Money(_assetSummary.TotalCost) cost</MudText>
                                </div>
                            }
                        </div>
                        @foreach (var c in _assetSummary.ByCategory.Take(4))
                        {
                            var pct = _assetSummary.TotalValue > 0 ? (double)(c.Value / _assetSummary.TotalValue * 100m) : 0d;
                            <div class="mb-2">
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.caption">@c.Category (@c.Count)</MudText>
                                    <MudText Typo="Typo.caption" Class="fl-num">@Format.Money(c.Value)</MudText>
                                </div>
                                <MudProgressLinear Value="@pct" Color="Color.Primary" Size="Size.Small" aria-label="@($"{c.Category} share of asset value")" />
                            </div>
                        }
                        @if (_assetSummary.LinkedLiabilities > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Equity after linked debt: <span class="fl-num">@Format.Money(_assetSummary.TotalEquity)</span>
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </div>
        }

        @if (_activity is not null)
        {
            <div class="fl-masonry-item">
                <MudCard Class="fl-card-hover">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Money In · 30d</MudText>
                        <MudText Typo="Typo.h5" Class="fl-num" Color="Color.Success">@Format.Money(_activity.MoneyInLast30Days)</MudText>
                    </MudCardContent>
                </MudCard>
            </div>
            <div class="fl-masonry-item">
                <MudCard Class="fl-card-hover">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Money Out · 30d</MudText>
                        <MudText Typo="Typo.h5" Class="fl-num">@Format.Money(_activity.MoneyOutLast30Days)</MudText>
                        @if (_activity.TransfersExcluded > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Excludes @_activity.TransfersExcluded transfer(s) between your accounts</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </div>
            <div class="fl-masonry-item">
                <MudCard Class="fl-card-hover">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Pending</MudText>
                        <MudText Typo="Typo.h5" Class="fl-num" Color="@Format.Delta(_activity.PendingNetAmount)">@Format.Signed(_activity.PendingNetAmount)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_activity.Pending.Count transaction(s) not yet posted</MudText>
                    </MudCardContent>
                </MudCard>
            </div>
            <div class="fl-masonry-item">
                <MudCard Class="fl-card-hover">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="@(_activity.Suspicious.Count > 0 ? Color.Warning : Color.Success)">Needs a Look</MudText>
                        <MudText Typo="Typo.h5" Class="fl-num" Color="@(_activity.Suspicious.Count > 0 ? Color.Warning : Color.Success)">
                            @(_activity.Suspicious.Count > 0 ? $"{_activity.Suspicious.Count} flagged" : "All clear")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Duplicates, outliers, new merchants</MudText>
                    </MudCardContent>
                </MudCard>
            </div>

            @if (_activity.Suspicious.Count > 0)
            {
                <div class="fl-masonry-item">
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Suspicious Activity</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Worth a second look. Heuristics, not proof of fraud.</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            @foreach (var f in _activity.Suspicious)
                            {
                                <div class="d-flex justify-space-between align-center py-1">
                                    <div>
                                        <MudText Typo="Typo.body2" Style="font-weight:500">@(string.IsNullOrWhiteSpace(f.Transaction.MerchantName) ? f.Transaction.Description : f.Transaction.MerchantName)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@AccountName(f.Transaction.AccountId) · @Format.DayMonth(f.Transaction.PostedDate ?? f.Transaction.EffectiveDate)</MudText>
                                        <div>
                                            @foreach (var r in f.Reasons)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@r</MudChip>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex align-center">
                                        <MudText Typo="Typo.body2" Class="fl-num">@Signed(f.Transaction)</MudText>
                                        <MudButton Size="Size.Small" Color="Color.Default" OnClick="() => DismissFlag(f)"
                                                   aria-label="@($"Dismiss alert for {FlagName(f)}")">Dismiss</MudButton>
                                    </div>
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>
                </div>
            }

            <div class="fl-masonry-item">
                @ActivityList("Recent Activity", "Latest posted transactions across all accounts", _activity.RecentPosted, "No posted transactions yet.")
            </div>
            <div class="fl-masonry-item">
                @ActivityList("Pending", "Authorised but not yet posted", _activity.Pending, "Nothing pending.")
            </div>
            <div class="fl-masonry-item">
                @ActivityList("Large Transactions", $"Last 30 days, at or above {Format.Money(_activity.LargeThreshold)}", _activity.Large, "No unusually large transactions.")
            </div>
        }

        <!-- Overdraft Warnings detail -->
        @if (_overdraftWarnings.Count > 0)
        {
            <div class="fl-masonry-item fl-masonry-span">
                <MudAlert Severity="Severity.Error" aria-live="assertive">
                    <MudText Typo="Typo.subtitle2">Overdraft Risk Detected</MudText>
                    @foreach (var w in _overdraftWarnings)
                    {
                        var acct = _accounts.FirstOrDefault(a => a.Id == w.AccountId);
                        <MudText Typo="Typo.body2">
                            @(acct?.Name ?? w.AccountId.ToString()) may go negative on @Format.FullDate(w.FirstBreachDate)
                            (projected: @Format.Money(w.ProjectedBalanceAmount))
                        </MudText>
                    }
                </MudAlert>
            </div>
        }
    </div>
}

@code {
    private static string FlagName(FlowLedger.Web.ApiClient.FlaggedTransactionDto f) =>
        string.IsNullOrWhiteSpace(f.Transaction.MerchantName) ? f.Transaction.Description : f.Transaction.MerchantName;

    private async Task DismissFlag(FlowLedger.Web.ApiClient.FlaggedTransactionDto f)
    {
        var dialog = await Dialogs.ShowAsync<DismissFlagDialog>("Dismiss alert", new DialogParameters<DismissFlagDialog>
        {
            { x => x.Merchant, FlagName(f) },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        var note = result.Data as string;
        try
        {
            if (await ApiClient.DismissSuspiciousAsync(f.Transaction.Id, string.IsNullOrWhiteSpace(note) ? null : note))
            {
                _activity = _activity! with { Suspicious = _activity.Suspicious.Where(x => x != f).ToList() };
                Snackbar.Add("Alert dismissed", Severity.Success);
            }
            else
            {
                Snackbar.Add("Couldn't dismiss the alert", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to dismiss flagged transaction");
            Snackbar.Add("Couldn't dismiss the alert", Severity.Error);
        }
    }

    private static string AccountIcon(string type) => type switch
    {
        "Checking" => Icons.Material.Filled.AccountBalance,
        "Savings" => Icons.Material.Filled.Savings,
        "CreditCard" => Icons.Material.Filled.CreditCard,
        "Loan" or "Mortgage" => Icons.Material.Filled.Home,
        "Investment" => Icons.Material.Filled.ShowChart,
        "Cash" => Icons.Material.Filled.Payments,
        _ => Icons.Material.Filled.AccountBalanceWallet
    };

    private static Color AccountColor(string type) => type switch
    {
        "Checking" => Color.Primary,
        "Savings" => Color.Success,
        "CreditCard" => Color.Warning,
        "Loan" or "Mortgage" => Color.Error,
        "Investment" => Color.Info,
        _ => Color.Default
    };

    private string AccountName(Guid id) => _accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "Unknown account";

    private static decimal SignedValue(FlowLedger.Web.ApiClient.TransactionDto t) => t.Direction == "Debit" ? -t.Amount : t.Amount;
    private static string Signed(FlowLedger.Web.ApiClient.TransactionDto t) => Format.Signed(SignedValue(t));

    private RenderFragment ActivityList(string title, string subtitle,
        List<FlowLedger.Web.ApiClient.TransactionDto> items, string empty) => __builder =>
    {
        <MudCard Style="height:100%">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@title</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@subtitle</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="max-height:360px;overflow-y:auto">
                @if (items.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@empty</MudText>
                }
                @foreach (var t in items)
                {
                    <div class="d-flex justify-space-between align-center py-1">
                        <div>
                            <MudText Typo="Typo.body2" Style="font-weight:500">@(string.IsNullOrWhiteSpace(t.MerchantName) ? t.Description : t.MerchantName)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@AccountName(t.AccountId) · @Format.DayMonth(t.PostedDate ?? t.EffectiveDate)@(t.Status == "Pending" ? " · pending" : "")</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="fl-num" Color="@Format.Delta(SignedValue(t))">@Signed(t)</MudText>
                    </div>
                }
            </MudCardContent>
        </MudCard>
    };

    private bool _loading = true;
    private string? _error;

    private List<FlowLedger.Web.ApiClient.AccountDto> _accounts = [];
    private FlowLedger.Web.ApiClient.DashboardInsightsDto? _insights;
    private List<MudBlazor.ChartSeries<double>> _spendSeries = [];
    private string[] _spendLabels = [];
    private List<MudBlazor.ChartSeries<double>> _flowSeries = [];
    private string[] _flowLabels = [];
    private List<MudBlazor.ChartSeries<double>> _netWorthSeries = [];
    private string[] _netWorthLabels = [];
    private decimal _cash;
    private decimal _credit;
    private decimal _loans;
    private decimal _investments;
    private decimal _netWorth;
    private FlowLedger.Web.ApiClient.AssetSummaryDto? _assetSummary;
    private decimal _lowWaterMark;
    private DateOnly? _lowWaterMarkDate;
    private int _overdraftCount;
    private List<FlowLedger.Web.ApiClient.OverdraftWarningDto> _overdraftWarnings = [];
    private List<FlowLedger.Web.ApiClient.AggregateForecastPointDto> _forecastSeries = [];
    private List<UpcomingFlow> _upcomingFlows = [];
    private FlowLedger.Web.ApiClient.DashboardActivityDto? _activity;

    // Derived collections for SvgChart
    private IReadOnlyList<(DateOnly date, decimal balance)> _forecastPoints = [];
    private IReadOnlyList<DateOnly>? _breachDates;
    private (DateOnly date, decimal balance)? _lwmTuple;

    private record UpcomingFlow(string Name, DateOnly Date, decimal Amount, bool IsCredit);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await ApiClient.GetAccountsAsync();

            // Net worth: assets (positive balance accounts) minus liabilities
            _cash = _accounts.Where(a => a.AccountType is "Checking" or "Savings" or "Cash").Sum(a => a.BalanceAmount);
            _credit = _accounts.Where(a => a.AccountType is "CreditCard").Sum(a => a.BalanceAmount);
            _loans = _accounts.Where(a => a.AccountType is "Loan" or "Mortgage" or "ManualLiability").Sum(a => a.BalanceAmount);
            _investments = _accounts.Where(a => a.AccountType is "Investment" or "ManualAsset").Sum(a => a.BalanceAmount);
            var assetTypes = new[] { "Checking", "Savings", "Investment", "Cash", "ManualAsset" };
            var liabilityTypes = new[] { "CreditCard", "Loan", "Mortgage", "ManualLiability" };
            var assets = _accounts.Where(a => assetTypes.Contains(a.AccountType)).Sum(a => a.BalanceAmount);
            var liabilities = _accounts.Where(a => liabilityTypes.Contains(a.AccountType)).Sum(a => Math.Abs(a.BalanceAmount));
            _netWorth = assets - liabilities;

            // Asset overview is best-effort. When available, its server-side net worth replaces the
            // client formula: it counts each physical asset once (never double-counting an asset that
            // is linked to a Manual Asset account) and values depreciating assets as of today.
            try
            {
                _assetSummary = await ApiClient.GetAssetSummaryAsync();
                if (_assetSummary is not null)
                {
                    _netWorth = _assetSummary.NetWorth.NetWorth;
                }
            }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to load asset summary"); }

            // Activity feed is best-effort: a failure here must not blank the rest of the dashboard.
            try { _activity = await ApiClient.GetDashboardActivityAsync(); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to load dashboard activity"); }

            // Insight widgets are best-effort: a failure must not blank the rest of the dashboard.
            try
            {
                _insights = await ApiClient.GetDashboardInsightsAsync();
                if (_insights is not null)
                {
                    _spendSeries = [new MudBlazor.ChartSeries<double> { Name = "Spending", Data = _insights.SpendingByCategory.Select(c => (double)c.Amount).ToArray() }];
                    _spendLabels = _insights.SpendingByCategory.Select(c => c.Category).ToArray();
                    _flowSeries =
                    [
                        new MudBlazor.ChartSeries<double> { Name = "Income", Data = _insights.CashFlow.Select(m => (double)m.Income).ToArray() },
                        new MudBlazor.ChartSeries<double> { Name = "Spending", Data = _insights.CashFlow.Select(m => (double)m.Spending).ToArray() },
                    ];
                    _flowLabels = _insights.CashFlow.Select(m => m.Month.Length >= 7 ? m.Month[..7] : m.Month).ToArray();
                    var nw = _insights.NetWorth.TakeLast(60).ToList();
                    _netWorthSeries = [new MudBlazor.ChartSeries<double> { Name = "Net worth", Data = nw.Select(p => (double)p.Value).ToArray() }];
                    _netWorthLabels = nw.Select(p => p.Date).ToArray();
                }
            }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to load dashboard insights"); }

            // Forecast
            var forecast = await ApiClient.GetForecastAsync(months: 3);
            if (forecast is not null)
            {
                _forecastSeries = forecast.AggregateSeries;

                if (forecast.AggregateLowWaterMark is not null)
                {
                    _lowWaterMark = forecast.AggregateLowWaterMark.MinBalanceAmount;
                    _lowWaterMarkDate = forecast.AggregateLowWaterMark.Date;
                }

                _overdraftWarnings = forecast.OverdraftWarnings;
                _overdraftCount = _overdraftWarnings.Count;
            }

            // Map forecast series to typed tuples for SvgChart
            _forecastPoints = _forecastSeries
                .Select(p => (p.Date, p.BalanceAmount))
                .ToList();

            // Breach dates from overdraft warnings
            _breachDates = _overdraftWarnings.Count > 0
                ? _overdraftWarnings.Select(w => w.FirstBreachDate).Distinct().ToList()
                : null;

            // Low water mark tuple
            _lwmTuple = _lowWaterMarkDate.HasValue
                ? (_lowWaterMarkDate.Value, _lowWaterMark)
                : null;

            // Recurring flows for upcoming 14 days
            var flows = await ApiClient.GetRecurringFlowsAsync();
            var today = DateOnly.FromDateTime(DateTime.Today);
            var horizon = today.AddDays(14);

            foreach (var flow in flows.Where(f => f.IsActive))
            {
                for (var d = today; d <= horizon; d = d.AddDays(1))
                {
                    if (IsFlowOnDate(flow, d))
                    {
                        _upcomingFlows.Add(new UpcomingFlow(
                            flow.Name, d, flow.Amount, flow.Direction == "Credit"));
                    }
                }
            }

            _upcomingFlows = _upcomingFlows.OrderBy(f => f.Date).Take(20).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dashboard data");
            _error = ex is FlowLedger.Web.ApiClient.ApiClientException ace
                ? ace.Message
                : "Failed to load dashboard data. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsFlowOnDate(FlowLedger.Web.ApiClient.RecurringFlowDto flow, DateOnly date)
    {
        if (date < flow.StartDate) return false;
        if (flow.EndDate.HasValue && date > flow.EndDate) return false;

        return flow.RecurrenceFrequency switch
        {
            "Monthly" => flow.DayOfMonth.HasValue && date.Day == flow.DayOfMonth.Value,
            "Weekly" => flow.AnchorDayOfWeek is not null &&
                        date.DayOfWeek.ToString().Equals(flow.AnchorDayOfWeek, StringComparison.OrdinalIgnoreCase),
            "Daily" => true,
            _ => false
        };
    }
}
