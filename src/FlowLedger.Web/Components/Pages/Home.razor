    private DashboardCardState InsightState(bool hasData) =>
        _insightsUnavailable ? DashboardCardState.Error : hasData ? DashboardCardState.Ready : DashboardCardState.Empty;

    private bool _loading = true;
    private string? _error;

    // Configurable ranges: history window for the insight charts, and forward horizon for the projection.
    private static readonly string[] HistoryPresets =
        ["1M", "6M", "1Y", "All", "This month", "Last month", "Last 30 days", "Last 90 days", "Last 6 months", "Year to date", "Last 12 months", "All time", "Custom"];
    private string _rangePreset = "Last 6 months";
    private DateOnly? _rangeFrom = DateRangeSelector.Resolve("Last 6 months").From;
    private DateOnly _rangeTo = DateRangeSelector.Resolve("Last 6 months").To;
    private int _horizonMonths = 3;
    private int _upcomingDays = 14;
    private List<FlowLedger.Contracts.RecurringFlowDto> _flowDefs = [];

    // The activity feed is the recent window the API returns; the History range narrows it further (never widens it).
    private IReadOnlyList<FlowLedger.Contracts.TransactionDto> InHistoryRange(IReadOnlyList<FlowLedger.Contracts.TransactionDto> items) =>
        items.Where(t =>
        {
            var d = t.PostedDate ?? t.EffectiveDate;
            return d <= _rangeTo && (_rangeFrom is not { } f || d >= f);
        }).ToList();

    private void OnUpcomingDaysChanged(int days)
    {
        _upcomingDays = days;
        BuildUpcoming();
    }

    private void BuildUpcoming()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var horizon = today.AddDays(_upcomingDays);
        var list = new List<UpcomingFlow>();
        foreach (var flow in _flowDefs.Where(f => f.IsActive))
        {
            for (var d = today; d <= horizon; d = d.AddDays(1))
            {
                if (IsFlowOnDate(flow, d))
                {
                    list.Add(new UpcomingFlow(flow.Name, d, flow.Amount, flow.Direction == "Credit"));
                }
            }
        }

        _upcomingFlows = list.OrderBy(f => f.Date).Take(40).ToList();
    }

    private string RangeLabel => _rangePreset switch
    {
        "All time" or "All" => "All time",
        "1M" => "Past month",
        "6M" => "Past 6 months",
        "1Y" => "Past year",
        "Custom" => $"{Format.FullDate(_rangeFrom ?? _rangeTo)} – {Format.FullDate(_rangeTo)}",
        _ => _rangePreset,
    };

    private async Task OnRangeChanged(DateRangeSelector.DateRange r)
    {
        _rangePreset = r.Preset;
        _rangeFrom = r.From;
        _rangeTo = r.To;
        await ReloadInsightsAsync();
    }

    private async Task OnHorizonChanged(int months)
    {
        _horizonMonths = months;
        try
        {
            var forecast = await ApiClient.GetForecastAsync(months: _horizonMonths);
            _forecastUnavailable = forecast is null;
            if (forecast is not null)
            {
                _forecastPoints = forecast.AggregateSeries.Select(p => (p.Date, p.BalanceAmount)).ToList();
                if (forecast.AggregateLowWaterMark is not null)
                {
                    _lowWaterMark = forecast.AggregateLowWaterMark.MinBalanceAmount;
                    _lowWaterMarkDate = forecast.AggregateLowWaterMark.Date;
                }
                _lwmTuple = _lowWaterMarkDate.HasValue ? (_lowWaterMarkDate.Value, _lowWaterMark) : null;
                _overdraftWarnings = forecast.OverdraftWarnings;
                _overdraftCount = _overdraftWarnings.Count;
                _breachDates = _overdraftWarnings.Count > 0 ? _overdraftWarnings.Select(w => w.FirstBreachDate).Distinct().ToList() : null;
            }
        }
        catch (Exception ex)
        {
            _forecastUnavailable = true;
            Logger.LogWarning(ex, "Failed to reload forecast");
            Snackbar.Add("Couldn't load the forecast", Severity.Error);
        }
    }

    private async Task ReloadInsightsAsync()
    {
        try
        {
            _insights = await ApiClient.GetDashboardInsightsAsync(_rangeFrom, _rangeTo);
            _insightsUnavailable = _insights is null;
            ApplyInsights();
        }
        catch (Exception ex)
        {
            _insightsUnavailable = true;
            Logger.LogWarning(ex, "Failed to reload dashboard insights");
            Snackbar.Add("Couldn't load that date range", Severity.Error);
        }
    }

    private string FlowSummary()
    {
        if (_insights is null || _insights.CashFlow.Count == 0)
        {
            return "Income vs spending: no data.";
        }

        var income = _insights.CashFlow.Sum(m => m.Income);
        var spending = _insights.CashFlow.Sum(m => m.Spending);
        return $"Income vs spending over {_insights.CashFlow.Count} months: income {Format.Money(income)}, spending {Format.Money(spending)}, net {Format.Money(income - spending)}.";
    }

    private IReadOnlyList<ChartRow> FlowRows() =>
        _insights is null ? [] : _insights.CashFlow
            .Select(m => new ChartRow(m.Month.Length >= 7 ? m.Month[..7] : m.Month,
                $"{Format.Money(m.Income)} / {Format.Money(m.Spending)} / {Format.Money(m.Income - m.Spending)}"))
            .ToList();

    private string ProjectionSummary()
    {
        var text = ChartSummary.Trend($"Projected cash balance over {_horizonMonths} months",
            _forecastPoints.Select(p => (Format.FullDate(p.date), p.balance)).ToList(), Format.Money);
        if (_lwmTuple is { } low)
        {
            text += $" Lowest point {Format.Money(low.balance)} on {Format.FullDate(low.date)}.";
        }

        if (_breachDates is { Count: > 0 })
        {
            text += $" Balance goes below zero on {_breachDates.Count} dates, first {Format.FullDate(_breachDates.Min())}.";
        }

        return text;
    }

    private void ApplyInsights()
    {
        if (_insights is null)
        {
            return;
        }

        _spendSeries = [new MudBlazor.ChartSeries<double> { Name = "Spending", Data = _insights.SpendingByCategory.Select(c => (double)c.Amount).ToArray() }];
        _spendLabels = _insights.SpendingByCategory.Select(c => c.Category).ToArray();
        _flowSeries =
        [
            new MudBlazor.ChartSeries<double> { Name = "Income", Data = _insights.CashFlow.Select(m => (double)m.Income).ToArray() },
            new MudBlazor.ChartSeries<double> { Name = "Spending", Data = _insights.CashFlow.Select(m => (double)m.Spending).ToArray() },
            new MudBlazor.ChartSeries<double> { Name = "Net", Data = _insights.CashFlow.Select(m => (double)(m.Income - m.Spending)).ToArray() },
        ];
        _totalIncome = _insights.CashFlow.Sum(m => m.Income);
        _netSaved = _totalIncome - _insights.CashFlow.Sum(m => m.Spending);
        _savingsRate = _totalIncome > 0 ? (double)(_netSaved / _totalIncome) : null;
        _flowLabels = _insights.CashFlow.Select(m => m.Month.Length >= 7 ? m.Month[..7] : m.Month).ToArray();
        var nw = _insights.NetWorth.TakeLast(60).ToList();
        _netWorthSeries = [new MudBlazor.ChartSeries<double> { Name = "Net worth", Data = nw.Select(p => (double)p.Value).ToArray() }];
        _netWorthLabels = nw.Select(p => p.Date).ToArray();
    }

    private List<FlowLedger.Contracts.AccountDto> _accounts = [];
    private DashboardInsightsDto? _insights;
    private bool _insightsUnavailable;
    private bool _activityUnavailable;
    private bool _forecastUnavailable;
    private List<MudBlazor.ChartSeries<double>> _spendSeries = [];
    private string[] _spendLabels = [];
    private List<MudBlazor.ChartSeries<double>> _flowSeries = [];
    private decimal _totalIncome;
    private decimal _netSaved;
    private double? _savingsRate;
    private string[] _flowLabels = [];
    private List<MudBlazor.ChartSeries<double>> _netWorthSeries = [];
    private string[] _netWorthLabels = [];
    private decimal _cash;
    private decimal _credit;
    private decimal _loans;
    private decimal _investments;
    private decimal _netWorth;
    private FlowLedger.Contracts.AssetSummaryDto? _assetSummary;
    private decimal _lowWaterMark;
    private DateOnly? _lowWaterMarkDate;
    private int _overdraftCount;
    private List<FlowLedger.Web.ApiClient.OverdraftWarningDto> _overdraftWarnings = [];
    private List<FlowLedger.Web.ApiClient.AggregateForecastPointDto> _forecastSeries = [];
    private List<UpcomingFlow> _upcomingFlows = [];
    private FlowLedger.Contracts.DashboardActivityDto? _activity;

    // Derived collections for SvgChart
    private IReadOnlyList<(DateOnly date, decimal balance)> _forecastPoints = [];
    private IReadOnlyList<DateOnly>? _breachDates;
    private (DateOnly date, decimal balance)? _lwmTuple;

    private record UpcomingFlow(string Name, DateOnly Date, decimal Amount, bool IsCredit);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The calls are independent: start them together, then handle each result (and its failure) separately.
            var accountsTask = ApiClient.GetAccountsAsync();
            var assetSummaryTask = ApiClient.GetAssetSummaryAsync();
            var activityTask = ApiClient.GetDashboardActivityAsync();
            var insightsTask = ApiClient.GetDashboardInsightsAsync(_rangeFrom, _rangeTo);
            var forecastTask = ApiClient.GetForecastAsync(months: _horizonMonths);

            _accounts = await accountsTask;

            // Net worth: assets (positive balance accounts) minus liabilities
            _cash = _accounts.Where(a => a.AccountType is "Checking" or "Savings" or "Cash").Sum(a => a.BalanceAmount);
            _credit = _accounts.Where(a => a.AccountType is "CreditCard").Sum(a => a.BalanceAmount);
            _loans = _accounts.Where(a => a.AccountType is "Loan" or "Mortgage" or "ManualLiability").Sum(a => a.BalanceAmount);
            _investments = _accounts.Where(a => a.AccountType is "Investment" or "ManualAsset").Sum(a => a.BalanceAmount);
            var assetTypes = new[] { "Checking", "Savings", "Investment", "Cash", "ManualAsset" };
            var liabilityTypes = new[] { "CreditCard", "Loan", "Mortgage", "ManualLiability" };
            var assets = _accounts.Where(a => assetTypes.Contains(a.AccountType)).Sum(a => a.BalanceAmount);
            var liabilities = _accounts.Where(a => liabilityTypes.Contains(a.AccountType)).Sum(a => Math.Abs(a.BalanceAmount));
            _netWorth = assets - liabilities;

            // Asset overview is best-effort. When available, its server-side net worth replaces the
            // client formula: it counts each physical asset once (never double-counting an asset that
            // is linked to a Manual Asset account) and values depreciating assets as of today.
            try
            {
                _assetSummary = await assetSummaryTask;
                if (_assetSummary is not null)
                {
                    _netWorth = _assetSummary.NetWorth.NetWorth;
                }
            }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to load asset summary"); }

            // Activity feed is best-effort: a failure here must not blank the rest of the dashboard.
            try
            {
                _activity = await activityTask;
                _activityUnavailable = _activity is null;
            }
            catch (Exception ex)
            {
                _activityUnavailable = true;
                Logger.LogWarning(ex, "Failed to load dashboard activity");
            }

            // Insight widgets are best-effort: a failure must not blank the rest of the dashboard.
            try
            {
                _insights = await insightsTask;
                _insightsUnavailable = _insights is null;
                ApplyInsights();
            }
            catch (Exception ex)
            {
                _insightsUnavailable = true;
                Logger.LogWarning(ex, "Failed to load dashboard insights");
            }

            // Forecast is best-effort too: a failure shows "Unavailable" on its cards, never a fake zero.
            FlowLedger.Web.ApiClient.ForecastResultDto? forecast = null;
            try { forecast = await forecastTask; }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to load forecast"); }
            _forecastUnavailable = forecast is null;
            if (forecast is not null)
            {
                _forecastSeries = forecast.AggregateSeries;

                if (forecast.AggregateLowWaterMark is not null)
                {
                    _lowWaterMark = forecast.AggregateLowWaterMark.MinBalanceAmount;
                    _lowWaterMarkDate = forecast.AggregateLowWaterMark.Date;
                }

                _overdraftWarnings = forecast.OverdraftWarnings;
                _overdraftCount = _overdraftWarnings.Count;
            }

            // Map forecast series to typed tuples for SvgChart
            _forecastPoints = _forecastSeries
                .Select(p => (p.Date, p.BalanceAmount))
                .ToList();

            // Breach dates from overdraft warnings
            _breachDates = _overdraftWarnings.Count > 0
                ? _overdraftWarnings.Select(w => w.FirstBreachDate).Distinct().ToList()
                : null;

            // Low water mark tuple
            _lwmTuple = _lowWaterMarkDate.HasValue
                ? (_lowWaterMarkDate.Value, _lowWaterMark)
                : null;

            // Recurring flows for the selectable upcoming window
            _flowDefs = await ApiClient.GetRecurringFlowsAsync();
            BuildUpcoming();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dashboard data");
            _error = ex is FlowLedger.Web.ApiClient.ApiClientException ace
                ? ace.Message
                : "Failed to load dashboard data. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsFlowOnDate(FlowLedger.Contracts.RecurringFlowDto flow, DateOnly date)
    {
        if (date < flow.StartDate) return false;
        if (flow.EndDate.HasValue && date > flow.EndDate) return false;

        return flow.RecurrenceFrequency switch
        {
            "Monthly" => flow.DayOfMonth.HasValue && date.Day == flow.DayOfMonth.Value,
            "Weekly" => flow.AnchorDayOfWeek is not null &&
                        date.DayOfWeek.ToString().Equals(flow.AnchorDayOfWeek, StringComparison.OrdinalIgnoreCase),
            "Daily" => true,
            _ => false
        };
    }
}
