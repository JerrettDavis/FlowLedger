@page "/"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject ILogger<Home> Logger
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Dashboard — FlowLedger</PageTitle>

<PageHeader Title="Dashboard">
    <div class="fl-page-header__actions">
        <DateRangeSelector Label="History" Preset="@_rangePreset" From="@(_rangeFrom ?? default)" To="@_rangeTo"
                           Presets="@HistoryPresets" Changed="OnRangeChanged" />
        <MudSelect T="int" Value="_horizonMonths" ValueChanged="OnHorizonChanged" Label="Forecast" Dense="true"
                   Variant="Variant.Outlined" Class="fl-select-md" aria-label="Forecast horizon">
            @foreach (var m in new[] { 1, 3, 6, 12 })
            {
                <MudSelectItem T="int" Value="@m">@m @(m == 1 ? "month" : "months")</MudSelectItem>
            }
        </MudSelect>
    </div>
</PageHeader>

<AlertsPanel />

@if (!_loading && _accounts.Count > 0)
{
    <nav class="fl-account-strip mb-4" aria-label="Accounts">
        @foreach (var a in _accounts.Where(x => x.IsActive))
        {
            var linked = !string.IsNullOrWhiteSpace(a.ExternalAccountRef) || !string.IsNullOrWhiteSpace(a.Institution);
            <a class="fl-account-chip" href="@($"transactions?account={a.Id}")"
               title="@a.Name — @Format.Money(a.BalanceAmount)" aria-label="@($"{a.Name}, balance {Format.Money(a.BalanceAmount)}. View transactions")">
                <MudBadge Content="@("")" Dot="true" Color="Color.Success" Visible="@linked" Overlap="true">
                    <MudAvatar Color="@AccountColor(a.AccountType)" Variant="Variant.Filled">
                        <MudIcon Icon="@AccountIcon(a.AccountType)" />
                    </MudAvatar>
                </MudBadge>
                <span class="fl-account-chip__name">@a.Name</span>
                <span class="fl-account-chip__bal fl-num">@Format.Money(a.BalanceAmount)</span>
            </a>
        }
    </nav>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (_loading)
{
    <div aria-label="Loading dashboard">
        <!-- KPI skeleton row -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="6">
                <CardSkeleton Height="120px" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <CardSkeleton Height="120px" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <CardSkeleton Height="120px" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <CardSkeleton Height="120px" />
            </MudItem>
        </MudGrid>
        <!-- Chart + flows skeleton row -->
        <MudGrid>
            <MudItem xs="12" md="8">
                <CardSkeleton Height="300px" />
            </MudItem>
            <MudItem xs="12" md="4">
                <CardSkeleton Height="300px" />
            </MudItem>
        </MudGrid>
    </div>
}
else
{
    <!-- Summary cards -->
    <MudGrid Class="mb-4">

        <!-- Hero: Total Balance -->
        <MudItem xs="12" md="6">
            <MudCard Class="fl-hero fl-card-hover fl-enter fl-enter-1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="Color.Primary">Cash</MudText>
                    <MudText Typo="Typo.h3" Class="fl-num" aria-label="Cash balance">@Format.Money(_cash)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Checking &amp; savings &nbsp;·&nbsp; Credit @Format.Money(_credit) &nbsp;·&nbsp; Loans @Format.Money(_loans) &nbsp;·&nbsp; Investments @Format.Money(_investments)
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Net Worth -->
        <MudItem xs="12" sm="6" md="2">
            <MudCard Class="fl-card-hover fl-enter fl-enter-2">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Net Worth</MudText>
                    <MudText Typo="Typo.h5" Class="fl-num" Color="@Format.Delta(_netWorth)" aria-label="Net worth">@Format.Money(_netWorth)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(_assetSummary is { AssetCount: > 0 } ? "Incl. tracked assets" : "Assets minus liabilities")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Forecast Low -->
        <MudItem xs="12" sm="6" md="2">
            <MudCard Class="fl-card-hover fl-enter fl-enter-3">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="@(_lowWaterMark < 0 ? Color.Error : Color.Warning)">Forecast Low</MudText>
                    <MudText Typo="Typo.h5" Class="fl-num" Color="@(_forecastUnavailable ? Color.Default : Format.Delta(_lowWaterMark))" aria-label="Forecast low water mark">@(_forecastUnavailable ? "Unavailable" : Format.Money(_lowWaterMark))</MudText>
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(_forecastUnavailable ? "Couldn't load the forecast" : _lowWaterMarkDate.HasValue ? $"on {Format.DayMonth(_lowWaterMarkDate.Value)}" : $"{_horizonMonths}-month horizon")
                        </MudText>
                        @if (!_forecastUnavailable && _lowWaterMark < 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="pa-0 fl-chip-xs">Below zero</MudChip>
                        }
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Overdraft Risk -->
        <MudItem xs="12" sm="6" md="2">
            <MudCard Class="fl-card-hover fl-enter fl-enter-4">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="@(_overdraftCount > 0 ? Color.Error : Color.Success)">Overdraft Risk</MudText>
                    <MudText Typo="Typo.h5" Class="fl-num" Color="@(_overdraftCount > 0 ? Color.Error : Color.Success)" aria-label="Overdraft warnings">
                        @(_forecastUnavailable ? "Unavailable" : _overdraftCount > 0 ? $"{_overdraftCount} warning(s)" : "None")
                    </MudText>
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(_forecastUnavailable ? "Retry from the projection card" : $"Next {_horizonMonths} months")</MudText>
                        @if (_overdraftCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="pa-0 fl-chip-xs">
                                <MudIcon Icon="@Icons.Material.Outlined.Warning" Size="Size.Small" />
                            </MudChip>
                        }
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>

    <div class="fl-masonry">
        <!-- Insights: spending by category -->
        <div class="fl-masonry-item">
            <DashboardCard Title="@($"Spending · {RangeLabel}")" Caption="By category, excluding transfers between your accounts"
                           State="@InsightState(_insights is { SpendingByCategory.Count: > 0 })" OnRetry="ReloadInsightsAsync"
                           ErrorText="Couldn't load spending insights." EmptyText="No spending in this range.">
                @if (_insights is { SpendingByCategory.Count: > 0 })
                {
                        <ChartFigure Title="Spending by category"
                                     Summary="@ChartSummary.Categories($"Spending {RangeLabel}", _insights.SpendingByCategory.Select(c => (c.Category, c.Amount)), Format.Money)">
                            <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_spendSeries" ChartLabels="@_spendLabels" Width="180px" Height="180px" />
                        </ChartFigure>
                        <MudSimpleTable Dense="true" Elevation="0">
                            <tbody>
                                @foreach (var c in _insights.SpendingByCategory)
                                {
                                    <tr><td>@c.Category</td><td class="text-right fl-num">@Format.Money(c.Amount)</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                }
            </DashboardCard>
        </div>

        <!-- Insights: income vs spending -->
        <div class="fl-masonry-item">
            <DashboardCard Title="Income vs spending" Caption="@($"{RangeLabel}, excluding transfers")"
                           State="@InsightState(_insights is { CashFlow.Count: > 0 })" OnRetry="ReloadInsightsAsync"
                           ErrorText="Couldn't load income and spending." EmptyText="No income or spending in this range.">
                @if (_insights is { CashFlow.Count: > 0 })
                {
                        <ChartFigure Title="Income vs spending by month"
                                     Summary="@FlowSummary()"
                                     Rows="@FlowRows()" LabelHeader="Month" ValueHeader="Income / spending / net">
                            <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_flowSeries" ChartLabels="@_flowLabels" Width="100%" Height="220px" />
                        </ChartFigure>
                        @if (_savingsRate is { } rate)
                        {
                            <div class="d-flex align-center gap-2 mt-2 flex-wrap">
                                <MudChip T="string" Size="Size.Small" Color="@(rate >= 0.2 ? Color.Success : rate >= 0 ? Color.Warning : Color.Error)">
                                    Savings rate @Format.Ratio(rate)
                                </MudChip>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Kept @Format.Money(_netSaved) of @Format.Money(_totalIncome) earned over @RangeLabel
                                </MudText>
                            </div>
                        }
                }
            </DashboardCard>
        </div>

        <!-- Insights: what changed vs the previous period -->
        <div class="fl-masonry-item">
            <DashboardCard Title="Biggest changes" Caption="@(_insights is null ? RangeLabel : $"{RangeLabel} vs the previous period ({_insights.PreviousLabel})")"
                           State="@InsightState(_insights is { Movers.Count: > 0 })" OnRetry="ReloadInsightsAsync"
                           ErrorText="Couldn't load the biggest changes." EmptyText="Nothing changed enough to list.">
                @if (_insights is { Movers.Count: > 0 })
                {
                        var maxChange = (double)_insights.Movers.Max(m => Math.Abs(m.Change));
                        @foreach (var m in _insights.Movers)
                        {
                            <div class="mb-2">
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.body2">@m.Category</MudText>
                                    <MudText Typo="Typo.body2" Class="fl-num" Color="@(m.Change > 0 ? Color.Error : Color.Success)">
                                        @(m.Change > 0 ? "▲" : "▼") @Format.Money(Math.Abs(m.Change))@(m.Previous != 0 ? $" ({Format.Percent(m.Change, m.Previous)})" : "")
                                    </MudText>
                                </div>
                                <MudProgressLinear Value="@(maxChange == 0 ? 0 : Math.Abs((double)m.Change) / maxChange * 100)" Size="Size.Small"
                                                   Color="@(m.Change > 0 ? Color.Error : Color.Success)" aria-label="@($"{m.Category} change")"
                                                   aria-valuetext="@($"{m.Category}: {(m.Change > 0 ? "up" : "down")} {Format.Money(Math.Abs(m.Change))} ({Format.Money(m.Previous)} to {Format.Money(m.Current)})")" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Format.Money(m.Previous) → @Format.Money(m.Current)</MudText>
                            </div>
                        }
                }
            </DashboardCard>
        </div>

        <!-- Insights: top merchants -->
        <div class="fl-masonry-item">
            <DashboardCard Title="Top merchants" Caption="@($"{RangeLabel}, excluding transfers")"
                           State="@InsightState(_insights is { TopMerchants.Count: > 0 })" OnRetry="ReloadInsightsAsync"
                           ErrorText="Couldn't load top merchants." EmptyText="No merchant spending in this range.">
                @if (_insights is { TopMerchants.Count: > 0 })
                {
                        var topMerchant = (double)_insights.TopMerchants.Max(m => m.Amount);
                        @foreach (var m in _insights.TopMerchants)
                        {
                            <div class="mb-2">
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.body2">@m.Merchant <span class="fl-muted">· @m.Visits×</span></MudText>
                                    <MudText Typo="Typo.body2" Class="fl-num">@Format.Money(m.Amount)</MudText>
                                </div>
                                <MudProgressLinear Value="@(topMerchant == 0 ? 0 : (double)m.Amount / topMerchant * 100)" Size="Size.Small" Color="Color.Primary" aria-label="@($"{m.Merchant} spend")"
                                                   aria-valuetext="@($"{m.Merchant}: {Format.Money(m.Amount)} over {m.Visits} visits")" />
                            </div>
                        }
                }
            </DashboardCard>
        </div>

        <!-- Insights: net worth trend -->
        <div class="fl-masonry-item">
            <DashboardCard Title="Net worth trend" Caption="Account balances captured at each sync (assets are valued separately)"
                           State="@InsightState(_insights is { NetWorth.Count: > 1 })" OnRetry="ReloadInsightsAsync"
                           ErrorText="Couldn't load the net worth trend." EmptyText="The trend appears after a few syncs.">
                @if (_insights is { NetWorth.Count: > 1 })
                {
                        <ChartFigure Title="Net worth trend"
                                     Summary="@ChartSummary.Trend("Net worth", _insights.NetWorth.TakeLast(60).Select(p => (p.Date, p.Value)).ToList(), Format.Money)"
                                     Rows="@_insights.NetWorth.TakeLast(60).Select(p => new ChartRow(p.Date, Format.Money(p.Value))).ToList()"
                                     LabelHeader="Date" ValueHeader="Net worth">
                            <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@_netWorthSeries" ChartLabels="@_netWorthLabels" Width="100%" Height="220px" />
                        </ChartFigure>
                }
            </DashboardCard>
        </div>

        <!-- Balance Projection Chart -->
        <div class="fl-masonry-item">
            <DashboardCard Title="Balance Projection"
                           Caption="@($"{_horizonMonths}-month household cash balance forecast")"
                           State="@(_forecastUnavailable && _forecastPoints.Count < 2 ? DashboardCardState.Error : DashboardCardState.Ready)"
                           ErrorText="Couldn't load the forecast. The numbers above are unknown, not zero."
                           OnRetry="@(() => OnHorizonChanged(_horizonMonths))">
                @if (_forecastPoints.Count >= 2)
                {
                    <ChartFigure Title="Balance projection"
                                 Summary="@ProjectionSummary()">
                        <div class="fl-chart-box">
                            @((MarkupString)SvgChart.BuildBalanceProjection(
                                _forecastPoints,
                                zeroLine: 0m,
                                breaches: _breachDates,
                                lowWaterMark: _lwmTuple))
                        </div>
                    </ChartFigure>
                }
                else
                {
                    <EmptyState Icon="@Icons.Material.Outlined.ShowChart"
                                Title="No forecast yet"
                                Description="@OnboardingCopy.LoadData(Status?.Environment)" />
                }
            </DashboardCard>
        </div>

        <!-- Upcoming Flows -->
        <div class="fl-masonry-item">
            <DashboardCard Title="Upcoming Flows" Caption="@($"Next {_upcomingDays} days")">
                <HeaderActions>
                    <MudSelect T="int" Value="_upcomingDays" ValueChanged="OnUpcomingDaysChanged" Dense="true" Variant="Variant.Outlined"
                               Class="fl-select-sm" aria-label="Upcoming flows window">
                        @foreach (var d in new[] { 7, 14, 30, 60, 90 })
                        {
                            <MudSelectItem T="int" Value="@d">@d days</MudSelectItem>
                        }
                    </MudSelect>
                </HeaderActions>
                <ChildContent>
                    @if (_upcomingFlows.Count > 0)
                    {
                        <MudList T="UpcomingFlow" Dense="true" aria-label="Upcoming flows list">
                            @foreach (var f in _upcomingFlows)
                            {
                                <MudListItem>
                                    <div class="d-flex justify-space-between align-center w-100">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="fl-strong">@f.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Format.DayMonth(f.Date)</MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="fl-num" Color="@Format.Delta(f.IsCredit ? f.Amount : -f.Amount)">
                                            @Format.Signed(f.IsCredit ? f.Amount : -f.Amount)
                                        </MudText>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <EmptyState Icon="@Icons.Material.Outlined.CalendarMonth"
                                    Title="No upcoming flows"
                                    Description="@($"No scheduled transactions in the next {_upcomingDays} days.")" />
                    }
                </ChildContent>
            </DashboardCard>
        </div>

        @if (_assetSummary is { AssetCount: > 0 })
        {
            <div class="fl-masonry-item">
                <DashboardCard Title="Assets" Caption="@($"{_assetSummary.AssetCount} item(s) tracked")" Class="fl-card-hover">
                    <HeaderActions>
                        <MudButton Href="assets" Size="Size.Small" Variant="Variant.Text" aria-label="View all assets">View all</MudButton>
                    </HeaderActions>
                    <ChildContent>
                        <div class="d-flex justify-space-between align-end mb-3">
                            <div>
                                <MudText Typo="Typo.h5" Class="fl-num" aria-label="Total asset value">@Format.Money(_assetSummary.TotalValue)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Estimated value today</MudText>
                            </div>
                            @if (_assetSummary.TotalCost > 0)
                            {
                                <div class="text-right">
                                    <MudText Typo="Typo.body1" Class="fl-num" Color="@Format.Delta(_assetSummary.UnrealizedGainLoss)">@Format.SignedWithPercent(_assetSummary.UnrealizedGainLoss, _assetSummary.TotalCost)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">vs. @Format.Money(_assetSummary.TotalCost) cost</MudText>
                                </div>
                            }
                        </div>
                        @foreach (var c in _assetSummary.ByCategory.Take(4))
                        {
                            var pct = _assetSummary.TotalValue > 0 ? (double)(c.Value / _assetSummary.TotalValue * 100m) : 0d;
                            <div class="mb-2">
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.caption">@c.Category (@c.Count)</MudText>
                                    <MudText Typo="Typo.caption" Class="fl-num">@Format.Money(c.Value)</MudText>
                                </div>
                                <MudProgressLinear Value="@pct" Color="Color.Primary" Size="Size.Small" aria-label="@($"{c.Category} share of asset value")" />
                            </div>
                        }
                        @if (_assetSummary.LinkedLiabilities > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Equity after linked debt: <span class="fl-num">@Format.Money(_assetSummary.TotalEquity)</span>
                            </MudText>
                        }
                    </ChildContent>
                </DashboardCard>
            </div>
        }

        @if (_activity is null && _activityUnavailable)
        {
            <div class="fl-masonry-item">
                <DashboardCard Title="Recent activity" State="DashboardCardState.Error" OnRetry="ReloadActivityAsync"
                               ErrorText="Couldn't load recent activity, pending or flagged transactions." />
            </div>
        }

        @if (_activity is not null)
        {
            <div class="fl-masonry-item">
                <MudCard Class="fl-card-hover">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Money In · 30d</MudText>
                        <MudText Typo="Typo.h5" Class="fl-num" Color="Color.Success">@Format.Money(_activity.MoneyInLast30Days)</MudText>
                    </MudCardContent>
                </MudCard>
            </div>
            <div class="fl-masonry-item">
                <MudCard Class="fl-card-hover">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Money Out · 30d</MudText>
                        <MudText Typo="Typo.h5" Class="fl-num">@Format.Money(_activity.MoneyOutLast30Days)</MudText>
                        @if (_activity.TransfersExcluded > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Excludes @_activity.TransfersExcluded transfer(s) between your accounts</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </div>
            <div class="fl-masonry-item">
                <MudCard Class="fl-card-hover">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Pending</MudText>
                        <MudText Typo="Typo.h5" Class="fl-num" Color="@Format.Delta(_activity.PendingNetAmount)">@Format.Signed(_activity.PendingNetAmount)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_activity.Pending.Count transaction(s) not yet posted</MudText>
                    </MudCardContent>
                </MudCard>
            </div>
            <div class="fl-masonry-item">
                <MudCard Class="fl-card-hover">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="@(_activity.Suspicious.Count > 0 ? Color.Warning : Color.Success)">Needs a Look</MudText>
                        <MudText Typo="Typo.h5" Class="fl-num" Color="@(_activity.Suspicious.Count > 0 ? Color.Warning : Color.Success)">
                            @(_activity.Suspicious.Count > 0 ? $"{_activity.Suspicious.Count} flagged" : "All clear")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Duplicates, outliers, new merchants</MudText>
                    </MudCardContent>
                </MudCard>
            </div>

            @if (_activity.Suspicious.Count > 0)
            {
                <div class="fl-masonry-item">
                    <DashboardCard Title="Suspicious Activity" Caption="Worth a second look. Heuristics, not proof of fraud.">
                            @foreach (var f in _activity.Suspicious)
                            {
                                <div class="d-flex justify-space-between align-center py-1">
                                    <div>
                                        <MudText Typo="Typo.body2" Class="fl-strong">@(string.IsNullOrWhiteSpace(f.Transaction.MerchantName) ? f.Transaction.Description : f.Transaction.MerchantName)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@AccountName(f.Transaction.AccountId) · @Format.DayMonth(f.Transaction.PostedDate ?? f.Transaction.EffectiveDate)</MudText>
                                        <div>
                                            @foreach (var r in f.Reasons)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@r</MudChip>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex align-center">
                                        <MudText Typo="Typo.body2" Class="fl-num">@Signed(f.Transaction)</MudText>
                                        <MudButton Size="Size.Small" Color="Color.Default" OnClick="() => DismissFlag(f)"
                                                   aria-label="@($"Dismiss alert for {FlagName(f)}")">Dismiss</MudButton>
                                    </div>
                                </div>
                            }
                    </DashboardCard>
                </div>
            }

            <div class="fl-masonry-item">
                @ActivityList("Recent Activity", $"Latest posted, {RangeLabel}", InHistoryRange(_activity.RecentPosted), "No posted transactions in this range.")
            </div>
            <div class="fl-masonry-item">
                @ActivityList("Pending", "Authorised but not yet posted", _activity.Pending, "Nothing pending.")
            </div>
            <div class="fl-masonry-item">
                @ActivityList("Large Transactions", $"{RangeLabel}, at or above {Format.Money(_activity.LargeThreshold)}", InHistoryRange(_activity.Large), "No unusually large transactions.")
            </div>
        }

        <!-- Overdraft Warnings detail -->
        @if (_overdraftWarnings.Count > 0)
        {
            <div class="fl-masonry-item fl-masonry-span">
                <MudAlert Severity="Severity.Error" aria-live="assertive">
                    <MudText Typo="Typo.subtitle2">Overdraft Risk Detected</MudText>
                    @foreach (var w in _overdraftWarnings)
                    {
                        var acct = _accounts.FirstOrDefault(a => a.Id == w.AccountId);
                        <MudText Typo="Typo.body2">
                            @(acct?.Name ?? w.AccountId.ToString()) may go negative on @Format.FullDate(w.FirstBreachDate)
                            (projected: @Format.Money(w.ProjectedBalanceAmount))
                        </MudText>
                    }
                </MudAlert>
            </div>
        }
    </div>
}

@code {
    /// <summary>Environment from the layout; drives which empty-state instruction is shown.</summary>
    [CascadingParameter] private FlowLedger.Web.Services.LayoutStatus? Status { get; set; }

    private static string FlagName(FlowLedger.Contracts.FlaggedTransactionDto f) =>
        string.IsNullOrWhiteSpace(f.Transaction.MerchantName) ? f.Transaction.Description : f.Transaction.MerchantName;

    private async Task DismissFlag(FlowLedger.Contracts.FlaggedTransactionDto f)
    {
        var dialog = await Dialogs.ShowAsync<DismissFlagDialog>("Dismiss alert", new DialogParameters<DismissFlagDialog>
        {
            { x => x.Merchant, FlagName(f) },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        var note = result.Data as string;
        try
        {
            if (await ApiClient.DismissSuspiciousAsync(f.Transaction.Id, string.IsNullOrWhiteSpace(note) ? null : note))
            {
                _activity = _activity! with { Suspicious = _activity.Suspicious.Where(x => x != f).ToList() };
                Snackbar.Add("Alert dismissed", Severity.Success);
            }
            else
            {
                Snackbar.Add("Couldn't dismiss the alert", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to dismiss flagged transaction");
            Snackbar.Add("Couldn't dismiss the alert", Severity.Error);
        }
    }

