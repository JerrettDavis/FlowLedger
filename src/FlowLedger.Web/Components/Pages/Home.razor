    private static decimal SignedValue(FlowLedger.Contracts.TransactionDto t) => t.Direction == "Debit" ? -t.Amount : t.Amount;
    private static string Signed(FlowLedger.Contracts.TransactionDto t) => Format.Signed(SignedValue(t));

    private RenderFragment ActivityList(string title, string subtitle,
        IReadOnlyList<FlowLedger.Contracts.TransactionDto> items, string empty) => __builder =>
    {
        <DashboardCard Title="@title" Caption="@subtitle" Class="fl-fill" State="@(items.Count == 0 ? DashboardCardState.Empty : DashboardCardState.Ready)" EmptyText="@empty">
                @foreach (var t in items)
                {
                    <div class="d-flex justify-space-between align-center py-1">
                        <div>
                            <MudText Typo="Typo.body2" Class="fl-strong">@(string.IsNullOrWhiteSpace(t.MerchantName) ? t.Description : t.MerchantName)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@AccountName(t.AccountId) · @Format.DayMonth(t.PostedDate ?? t.EffectiveDate)@(t.Status == "Pending" ? " · pending" : "")</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="fl-num" Color="@Format.Delta(SignedValue(t))">@Signed(t)</MudText>
                    </div>
                }
        </DashboardCard>
    };

    private async Task ReloadActivityAsync()
    {
        try
        {
            _activity = await ApiClient.GetDashboardActivityAsync();
            _activityUnavailable = _activity is null;
        }
        catch (Exception ex)
        {
            _activityUnavailable = true;
            Logger.LogWarning(ex, "Failed to reload dashboard activity");
            Snackbar.AddFailure(ex, "Couldn't load recent activity");
