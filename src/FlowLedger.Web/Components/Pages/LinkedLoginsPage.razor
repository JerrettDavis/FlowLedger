@page "/account/logins"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Linked logins — FlowLedger</PageTitle>

<PageHeader Title="Linked logins" />
<MudText Typo="Typo.body2" Class="mb-4 fl-muted">
    Every login listed here sees the same data. Another person (for example a spouse) signing in with their own login gets their own separate data.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Logins on this account</MudText>
        <MudSimpleTable Dense="true">
            <thead><tr><th>Login</th><th>Email</th><th>Last sign-in</th><th></th></tr></thead>
            <tbody>
            @foreach (var l in _logins)
            {
                <tr>
                    <td>@(l.DisplayName ?? l.Subject) @if (l.UserId == _me) { <MudChip T="string" Size="Size.Small" Color="Color.Primary">this login</MudChip> }</td>
                    <td>@l.Email</td>
                    <td>@l.LastLoginUtc.ToLocalTime().ToString("g")</td>
                    <td>
                        @if (_logins.Count > 1 && l.UserId != _me)
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => Unlink(l)">Unlink</MudButton>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="mb-1">Add another login to this account</MudText>
        <MudText Typo="Typo.body2" Class="mb-2 fl-muted">Generate a code here, then sign in with the other login and enter it on this page. Codes work once and expire after 15 minutes.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="MakeCode">Generate code</MudButton>
        @if (_code is not null)
        {
            <MudText Typo="Typo.h5" Class="mt-3" Style="letter-spacing:0.15em">@_code.Code</MudText>
            <MudText Typo="Typo.caption" Class="fl-muted">Expires @_code.ExpiresUtc.ToLocalTime().ToString("t")</MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="mb-1">Use a code from another login</MudText>
        <MudText Typo="Typo.body2" Class="mb-2 fl-muted">
            Signed in with a second login? Enter the code from your main account to connect to it. Anything saved under this login on its own stays stored but won't be shown here.
        </MudText>
        <div class="d-flex align-center gap-3 flex-wrap">
            <MudTextField T="string" Immediate="true" @bind-Value="_enter" Label="Code" Margin="Margin.Dense" Style="max-width:220px" />
            <MudButton Variant="Variant.Filled" OnClick="Redeem" Disabled="@(string.IsNullOrWhiteSpace(_enter))">Link this login</MudButton>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="mb-1">Delete my data</MudText>
        @if (_deleted is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-2">Your data was deleted (@_deleted.TotalRows rows). Sign out to finish.</MudAlert>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Sign out</MudButton>
            </form>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2 fl-muted">
                Permanently erases everything stored for this account: accounts, transactions, budgets, saved reports, linked logins and archived bank responses.
                Bank connections are revoked where the provider allows it (otherwise remove them at your bank-linking provider). It cannot be undone, and copies in
                backups are removed as those backups expire.
            </MudText>
            <div class="d-flex align-center gap-3 flex-wrap">
                <MudTextField T="string" Immediate="true" @bind-Value="_confirmDelete" Label="Type DELETE MY DATA" Margin="Margin.Dense" Style="max-width:260px" />
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteMyData" Disabled="@(_confirmDelete != "DELETE MY DATA" || _deleting)">Delete everything</MudButton>
            </div>
        }
    </MudPaper>
}

@code {
    private bool _loading = true;
    private List<FlowLedger.Web.ApiClient.FlowLedgerApiClient.LinkedLoginDto> _logins = [];
    private FlowLedger.Web.ApiClient.FlowLedgerApiClient.LinkCodeDto? _code;
    private string? _enter;
    private Guid _me;
    private string? _confirmDelete;
    private bool _deleting;
    private FlowLedger.Web.ApiClient.FlowLedgerApiClient.DeleteMyDataResult? _deleted;

    private async Task DeleteMyData()
    {
        _deleting = true;
        try
        {
            _deleted = await ApiClient.DeleteMyDataAsync(_confirmDelete ?? string.Empty);
            if (_deleted is null)
            {
                Snackbar.Add("The data was not deleted. The household account cannot be deleted from here.", Severity.Warning);
            }
        }
        catch (Exception ex) { Snackbar.AddFailure(ex); }
        finally { _deleting = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid.TryParse(user.FindFirst(FlowLedger.Web.Auth.AuthSetup.UserClaim)?.Value, out _me);
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        try { _logins = (await ApiClient.GetLinkedLoginsAsync()).ToList(); }
        catch (Exception ex) { Snackbar.AddFailure(ex); }
        _loading = false;
    }

    private async Task MakeCode()
    {
        try { _code = await ApiClient.CreateLinkCodeAsync(); }
        catch (Exception ex) { Snackbar.AddFailure(ex); }
    }

    private async Task Redeem()
    {
        try
        {
            if (await ApiClient.RedeemLinkCodeAsync(_me, _enter!))
            {
                // The tenant lives in the sign-in cookie: drop only the local cookie and sign in again (the IdP session
                // is still active, so this is silent) to pick up the linked account's data.
                Nav.NavigateTo("/auth/relogin", forceLoad: true);
                return;
            }

            Snackbar.Add("That code is invalid or has expired.", Severity.Warning);
        }
        catch (Exception ex) { Snackbar.AddFailure(ex); }
    }

    private async Task Unlink(FlowLedger.Web.ApiClient.FlowLedgerApiClient.LinkedLoginDto l)
    {
        try
        {
            if (await ApiClient.UnlinkLoginAsync(l.UserId)) { await Load(); }
            else { Snackbar.Add("Could not unlink that login.", Severity.Warning); }
        }
        catch (Exception ex) { Snackbar.AddFailure(ex); }
    }
}
