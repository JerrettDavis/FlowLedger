<MudDialog aria-labelledby="note-dialog-title">
    <TitleContent>
        <MudText Typo="Typo.h6" id="note-dialog-title">Transaction note</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@Description</MudText>
        <MudTextField @bind-Value="Note" Label="Note" Lines="3" MaxLength="1000" AutoFocus="true" Immediate="true"
                      HelperText="Leave blank to remove the note." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" aria-label="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" aria-label="Save note">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Note { get; set; } = "";

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok(Note.Trim()));
}
