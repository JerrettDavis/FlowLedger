@page "/query"
@using FlowLedger.Web.ApiClient
@using FlowLedger.Web.Components.Shared
@inject FlowLedgerApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Query — FlowLedger</PageTitle>

<PageHeader Title="Query">
    <Description>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Pipe-style queries over your own data. Build a result, pick a chart, save it as a view or add it to a report.
            </MudText>
    </Description>
    <ChildContent>
        <MudButton Href="reports" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Assessment">Reports</MudButton>
    </ChildContent>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Elevation="0" Class="pa-3 mb-4" Style="border: 1px solid var(--mud-palette-divider);">
            @if (_loadedTitle is not null)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">Editing: @_loadedTitle</MudText>
            }
            <div class="d-flex gap-2 align-center mb-3">
                <MudTextField T="string" @bind-Value="_question" Label="Ask in plain English" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Placeholder="e.g. How much did I spend on dining last month?" Immediate="true" MaxLength="500"
                              OnKeyDown="OnAskKeyDown" Disabled="_asking" aria-label="Ask a question about your money" />
                <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="AskAsync" Disabled="@(_asking || string.IsNullOrWhiteSpace(_question))"
                           StartIcon="@Icons.Material.Filled.AutoAwesome">@(_asking ? "Thinking…" : "Ask")</MudButton>
            </div>
            @if (_askNote is not null)
            {
                <MudText Typo="Typo.caption" Class="mb-2" aria-live="polite">@_askNote</MudText>
            }
            @* JS owns the contents of this block (highlight overlay, textarea, popups). Blazor never re-renders inside it. *@
            <div class="fl-editor" @ref="_editorHost">
                <pre class="fl-editor-overlay" aria-hidden="true"></pre>
                <textarea class="fl-editor-input" rows="9" spellcheck="false" aria-label="Query editor"
                          aria-autocomplete="list" placeholder="transactions | where date >= ago(30d) | summarize total = sum(amount) by category"></textarea>
            </div>
            <div class="fl-editor-status" aria-live="polite"></div>
            @if (_queryError is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1" aria-live="assertive">@_queryError</MudText>
            }
            <div class="d-flex flex-wrap gap-2 mt-3 align-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="RunAsync" Disabled="_running"
                           StartIcon="@Icons.Material.Filled.PlayArrow">Run (Ctrl+Enter)</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="SaveViewAsync" Disabled="@(_result is null)"
                           StartIcon="@Icons.Material.Filled.Save">@(EditingView ? "Update view" : "Save view")</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="AddToReportAsync" Disabled="@(_result is null)"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd">Add to report</MudButton>
                <MudSpacer />
                @if (_running)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_result is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_result.Rows.Count row(s) · @_result.ElapsedMs ms</MudText>
                }
            </div>
        </MudPaper>

        @if (_result is not null)
        {
            <MudPaper Elevation="0" Class="pa-3 mb-4" Style="border: 1px solid var(--mud-palette-divider);">
                <MudGrid Spacing="2">
                    <MudItem xs="6" sm="3">
                        <MudSelect T="string" @bind-Value="_kind" Label="Display" Dense="true" aria-label="Visualization">
                            @foreach (var k in Kinds)
                            {
                                <MudSelectItem Value="@k.Key">@k.Value</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    @if (_kind != "table")
                    {
                        <MudItem xs="6" sm="3">
                            <MudSelect T="string" @bind-Value="_x" Label="X / category" Dense="true" Clearable="true" aria-label="X column">
                                @foreach (var c in _result.Columns)
                                {
                                    <MudSelectItem Value="@c.Name">@c.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_y" Label="Values" Dense="true" aria-label="Value columns">
                                @foreach (var c in _result.Columns.Where(c => c.Type == "number"))
                                {
                                    <MudSelectItem T="string" Value="@c.Name">@c.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudSelect T="string" @bind-Value="_seriesBy" Label="Split into series by" Dense="true" Clearable="true" aria-label="Series column">
                                @foreach (var c in _result.Columns)
                                {
                                    <MudSelectItem Value="@c.Name">@c.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @if (_kind is "column" or "bar" or "area")
                        {
                            <MudItem xs="12"><MudSwitch T="bool" @bind-Value="_stacked" Label="Stacked" Color="Color.Primary" /></MudItem>
                        }
                    }
                </MudGrid>
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-3" Style="border: 1px solid var(--mud-palette-divider);">
                <QueryChart Result="_result" Viz="CurrentViz()" />
            </MudPaper>
        }
        else if (!_running && _error is null && _queryError is null)
        {
            <EmptyState Icon="@Icons.Material.Outlined.QueryStats" Title="Write a query and run it"
                        Description="Start from a preset on the right, or click a dataset column to build one." />
        }
    </MudItem>

    <MudItem xs="12" md="4">
        <MudExpansionPanels MultiExpansion="true">
            <MudExpansionPanel Text="Presets and saved views" Expanded="true">
                @if (_reports.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Loading…</MudText>
                }
                @foreach (var group in _reports.Where(r => r.Kind == "View").GroupBy(r => r.IsPreset).OrderBy(g => g.Key))
                {
                    <MudText Typo="Typo.overline" Color="Color.Secondary">@(group.Key ? "Preset views" : "My views")</MudText>
                    <MudList T="string" Dense="true" Class="pa-0" aria-label="@(group.Key ? "Preset views" : "My views")">
                        @foreach (var r in group)
                        {
                            <MudListItem T="string" OnClick="() => LoadViewAsync(r)" Text="@r.Name" Icon="@Icons.Material.Filled.ShowChart" />
                        }
                    </MudList>
                }
            </MudExpansionPanel>
            <MudExpansionPanel Text="Datasets and columns" Expanded="true">
                @if (_schema is not null)
                {
                    @foreach (var d in _schema.Datasets)
                    {
                        <MudText Typo="Typo.subtitle2">
                            <MudLink OnClick="() => Insert(d.Name)">@d.Name</MudLink>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">@d.Description</MudText>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var c in d.Columns)
                            {
                                <MudTooltip Text="@($"{c.Type}: {c.Description}")">
                                    <MudChip T="string" Size="Size.Small" OnClick="() => Insert(c.Name)">@c.Name</MudChip>
                                </MudTooltip>
                            }
                        </div>
                    }
                }
            </MudExpansionPanel>
            <MudExpansionPanel Text="Language cheat sheet">
                <pre class="fl-cheat">@CheatSheet</pre>
                @if (_schema is not null)
                {
                    <MudText Typo="Typo.overline" Class="mt-2">Aggregates</MudText>
                    <MudText Typo="Typo.caption">@string.Join(", ", _schema.Aggregates)</MudText>
                    <MudText Typo="Typo.overline" Class="mt-2">Functions</MudText>
                    <MudText Typo="Typo.caption">@string.Join(", ", _schema.Functions)</MudText>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? ViewId { get; set; }
    [SupplyParameterFromQuery(Name = "report")] public string? ReportId { get; set; }
    [SupplyParameterFromQuery(Name = "panel")] public int? PanelIndex { get; set; }

    private static readonly Dictionary<string, string> Kinds = new()
    {
        ["table"] = "Table", ["column"] = "Column", ["bar"] = "Bar", ["line"] = "Line (multi-trend)", ["area"] = "Area", ["pie"] = "Donut",
    };

    private const string CheatSheet = """
        dataset
        | where cond and cond
        | extend name = expr
        | project a, b, c = expr
        | summarize total = sum(x), n = count()
            by month = month(date), category
        | sort by total desc
        | top 10 by total
        | take 100
        | distinct category
        | count

        Durations: 30d 2w 6mo 1y
        Compare:   == != < <= > >= contains
                   startswith, in (..), between(a, b)
        """;

    private string _query = "transactions\n| where direction == \"Debit\" and date >= ago(90d)\n| summarize total = sum(amount), n = count() by category\n| sort by total desc\n| take 12";
    private QueryResult? _result;
    private QuerySchemaDto? _schema;
    private List<SavedReportDto> _reports = [];
    private string? _error;
    private string? _queryError;
    private bool _running;
    private string _kind = "table";
    private string? _x;
    private IReadOnlyCollection<string> _y = [];
    private string? _seriesBy;
    private bool _stacked;
    private string? _loadedTitle;
    private SavedReportDto? _loadedView;
    private string? _handledKey;
    private ElementReference _editorHost;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private bool _editorStarting;
    private DotNetObjectReference<QueryPage>? _self;

    private bool EditingView => _loadedView is { IsPreset: false, Kind: "View" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _schema = await ApiClient.GetQuerySchemaAsync();
            _reports = await ApiClient.GetReportsAsync();
        }
        catch (ApiClientException ex)
        {
            _error = SnackbarExtensions.ProblemText(ex);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The schema arrives asynchronously, so initialise the editor on the first render that has it.
        if (_editor is null && !_editorStarting && _schema is not null)
        {
            _editorStarting = true; // renders can overlap while the module imports; never create two editors
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./query-editor.js");
            _editor = await _module.InvokeAsync<IJSObjectReference>("create", _editorHost, _self, _schema, _query);
        }
    }

    [JSInvokable]
    public void OnQueryChanged(string text) => _query = text;

    [JSInvokable]
    public Task RunRequested(string text) => InvokeAsync(async () =>
    {
        _query = text;
        await RunAsync();
        StateHasChanged(); // raised from JS, so Blazor will not re-render on its own
    });

    private static readonly System.Text.RegularExpressions.Regex Identifier = new("^[A-Za-z_][A-Za-z0-9_]*$");

    /// <summary>Distinct values of a text column, for completion inside string literals.</summary>
    [JSInvokable]
    public async Task<string[]> GetValues(string dataset, string column)
    {
        if (!Identifier.IsMatch(dataset) || !Identifier.IsMatch(column))
        {
            return [];
        }

        try
        {
            var outcome = await ApiClient.RunQueryAsync(
                $"{dataset} | summarize n = count() by {column} | top 40 by n | project {column}");
            return outcome.Result?.Rows
                .Select(r => FlowLedger.Web.Shared.ChartModel.CellText(r[0]))
                .Where(v => v.Length > 0)
                .ToArray() ?? [];
        }
        catch (ApiClientException)
        {
            return [];
        }
    }

    private string _question = string.Empty;
    private bool _asking;
    private string? _askNote;

    private async Task OnAskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_question) && !_asking)
        {
            await AskAsync();
        }
    }

    /// <summary>Plain-English question -> a query written by a LOCAL model, validated server-side, then run in the normal workbench.</summary>
    private async Task AskAsync()
    {
        _asking = true;
        _askNote = null;
        try
        {
            var answer = await ApiClient.AskQueryAsync(_question);
            if (answer.Query is null)
            {
                _askNote = answer.Error ?? "Couldn't answer that.";
                return;
            }

            await SetQueryAsync(answer.Query);
            _askNote = answer.Error
                ?? answer.Note
                ?? "Written by your local AI model from your question. Check the query below, edit it, and save it if useful.";
            await RunAsync();
        }
        catch (ApiClientException ex)
        {
            _askNote = SnackbarExtensions.ProblemText(ex);
        }
        finally
        {
            _asking = false;
        }
    }

    private async Task SetQueryAsync(string text)
    {
        _query = text;
        if (_editor is not null)
        {
            await _editor.InvokeVoidAsync("setValue", text);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_editor is not null)
            {
                await _editor.InvokeVoidAsync("dispose");
                await _editor.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone; nothing to clean up client-side.
        }

        _self?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ViewId}|{ReportId}|{PanelIndex}";
        if (key == "||" || key == _handledKey)
        {
            return;
        }

        _handledKey = key;
        if (ViewId is not null)
        {
            var view = await SafeGetAsync(ViewId);
            if (view is { Panels.Count: > 0 })
            {
                _loadedView = view;
                await LoadPanelAsync(view.Panels[0], view.Name);
            }
        }
        else if (ReportId is not null && PanelIndex is { } i)
        {
            var report = await SafeGetAsync(ReportId);
            if (report is not null && i >= 0 && i < report.Panels.Count)
            {
                _loadedView = null;
                await LoadPanelAsync(report.Panels[i], $"{report.Name} / {report.Panels[i].Title}");
            }
        }
    }

    private async Task<SavedReportDto?> SafeGetAsync(string id)
    {
        try
        {
            return await ApiClient.GetReportAsync(id);
        }
        catch (ApiClientException ex)
        {
            _error = SnackbarExtensions.ProblemText(ex);
            return null;
        }
    }

    private async Task LoadViewAsync(SavedReportDto r)
    {
        _loadedView = r;
        await LoadPanelAsync(r.Panels[0], r.Name);
    }

    private async Task LoadPanelAsync(ReportPanel panel, string title)
    {
        await SetQueryAsync(panel.Query);
        _loadedTitle = title;
        _kind = panel.Viz.Kind;
        _x = panel.Viz.X;
        _y = panel.Viz.Y ?? [];
        _seriesBy = panel.Viz.SeriesBy;
        _stacked = panel.Viz.Stacked;
        await RunCoreAsync(keepViz: true);
    }

    private VizSpec CurrentViz() => new(_kind, _x, _y.ToList(), _seriesBy, _stacked);

    private static readonly string[] DatasetNames = ["transactions", "accounts", "assets"];

    private async Task Insert(string text)
    {
        if (DatasetNames.Contains(text))
        {
            await SetQueryAsync(text);
        }
        else if (_editor is not null)
        {
            await _editor.InvokeVoidAsync("insertAtCaret", text);
        }
        else
        {
            _query = string.IsNullOrWhiteSpace(_query) ? text : _query.TrimEnd() + " " + text;
        }
    }

    private Task RunAsync() => RunCoreAsync(keepViz: false);

    private async Task RunCoreAsync(bool keepViz)
    {
        _running = true;
        _error = null;
        _queryError = null;
        try
        {
            var outcome = await ApiClient.RunQueryAsync(_query);
            if (outcome.Error is not null)
            {
                _result = null;
                if (_editor is not null)
                {
                    await _editor.InvokeVoidAsync("setError", outcome.Position);
                }

                _queryError = outcome.Position > 0 && outcome.Position < _query.Length
                    ? $"{outcome.Error} (near “{Snippet(_query, outcome.Position)}”)"
                    : outcome.Error;
                return;
            }

            _result = outcome.Result;
            if (_editor is not null)
            {
                await _editor.InvokeVoidAsync("setError", -1);
            }

            if (!keepViz)
            {
                AutoViz(_result!);
            }
            else if (!_y.Any())
            {
                _y = DefaultY(_result!);
            }
        }
        catch (ApiClientException ex)
        {
            _error = SnackbarExtensions.ProblemText(ex);
        }
        finally
        {
            _running = false;
        }
    }

    private static string Snippet(string q, int pos)
        => q.Substring(pos, Math.Min(20, q.Length - pos)).Replace('\n', ' ');

    private IReadOnlyCollection<string> DefaultY(QueryResult r)
        => r.Columns.Where(c => c.Type == "number" && c.Name != _x).Take(1).Select(c => c.Name).ToList();

    /// <summary>Picks a sensible default display for a fresh result: time on X becomes a line, small categorical a column.</summary>
    private void AutoViz(QueryResult r)
    {
        _seriesBy = null;
        _stacked = false;
        var xIndex = r.Columns.ToList().FindIndex(c => c.Type != "number");
        if (xIndex < 0)
        {
            xIndex = 0;
        }

        _x = r.Columns.Count > 0 ? r.Columns[xIndex].Name : null;
        _y = DefaultY(r);
        var timeLike = r.Columns.Count > 0 && (r.Columns[xIndex].Type == "date" || (r.Rows.Count > 0
            && System.Text.RegularExpressions.Regex.IsMatch(FlowLedger.Web.Shared.ChartModel.CellText(r.Rows[0][xIndex]), @"^\d{4}-(\d{2}|Q\d)")));
        _kind = !_y.Any() || r.Rows.Count < 2
            ? "table"
            : timeLike ? "line" : r.Rows.Count <= 20 ? "column" : "table";
    }

    private ReportPanel CurrentPanel(string title) => new(title, _query, CurrentViz());

    private async Task SaveViewAsync()
    {
        if (EditingView && _loadedView is not null)
        {
            await PersistAsync(
                new SaveReportRequest(_loadedView.Name, _loadedView.Description, "View", [CurrentPanel(_loadedView.Panels[0].Title)]),
                Guid.Parse(_loadedView.Id), "View updated");
            return;
        }

        // The dialog performs the save itself, so a validation failure shows next to the field and the dialog stays open (#211).
        await ShowSaveDialogAsync(asPanel: false, outcome =>
            SaveAsync(new SaveReportRequest(outcome.Name, outcome.Description, "View", [CurrentPanel(outcome.PanelTitle)]), null, "View saved"));
    }

    private async Task AddToReportAsync()
    {
        await ShowSaveDialogAsync(asPanel: true, outcome =>
        {
            if (outcome.ExistingReportId is { } id)
            {
                var existing = _reports.First(r => r.Id == id);
                var panels = existing.Panels.Append(CurrentPanel(outcome.PanelTitle)).ToList();
                return SaveAsync(new SaveReportRequest(existing.Name, existing.Description, "Report", panels), Guid.Parse(id), "Panel added to report");
            }

            return SaveAsync(new SaveReportRequest(outcome.Name, outcome.Description, "Report", [CurrentPanel(outcome.PanelTitle)]), null, "Report created");
        });
    }

    private async Task ShowSaveDialogAsync(bool asPanel, Func<SaveReportDialog.Outcome, Task> commit)
    {
        var parameters = new DialogParameters<SaveReportDialog>
        {
            { x => x.AsPanel, asPanel },
            { x => x.Reports, _reports },
            { x => x.SuggestedName, _loadedTitle ?? "" },
            { x => x.CommitAsync, commit },
        };
        var dialog = await DialogService.ShowAsync<SaveReportDialog>(asPanel ? "Add to report" : "Save view", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
    }

    /// <summary>Saves and refreshes; failures propagate so the caller (a dialog or <see cref="PersistAsync"/>) decides how to show them.</summary>
    private async Task SaveAsync(SaveReportRequest request, Guid? id, string success)
    {
        var saved = await ApiClient.SaveReportAsync(request, id);
        _reports = await ApiClient.GetReportsAsync();
        if (saved is { Kind: "View" })
        {
            _loadedView = saved;
            _loadedTitle = saved.Name;
        }

        Snackbar.Add(success, Severity.Success);
    }

    private async Task PersistAsync(SaveReportRequest request, Guid? id, string success)
    {
        try
        {
            await SaveAsync(request, id, success);
        }
        catch (ApiClientException ex)
        {
            Snackbar.AddFailure(ex);
        }
    }
}
