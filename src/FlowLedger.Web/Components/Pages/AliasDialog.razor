<MudDialog aria-labelledby="alias-dialog-title">
    <TitleContent>
        <MudText Typo="Typo.h6" id="alias-dialog-title">Rename merchant</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Every transaction whose bank description contains the text below will show the name you choose,
            including future syncs. The original description is kept.
        </MudText>
        <MudTextField @bind-Value="Pattern" Label="Bank description contains" Immediate="true" Class="mb-2"
                      HelperText="Shorten it to match variations, e.g. NANONOBLE" />
        <MudTextField @bind-Value="Alias" Label="Show as" Immediate="true" AutoFocus="true"
                      Placeholder="e.g. MiniMax" OnKeyUp="OnKey" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" aria-label="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save"
                   Disabled="@(string.IsNullOrWhiteSpace(Pattern) || string.IsNullOrWhiteSpace(Alias))"
                   aria-label="Save alias">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Pattern { get; set; } = "";
    [Parameter] public string Alias { get; set; } = "";

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok((Pattern.Trim(), Alias.Trim())));

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(Pattern) && !string.IsNullOrWhiteSpace(Alias))
        {
            Save();
        }
    }
}
