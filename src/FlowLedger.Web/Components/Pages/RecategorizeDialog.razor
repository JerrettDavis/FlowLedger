<MudDialog aria-labelledby="recat-dialog-title">
    <TitleContent>
        <MudText Typo="Typo.h6" id="recat-dialog-title">Change category</MudText>
    </TitleContent>
    <DialogContent>
        <div class="fl-txsummary">
            <div style="min-width:0">
                <div class="fl-txsummary-name" title="@Merchant">@Merchant</div>
                <div class="fl-txsummary-meta">@(Date is { } d ? Format.FullDate(d) : "")</div>
            </div>
            <div class="d-flex flex-column align-end" style="gap:4px;flex:none">
                @if (Amount is { } amt) { <span class="fl-num" style="font-weight:600">@Format.Money(amt)</span> }
                <CategoryChip Path="@CurrentCategory" />
            </div>
        </div>

        <MudAutocomplete T="CategoryDto" Label="Move to" @bind-Value="_selected" SearchFunc="SearchAsync"
                         ToStringFunc="@(c => c?.Path ?? "")" AutoFocus="true" OpenOnFocus="false" CoerceText="false" ResetValueOnEmptyText="true"
                         Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" MaxItems="40"
                         Placeholder="Search, or type a new category" OpenIcon="@Icons.Material.Filled.Search"
                         HelperText="@(IsNew ? "This category doesn't exist yet. It will be created." : "Use Parent/Child to make a sub-category.")"
                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Folder" AdornmentColor="Color.Default">
            <ItemTemplate Context="c">
                @if (c.Id == Guid.Empty)
                {
                    <div class="fl-option fl-option-new"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />Create “@c.Path”</div>
                }
                else
                {
                    <div class="fl-option"><span class="fl-catchip-dot" style="--fl-cat:@CategoryColors.For(c.Path)"></span>@c.Path</div>
                }
            </ItemTemplate>
        </MudAutocomplete>

        <div class="fl-scope" role="radiogroup" aria-label="Apply to">
            <button type="button" class="fl-scope-card" role="radio" aria-checked="@(!_applyToAll ? "true" : "false")" @onclick="() => _applyToAll = false">
                <span class="fl-scope-radio"></span>
                <span>
                    <div class="fl-scope-title">Just this transaction</div>
                    <div class="fl-scope-desc">Nothing else changes.</div>
                </span>
            </button>
            <button type="button" class="fl-scope-card" role="radio" aria-checked="@(_applyToAll ? "true" : "false")" @onclick="() => _applyToAll = true">
                <span class="fl-scope-radio"></span>
                <span>
                    <div class="fl-scope-title">All transactions from “@Merchant”</div>
                    <div class="fl-scope-desc">
                        @(MatchCount > 1 ? $"{MatchCount} in this view, plus any others and future syncs." : "Includes past ones and future syncs.")
                        Overrides categories you set earlier for this merchant.
                    </div>
                </span>
            </button>
        </div>

        <MudTextField @bind-Value="_note" Label="Note (optional)" Lines="2" MaxLength="1000" Class="mt-3"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="e.g. Split with Sam, reimbursable" aria-label="Note" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(_selected is null)"
                   aria-label="Apply category">@(_applyToAll ? "Move all matching" : "Move transaction")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Merchant { get; set; } = "";
    [Parameter] public string CurrentCategory { get; set; } = "Uncategorized";
    [Parameter] public decimal? Amount { get; set; }
    [Parameter] public DateOnly? Date { get; set; }
    [Parameter] public int MatchCount { get; set; }
    [Parameter] public List<CategoryDto> Categories { get; set; } = [];

    private CategoryDto? _selected;
    private bool _applyToAll;
    private string? _note;

    private bool IsNew => _selected is { Id: var id } && id == Guid.Empty;

    protected override void OnInitialized() =>
        _selected = Categories.FirstOrDefault(c => string.Equals(c.Path, CurrentCategory, StringComparison.OrdinalIgnoreCase));

    private Task<IEnumerable<CategoryDto>> SearchAsync(string? text, CancellationToken ct)
    {
        var matches = Categories
            .Where(c => string.IsNullOrWhiteSpace(text) || c.Path.Contains(text, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.Path).Take(50).ToList();
        var typed = (text ?? "").Trim().Trim('/');
        if (typed.Length is > 0 and <= 200 && !Categories.Any(c => string.Equals(c.Path, typed, StringComparison.OrdinalIgnoreCase)))
        {
            // Id.Empty marks a category that doesn't exist yet; the page creates it before recategorizing.
            matches.Insert(0, new CategoryDto(Guid.Empty, typed, typed.Split('/').Last(), false, null));
        }

        return Task.FromResult<IEnumerable<CategoryDto>>(matches);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok((_selected!.Id, _selected.Path, _applyToAll, string.IsNullOrWhiteSpace(_note) ? null : _note.Trim())));
}
