@page "/transactions"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILogger<Transactions> Logger
@inject IJSRuntime JS
@inject IDialogService Dialogs

<PageTitle>Transactions — FlowLedger</PageTitle>

<div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h4" HtmlTag="h1" tabindex="-1">Transactions</MudText>
    <div class="d-flex align-center gap-2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="AutoCategorize" Disabled="_categorizing"
                   aria-label="Auto-categorize transactions">
            @(_categorizing ? "Categorizing…" : "Auto-categorize")
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" OnClick="OpenImport"
                   aria-label="Import transactions from another app or bank">
            Import
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsv"
                   aria-label="Export visible transactions as CSV">
            Export CSV
        </MudButton>
    </div>
</div>

<!-- Filter bar -->
<MudPaper Elevation="0" Class="pa-3 mb-4" Style="border: 1px solid var(--mud-palette-divider);">
    <MudGrid>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Date="_fromDate" DateChanged="OnFromChanged" Label="From" Clearable="true"
                           aria-label="Filter from date" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Date="_toDate" DateChanged="OnToChanged" Label="To" Clearable="true"
                           aria-label="Filter to date" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="Guid?" Value="_filterAccountId" ValueChanged="OnAccountChanged" Label="Account" Clearable="true"
                       aria-label="Filter by account">
                @foreach (var a in _accounts)
                {
                    <MudSelectItem Value="@((Guid?)a.Id)">@a.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="8" md="6">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Immediate="true" DebounceInterval="300" Label="Search description or merchant" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          aria-label="Search transactions" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3" Class="d-flex align-center">
            <MudCheckBox T="bool" Value="_includeHidden" ValueChanged="OnIncludeHiddenChanged" Label="Include hidden accounts" Dense="true"
                         aria-label="Include hidden accounts" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3" Class="d-flex align-center">
            <MudCheckBox T="bool" @bind-Value="_applyToMerchant" Label="Apply category changes to same merchant" Dense="true" />
        </MudItem>
        <MudItem xs="12" sm="12" md="3" Class="d-flex align-end">
            <MudButton StartIcon="@Icons.Material.Filled.Search"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="LoadAsync"
                       FullWidth="true"
                       aria-label="Reload transactions">
                Reload
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <CardSkeleton />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (!_loading && _transactions.Count == 0 && _error is null)
{
    <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong"
                Title="No transactions"
                Description="No transactions match these filters yet.">
        <Action>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearFilters">
                Clear filters
            </MudButton>
        </Action>
    </EmptyState>
}

<MudDataGrid T="FlowLedger.Contracts.TransactionDto"
             Items="Visible"
             Filterable="true"
             FilterMode="DataGridFilterMode.ColumnFilterRow"
             SortMode="SortMode.Multiple"
             Hover="true"
             Striped="false"
             Dense="true"
             Virtualize="false"
             RowsPerPage="50"
             aria-label="Transactions table">
    <ToolBarContent>
        <MudText Typo="Typo.body2" Class="ml-auto mud-text-secondary" role="status">@_transactions.Count transaction(s) loaded@(_hasMore ? ", newest first" : "")</MudText>
    </ToolBarContent>
    <Columns>
        <TemplateColumn Title="Date" Sortable="true" SortBy="x => x.EffectiveDate">
            <CellTemplate>
                <MudText Typo="Typo.body2">@Format.DayMonth(context.Item.EffectiveDate)</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Merchant" Sortable="true" SortBy="x => string.IsNullOrWhiteSpace(x.MerchantName) ? x.SuggestedName : x.MerchantName">
            <CellTemplate>
                @{
                    var row = context.Item;
                    var display = string.IsNullOrWhiteSpace(row.MerchantName) ? row.SuggestedName : row.MerchantName;
                    var showDesc = !string.IsNullOrWhiteSpace(row.Description);
                    _accountById.TryGetValue(row.AccountId, out var rowAcct);
                }
                <div class="fl-merch fl-cell-truncate">
                    <div class="fl-merch-text">
                        <div class="fl-merch-name" title="@display">@(string.IsNullOrWhiteSpace(display) ? row.Description : display)</div>
                        @if (showDesc)
                        {
                            <div class="fl-merch-desc fl-md-only" title="@row.Description">@row.Description</div>
                        }
                        @if (rowAcct is not null)
                        {
                            <div class="fl-merch-desc fl-md-only" title="@rowAcct.Name">@rowAcct.Name</div>
                        }
                        @if (row.Tags is { Count: > 0 })
                        {
                            <div class="fl-merch-tags">
                                @foreach (var tag in row.Tags)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="my-0">@tag</MudChip>
                                }
                            </div>
                        }
                    </div>
                    <div class="fl-merch-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditAlias(row))"
                                       aria-label="@($"Rename merchant for {row.Description}")" title="Rename merchant" />
                        <MudIconButton Icon="@(string.IsNullOrWhiteSpace(row.Notes) ? Icons.Material.Outlined.NoteAdd : Icons.Material.Filled.StickyNote2)" Size="Size.Small"
                                       Color="@(string.IsNullOrWhiteSpace(row.Notes) ? Color.Default : Color.Primary)"
                                       OnClick="@(() => EditNote(row))"
                                       aria-label="@($"Note for {row.Description}")" title="@(string.IsNullOrWhiteSpace(row.Notes) ? "Add a note" : row.Notes)" />
                        <MudIconButton Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small"
                                       Color="@(row.Splits is { Count: > 0 } ? Color.Primary : Color.Default)"
                                       OnClick="@(() => EditSplits(row))"
                                       aria-label="@($"Split {row.Description} across categories")" title="@(row.Splits is { Count: > 0 } ? "Edit split" : "Split across categories")" />
                    </div>
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Description" Sortable="true" SortBy="x => x.Description" HeaderClass="fl-hide-md" CellClass="fl-hide-md">
            <CellTemplate>
                <span class="fl-cell-truncate fl-desc-cell" title="@context.Item.Description">@context.Item.Description</span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Amount" Sortable="true" SortBy="x => x.Amount">
            <CellTemplate>
                <MudText Class="fl-num" Color="@Format.Delta(context.Item.Direction == "Credit" ? context.Item.Amount : -context.Item.Amount)">
                    @Format.Signed(context.Item.Amount, context.Item.Direction == "Credit")
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" HeaderClass="fl-hide-lg" CellClass="fl-hide-lg">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)" Variant="Variant.Text">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Category" Sortable="false">
            <CellTemplate>
                @{
                    var cat = context.Item.CategoryId is { } catId && _categoryById.TryGetValue(catId, out var foundCat) ? foundCat : null;
                    var item = context.Item;
                }
                <MudMenu Dense="true" Label="@(cat?.DisplayName ?? "Uncategorized")" Variant="Variant.Text" Size="Size.Small"
                         Color="@(cat is null ? Color.Default : Color.Primary)" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         aria-label="@($"Change category for {item.Description}")">
                    @foreach (var c in _sortedCategories)
                    {
                        var target = c;
                        <MudMenuItem OnClick="@(() => SetCategory(item, target))">@target.Path</MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Account" Sortable="false" HeaderClass="fl-hide-md" CellClass="fl-hide-md">
            <CellTemplate>
                @{
                    _accountById.TryGetValue(context.Item.AccountId, out var acct);
                }
                <span class="fl-cell-clip" title="@(acct?.Name)">@(acct?.Name ?? "–")</span>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="FlowLedger.Contracts.TransactionDto" aria-label="Transactions pager" />
    </PagerContent>
</MudDataGrid>

@if (_hasMore && !_loading)
{
    <div class="d-flex justify-center mt-3">
        <MudButton Variant="Variant.Outlined" OnClick="LoadMoreAsync" aria-label="Load older transactions">Load older transactions</MudButton>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;

    private List<FlowLedger.Contracts.TransactionDto> _transactions = [];
    private List<FlowLedger.Contracts.AccountDto> _accounts = [];
    private List<FlowLedger.Contracts.CategoryDto> _categories = [];

    private DateTime? _fromDate;
    private DateTime? _toDate;
    private Guid? _filterAccountId;
    private bool _includeHidden;
    private string? _search;
    private bool _applyToMerchant;
    private bool _categorizing;
    private const int PageSize = 500;
    private bool _hasMore;
    private int _loadSeq;

    private List<FlowLedger.Contracts.TransactionDto> _visible = [];
    private Dictionary<Guid, FlowLedger.Contracts.CategoryDto> _categoryById = [];
    private List<FlowLedger.Contracts.CategoryDto> _sortedCategories = [];
    private Dictionary<Guid, FlowLedger.Contracts.AccountDto> _accountById = [];

    private List<FlowLedger.Contracts.TransactionDto> Visible => _visible;

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return LoadAsync();
    }

    private void RecomputeVisible() => _visible = _transactions;

    private void RebuildLookups()
    {
        _categoryById = _categories.GroupBy(c => c.Id).ToDictionary(g => g.Key, g => g.First());
        _sortedCategories = _categories.OrderBy(c => c.Path).ToList();
        _accountById = _accounts.GroupBy(a => a.Id).ToDictionary(g => g.Key, g => g.First());
    }

    /// <summary>Replaces one row in place and refreshes the cached view (avoids a full reload for single-row edits).</summary>
    private void PatchRow(Guid id, Func<FlowLedger.Contracts.TransactionDto, FlowLedger.Contracts.TransactionDto> patch)
    {
        var i = _transactions.FindIndex(t => t.Id == id);
        if (i >= 0)
        {
            _transactions[i] = patch(_transactions[i]);
            RecomputeVisible();
        }
    }

    /// <summary>Deep link from the dashboard account strip: /transactions?account={id}.</summary>
    [SupplyParameterFromQuery(Name = "account")] public Guid? AccountQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await ApiClient.GetAccountsAsync();
            _categories = await ApiClient.GetCategoriesAsync();
            RebuildLookups();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load accounts or categories for transaction filters");
            Snackbar.Add("Couldn't load account and category filters — some dropdowns may be empty.", Severity.Warning);
        }
        _filterAccountId ??= AccountQuery;
        await LoadAsync();
    }

    private Task LoadAsync() => LoadPageAsync(append: false);

    private Task LoadMoreAsync() => LoadPageAsync(append: true);

    /// <summary>Loads one page from the server (filters and search are applied there); append adds the next older page.</summary>
    private async Task LoadPageAsync(bool append)
    {
        var seq = ++_loadSeq;
        _loading = true;
        _error = null;
        try
        {
            var from = _fromDate.HasValue ? DateOnly.FromDateTime(_fromDate.Value) : (DateOnly?)null;
            var to = _toDate.HasValue ? DateOnly.FromDateTime(_toDate.Value) : (DateOnly?)null;

            var page = await ApiClient.GetTransactionsAsync(
                accountId: _filterAccountId,
                from: from,
                to: to,
                skip: append ? _transactions.Count : 0,
                take: PageSize,
                includeHidden: _includeHidden,
                search: _search);
            if (seq != _loadSeq)
            {
                return; // a newer filter or search superseded this response
            }

            _transactions = append ? [.. _transactions, .. page] : page;
            _hasMore = page.Count >= PageSize;
            RecomputeVisible();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load transactions");
            if (seq == _loadSeq)
            {
                _error = SnackbarExtensions.ProblemText(ex, "Failed to load transactions. Please try again.");
            }
        }
        finally
        {
            if (seq == _loadSeq)
            {
                _loading = false;
            }
        }
    }

    // Filters apply as soon as they change (one reload each), no separate Filter press needed.
    private Task OnFromChanged(DateTime? value) { _fromDate = value; return LoadAsync(); }

    private Task OnToChanged(DateTime? value) { _toDate = value; return LoadAsync(); }

    private Task OnAccountChanged(Guid? value) { _filterAccountId = value; return LoadAsync(); }

    private Task OnIncludeHiddenChanged(bool value) { _includeHidden = value; return LoadAsync(); }

    private async Task SetCategory(FlowLedger.Contracts.TransactionDto tx, FlowLedger.Contracts.CategoryDto category)
    {
        try
        {
            var applyToMerchant = _applyToMerchant;
            var others = applyToMerchant ? MerchantMatch.CountOthers(_transactions, tx) : 0;
            if (others > 0)
            {
                // Bulk recategorisation must be explicit: say how many rows it touches and let the user narrow it.
                var choice = await Dialogs.ShowMessageBoxAsync(
                    "Apply to the same merchant?",
                    $"Set {others} other loaded transaction{(others == 1 ? "" : "s")} from {MerchantMatch.Key(tx)} to {category.Path} as well? " +
                    "Rows outside the current list may also match.",
                    yesText: $"Apply to {others + 1}", noText: "Only this one", cancelText: "Cancel");
                if (choice is null)
                {
                    return;
                }

                applyToMerchant = choice == true;
            }

            // Send the version the user last saw (If-Match); a 409 means the row changed elsewhere (another tab or a sync).
            uint? savedVersion = null;
            var changed = await ApiClient.SetTransactionCategoryAsync(
                tx.Id, category.Id, applyToMerchant, expectedVersion: tx.Version == 0 ? null : tx.Version, newVersion: v => savedVersion = v);
            Snackbar.Add(changed > 1 ? $"Set {changed} transactions to {category.Path}" : $"Set to {category.Path}", Severity.Success);
            if (changed > 1)
            {
                await LoadAsync();
            }
            else
            {
                PatchRow(tx.Id, t => t with { CategoryId = category.Id, Version = savedVersion ?? t.Version });
            }
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
            if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
            {
                await LoadAsync(); // pick up the current versions
            }
        }
    }

    private async Task OpenImport()
    {
        var dialog = await Dialogs.ShowAsync<ImportTransactionsDialog>("Import transactions", new DialogParameters<ImportTransactionsDialog>
        {
            { x => x.Accounts, _accounts },
        }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task EditAlias(FlowLedger.Contracts.TransactionDto tx)
    {
        var dialog = await Dialogs.ShowAsync<AliasDialog>("Rename merchant", new DialogParameters<AliasDialog>
        {
            { x => x.Pattern, tx.Description },
            { x => x.Alias, tx.MerchantName ?? "" },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ValueTuple<string, string> (var pattern, var alias))
        {
            return;
        }

        try
        {
            var changed = await ApiClient.SetMerchantAliasAsync(pattern, alias);
            Snackbar.Add($"Renamed {changed} transaction(s) to {alias}", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
        }
    }

    private async Task EditNote(FlowLedger.Contracts.TransactionDto tx)
    {
        var dialog = await Dialogs.ShowAsync<NoteDialog>("Transaction note", new DialogParameters<NoteDialog>
        {
            { x => x.Description, tx.Description },
            { x => x.Note, tx.Notes ?? "" },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string note)
        {
            return;
        }

        try
        {
            uint? savedVersion = null;
            await ApiClient.SetTransactionNoteAsync(tx.Id, note, expectedVersion: tx.Version == 0 ? null : tx.Version, newVersion: v => savedVersion = v);
            Snackbar.Add(note.Length == 0 ? "Note removed" : "Note saved", Severity.Success);
            PatchRow(tx.Id, t => t with { Notes = note.Length == 0 ? null : note, Version = savedVersion ?? t.Version });
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
            if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
            {
                await LoadAsync(); // pick up the current versions
            }
        }
    }

    private async Task EditSplits(FlowLedger.Contracts.TransactionDto tx)
    {
        var dialog = await Dialogs.ShowAsync<SplitDialog>("Split transaction", new DialogParameters<SplitDialog>
        {
            { x => x.Description, tx.Description },
            { x => x.Total, tx.Amount },
            { x => x.CurrentCategoryId, tx.CategoryId },
            { x => x.Existing, tx.Splits },
            { x => x.Categories, _categories },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<FlowLedger.Contracts.TransactionSplitDto> splits)
        {
            return;
        }

        try
        {
            uint? savedVersion = null;
            await ApiClient.SetTransactionSplitsAsync(tx.Id, splits, expectedVersion: tx.Version == 0 ? null : tx.Version, newVersion: v => savedVersion = v);
            Snackbar.Add(splits.Count == 0 ? "Split removed" : "Split saved", Severity.Success);
            PatchRow(tx.Id, t => t with { Splits = splits.Count == 0 ? null : splits, Version = savedVersion ?? t.Version });
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
            if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
            {
                await LoadAsync(); // pick up the current versions
            }
        }
    }

    private async Task AutoCategorize()
    {
        _categorizing = true;
        try
        {
            var r = await ApiClient.RunCategorizationAsync();
            Snackbar.Add(r is null ? "Done" : $"Categorized {r.Categorized} ({r.Transfers} transfers, {r.ByModel} by the learned model); {r.Suggested} suggestions and {r.StillUncategorized} left for you to review", Severity.Success);
            _categories = await ApiClient.GetCategoriesAsync();
            RebuildLookups();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
        }
        finally
        {
            _categorizing = false;
        }
    }

    private static string Csv(string? v) => "\"" + (v ?? "").Replace("\"", "\"\"") + "\"";

    private async Task ExportCsv()
    {
        var sb = new System.Text.StringBuilder("date,description,merchant,amount,direction,status,category,account\n");
        foreach (var t in Visible)
        {
            var cat = t.CategoryId is { } cid && _categoryById.TryGetValue(cid, out var c) ? c.Path : null;
            var acct = _accountById.TryGetValue(t.AccountId, out var a) ? a.Name : null;
            var signed = t.Direction == "Credit" ? t.Amount : -t.Amount;
            sb.Append(t.EffectiveDate.ToString("yyyy-MM-dd")).Append(',').Append(Csv(t.Description)).Append(',').Append(Csv(t.MerchantName))
              .Append(',').Append(signed.ToString(System.Globalization.CultureInfo.InvariantCulture)).Append(',').Append(t.Direction)
              .Append(',').Append(t.Status).Append(',').Append(Csv(cat)).Append(',').Append(Csv(acct)).Append('\n');
        }

        var bytes = new System.Text.UTF8Encoding(true).GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        using var ms = new MemoryStream(bytes);
        using var reference = new DotNetStreamReference(ms);
        await JS.InvokeVoidAsync("flowledgerDownload", $"transactions-{DateTime.Now:yyyyMMdd-HHmm}.csv", reference);
    }

    private void ClearFilters()
    {
        _fromDate = null;
        _toDate = null;
        _filterAccountId = null;
        _ = LoadAsync();
    }

    private static Color StatusColor(string status) => status switch
    {
        "Posted" => Color.Success,
        "Pending" => Color.Warning,
        "Matched" => Color.Info,
        "Reconciled" => Color.Primary,
        "NeedsReview" => Color.Error,
        _ => Color.Default
    };
}
