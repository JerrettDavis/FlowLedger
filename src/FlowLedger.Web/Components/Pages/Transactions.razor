    private async Task ShowDetails(FlowLedger.Contracts.TransactionDto tx)
    {
        var category = tx.CategoryId is { } id && _categoryById.TryGetValue(id, out var c) ? c.Path : null;
        var dialog = await Dialogs.ShowAsync<TransactionDetailsDialog>("Transaction details", new DialogParameters<TransactionDetailsDialog>
        {
            { x => x.Transaction, tx },
            { x => x.AccountName, _accountById.TryGetValue(tx.AccountId, out var a) ? a.Name : null },
            { x => x.CategoryName, category },
        }, new DialogOptions { Position = DialogPosition.CenterRight, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        switch (result?.Data as string)
        {
            case TransactionDetailsDialog.Rename: await EditAlias(tx); break;
            case TransactionDetailsDialog.Note: await EditNote(tx); break;
            case TransactionDetailsDialog.Split: await EditSplits(tx); break;
        }
    }

