@page "/transactions"
@rendermode InteractiveServer
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILogger<Transactions> Logger
@inject IJSRuntime JS
@inject IDialogService Dialogs

<PageTitle>Transactions — FlowLedger</PageTitle>

<div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h4">Transactions</MudText>
    <div class="d-flex align-center gap-2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="AutoCategorize" Disabled="_categorizing"
                   aria-label="Auto-categorize transactions">
            @(_categorizing ? "Categorizing…" : "Auto-categorize")
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsv"
                   aria-label="Export visible transactions as CSV">
            Export CSV
        </MudButton>
    </div>
</div>

<!-- Filter bar -->
<MudPaper Elevation="0" Class="pa-3 mb-4" Style="border: 1px solid var(--mud-palette-divider);">
    <MudGrid>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker @bind-Date="_fromDate" Label="From" Clearable="true"
                           aria-label="Filter from date" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker @bind-Date="_toDate" Label="To" Clearable="true"
                           aria-label="Filter to date" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect @bind-Value="_filterAccountId" Label="Account" Clearable="true"
                       aria-label="Filter by account">
                @foreach (var a in _accounts)
                {
                    <MudSelectItem Value="@((Guid?)a.Id)">@a.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="8" md="6">
            <MudTextField @bind-Value="_search" Immediate="true" Label="Search description or merchant" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          aria-label="Search transactions" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3" Class="d-flex align-center">
            <MudCheckBox T="bool" @bind-Value="_applyToMerchant" Label="Apply category changes to same merchant" Dense="true" />
        </MudItem>
        <MudItem xs="12" sm="12" md="3" Class="d-flex align-end">
            <MudButton StartIcon="@Icons.Material.Filled.Search"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="LoadAsync"
                       FullWidth="true"
                       aria-label="Apply filters">
                Filter
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <CardSkeleton />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (!_loading && _transactions.Count == 0 && _error is null)
{
    <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong"
                Title="No transactions"
                Description="No transactions match these filters yet.">
        <Action>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearFilters">
                Clear filters
            </MudButton>
        </Action>
    </EmptyState>
}

<MudDataGrid T="FlowLedger.Web.ApiClient.TransactionDto"
             DragDropColumnReordering="true"
             Items="Visible"
             Filterable="true"
             FilterMode="DataGridFilterMode.ColumnFilterRow"
             SortMode="SortMode.Multiple"
             Hover="true"
             Striped="false"
             Dense="true"
             Virtualize="false"
             RowsPerPage="50"
             aria-label="Transactions table">
    <ToolBarContent>
        <MudText Typo="Typo.body2" Class="ml-auto mud-text-secondary">@Visible.Count of @_transactions.Count transaction(s)@(_transactions.Count >= TakeLimit ? $" (showing the newest {TakeLimit}; narrow the dates to see older ones)" : "")</MudText>
    </ToolBarContent>
    <Columns>
        <TemplateColumn Title="Date" Sortable="true" SortBy="x => x.EffectiveDate">
            <CellTemplate>
                <MudText Typo="Typo.body2">@Format.DayMonth(context.Item.EffectiveDate)</MudText>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Description" Title="Description" Sortable="true" />
        <TemplateColumn Title="Merchant" Sortable="true" SortBy="x => x.MerchantName">
            <CellTemplate>
                @{ var row = context.Item; }
                <div class="d-flex align-center">
                    <div>
                        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(row.MerchantName) ? row.SuggestedName : row.MerchantName)</MudText>
                        @if (row.Tags is { Count: > 0 })
                        {
                            @foreach (var tag in row.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="my-0">@tag</MudChip>
                            }
                        }
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Edge="Edge.End"
                                   OnClick="@(() => EditAlias(row))"
                                   aria-label="@($"Rename merchant for {row.Description}")" title="Rename merchant" />
                    <MudIconButton Icon="@(string.IsNullOrWhiteSpace(row.Notes) ? Icons.Material.Outlined.NoteAdd : Icons.Material.Filled.StickyNote2)" Size="Size.Small"
                                   Color="@(string.IsNullOrWhiteSpace(row.Notes) ? Color.Default : Color.Primary)"
                                   OnClick="@(() => EditNote(row))"
                                   aria-label="@($"Note for {row.Description}")" title="@(string.IsNullOrWhiteSpace(row.Notes) ? "Add a note" : row.Notes)" />
                    <MudIconButton Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small"
                                   Color="@(row.Splits is { Count: > 0 } ? Color.Primary : Color.Default)"
                                   OnClick="@(() => EditSplits(row))"
                                   aria-label="@($"Split {row.Description} across categories")" title="@(row.Splits is { Count: > 0 } ? "Edit split" : "Split across categories")" />
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Amount" Sortable="true" SortBy="x => x.Amount">
            <CellTemplate>
                <MudText Class="fl-num" Color="@Format.Delta(context.Item.Direction == "Credit" ? context.Item.Amount : -context.Item.Amount)">
                    @Format.Signed(context.Item.Amount, context.Item.Direction == "Credit")
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)" Variant="Variant.Text">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Category" Sortable="false">
            <CellTemplate>
                @{
                    var cat = context.Item.CategoryId.HasValue ? _categories.FirstOrDefault(c => c.Id == context.Item.CategoryId) : null;
                    var item = context.Item;
                }
                <MudMenu Dense="true" Label="@(cat?.DisplayName ?? "Uncategorized")" Variant="Variant.Text" Size="Size.Small"
                         Color="@(cat is null ? Color.Default : Color.Primary)" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         aria-label="@($"Change category for {item.Description}")">
                    @foreach (var c in _categories.OrderBy(c => c.Path))
                    {
                        var target = c;
                        <MudMenuItem OnClick="@(() => SetCategory(item, target))">@target.Path</MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Account" Sortable="false">
            <CellTemplate>
                @{
                    var acct = _accounts.FirstOrDefault(a => a.Id == context.Item.AccountId);
                }
                <MudText Typo="Typo.body2">@(acct?.Name ?? "–")</MudText>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="FlowLedger.Web.ApiClient.TransactionDto" aria-label="Transactions pager" />
    </PagerContent>
</MudDataGrid>

@code {
    private bool _loading = true;
    private string? _error;

    private List<FlowLedger.Web.ApiClient.TransactionDto> _transactions = [];
    private List<FlowLedger.Web.ApiClient.AccountDto> _accounts = [];
    private List<FlowLedger.Web.ApiClient.CategoryDto> _categories = [];

    private DateTime? _fromDate;
    private DateTime? _toDate;
    private Guid? _filterAccountId;
    private string? _search;
    private bool _applyToMerchant = true;
    private bool _categorizing;
    private const int TakeLimit = 5000;

    private List<FlowLedger.Web.ApiClient.TransactionDto> Visible =>
        string.IsNullOrWhiteSpace(_search)
            ? _transactions
            : _transactions.Where(t =>
                t.Description.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (t.MerchantName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    /// <summary>Deep link from the dashboard account strip: /transactions?account={id}.</summary>
    [SupplyParameterFromQuery(Name = "account")] public Guid? AccountQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await ApiClient.GetAccountsAsync();
            _categories = await ApiClient.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load accounts or categories for transaction filters");
            Snackbar.Add("Couldn't load account and category filters — some dropdowns may be empty.", Severity.Warning);
        }
        _filterAccountId ??= AccountQuery;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var from = _fromDate.HasValue ? DateOnly.FromDateTime(_fromDate.Value) : (DateOnly?)null;
            var to = _toDate.HasValue ? DateOnly.FromDateTime(_toDate.Value) : (DateOnly?)null;

            _transactions = await ApiClient.GetTransactionsAsync(
                accountId: _filterAccountId,
                from: from,
                to: to,
                take: TakeLimit);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load transactions");
            _error = ex is FlowLedger.Web.ApiClient.ApiClientException ace
                ? ace.Message
                : "Failed to load transactions. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetCategory(FlowLedger.Web.ApiClient.TransactionDto tx, FlowLedger.Web.ApiClient.CategoryDto category)
    {
        try
        {
            var changed = await ApiClient.SetTransactionCategoryAsync(tx.Id, category.Id, _applyToMerchant);
            Snackbar.Add(changed > 1 ? $"Set {changed} transactions to {category.Path}" : $"Set to {category.Path}", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task EditAlias(FlowLedger.Web.ApiClient.TransactionDto tx)
    {
        var dialog = await Dialogs.ShowAsync<AliasDialog>("Rename merchant", new DialogParameters<AliasDialog>
        {
            { x => x.Pattern, tx.Description },
            { x => x.Alias, tx.MerchantName ?? "" },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ValueTuple<string, string> (var pattern, var alias))
        {
            return;
        }

        try
        {
            var changed = await ApiClient.SetMerchantAliasAsync(pattern, alias);
            Snackbar.Add($"Renamed {changed} transaction(s) to {alias}", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task EditNote(FlowLedger.Web.ApiClient.TransactionDto tx)
    {
        var dialog = await Dialogs.ShowAsync<NoteDialog>("Transaction note", new DialogParameters<NoteDialog>
        {
            { x => x.Description, tx.Description },
            { x => x.Note, tx.Notes ?? "" },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string note)
        {
            return;
        }

        try
        {
            await ApiClient.SetTransactionNoteAsync(tx.Id, note);
            Snackbar.Add(note.Length == 0 ? "Note removed" : "Note saved", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task EditSplits(FlowLedger.Web.ApiClient.TransactionDto tx)
    {
        var dialog = await Dialogs.ShowAsync<SplitDialog>("Split transaction", new DialogParameters<SplitDialog>
        {
            { x => x.Description, tx.Description },
            { x => x.Total, tx.Amount },
            { x => x.CurrentCategoryId, tx.CategoryId },
            { x => x.Existing, tx.Splits },
            { x => x.Categories, _categories },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<FlowLedger.Web.ApiClient.TransactionSplitDto> splits)
        {
            return;
        }

        try
        {
            await ApiClient.SetTransactionSplitsAsync(tx.Id, splits);
            Snackbar.Add(splits.Count == 0 ? "Split removed" : "Split saved", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AutoCategorize()
    {
        _categorizing = true;
        try
        {
            var r = await ApiClient.RunCategorizationAsync();
            Snackbar.Add(r is null ? "Done" : $"Categorized {r.Categorized} ({r.Transfers} transfers); {r.StillUncategorized} left for you to review", Severity.Success);
            _categories = await ApiClient.GetCategoriesAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _categorizing = false;
        }
    }

    private static string Csv(string? v) => "\"" + (v ?? "").Replace("\"", "\"\"") + "\"";

    private async Task ExportCsv()
    {
        var sb = new System.Text.StringBuilder("date,description,merchant,amount,direction,status,category,account\n");
        foreach (var t in Visible)
        {
            var cat = t.CategoryId.HasValue ? _categories.FirstOrDefault(c => c.Id == t.CategoryId)?.Path : null;
            var acct = _accounts.FirstOrDefault(a => a.Id == t.AccountId)?.Name;
            var signed = t.Direction == "Credit" ? t.Amount : -t.Amount;
            sb.Append(t.EffectiveDate.ToString("yyyy-MM-dd")).Append(',').Append(Csv(t.Description)).Append(',').Append(Csv(t.MerchantName))
              .Append(',').Append(signed.ToString(System.Globalization.CultureInfo.InvariantCulture)).Append(',').Append(t.Direction)
              .Append(',').Append(t.Status).Append(',').Append(Csv(cat)).Append(',').Append(Csv(acct)).Append('\n');
        }

        var bytes = new System.Text.UTF8Encoding(true).GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        using var ms = new MemoryStream(bytes);
        using var reference = new DotNetStreamReference(ms);
        await JS.InvokeVoidAsync("flowledgerDownload", $"transactions-{DateTime.Now:yyyyMMdd-HHmm}.csv", reference);
    }

    private void ClearFilters()
    {
        _fromDate = null;
        _toDate = null;
        _filterAccountId = null;
        _ = LoadAsync();
    }

    private static Color StatusColor(string status) => status switch
    {
        "Posted" => Color.Success,
        "Pending" => Color.Warning,
        "Matched" => Color.Info,
        "Reconciled" => Color.Primary,
        "NeedsReview" => Color.Error,
        _ => Color.Default
    };
}
