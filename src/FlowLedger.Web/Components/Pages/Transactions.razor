    private async Task AutoCategorize()
    {
        _categorizing = true;
        try
        {
            var r = await ApiClient.RunCategorizationAsync();
            Snackbar.Add(r is null ? "Done" : $"Categorized {r.Categorized} ({r.Transfers} transfers, {r.ByModel} by the learned model); {r.Suggested} suggestions and {r.StillUncategorized} left for you to review", Severity.Success);
            _categories = await ApiClient.GetCategoriesAsync();
            RebuildLookups();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
        }
        finally
        {
            _categorizing = false;
        }
    }

    private static string Csv(string? v) => "\"" + (v ?? "").Replace("\"", "\"\"") + "\"";

    private async Task ExportCsv()
    {
        var sb = new System.Text.StringBuilder("date,description,merchant,amount,direction,status,category,account\n");
        foreach (var t in Visible)
        {
            var cat = t.CategoryId is { } cid && _categoryById.TryGetValue(cid, out var c) ? c.Path : null;
            var acct = _accountById.TryGetValue(t.AccountId, out var a) ? a.Name : null;
            var signed = t.Direction == "Credit" ? t.Amount : -t.Amount;
            sb.Append(t.EffectiveDate.ToString("yyyy-MM-dd")).Append(',').Append(Csv(t.Description)).Append(',').Append(Csv(t.MerchantName))
              .Append(',').Append(signed.ToString(System.Globalization.CultureInfo.InvariantCulture)).Append(',').Append(t.Direction)
              .Append(',').Append(t.Status).Append(',').Append(Csv(cat)).Append(',').Append(Csv(acct)).Append('\n');
        }

        var bytes = new System.Text.UTF8Encoding(true).GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        using var ms = new MemoryStream(bytes);
        using var reference = new DotNetStreamReference(ms);
        await JS.InvokeVoidAsync("flowledgerDownload", $"transactions-{DateTime.Now:yyyyMMdd-HHmm}.csv", reference);
    }

