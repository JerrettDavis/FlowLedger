@page "/transactions"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILogger<Transactions> Logger
@inject IJSRuntime JS
@inject IDialogService Dialogs

<PageTitle>Transactions — FlowLedger</PageTitle>

<PageHeader Title="Transactions">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="AutoCategorize" Disabled="_categorizing"
                       aria-label="Auto-categorize transactions">
                @(_categorizing ? "Categorizing…" : "Auto-categorize")
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" OnClick="OpenImport"
                       aria-label="Import transactions from another app or bank">
                Import
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsv"
                       aria-label="Export visible transactions as CSV">
                Export CSV
            </MudButton>
</PageHeader>

<!-- Filter bar -->
<MudPaper Elevation="0" Class="pa-3 mb-4" Style="border: 1px solid var(--mud-palette-divider);">
    <MudGrid>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Date="_fromDate" DateChanged="OnFromChanged" Label="From" Clearable="true"
                           aria-label="Filter from date" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Date="_toDate" DateChanged="OnToChanged" Label="To" Clearable="true"
                           aria-label="Filter to date" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="Guid?" Value="_filterAccountId" ValueChanged="OnAccountChanged" Label="Account" Clearable="true"
                       aria-label="Filter by account">
                @foreach (var a in _accounts)
                {
                    <MudSelectItem Value="@((Guid?)a.Id)">@a.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="string" Value="_filterCategory" ValueChanged="OnCategoryFilterChanged" Label="Category" Clearable="true"
                       aria-label="Filter by category">
                <MudSelectItem T="string" Value="@UncategorizedFilter">Uncategorized</MudSelectItem>
                @foreach (var c in _sortedCategories)
                {
                    <MudSelectItem T="string" Value="@c.Id.ToString()">@c.Path</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="string" Value="_filterStatus" ValueChanged="OnStatusFilterChanged" Label="Status" Clearable="true"
                       aria-label="Filter by status">
                @foreach (var s in StatusOptions)
                {
                    <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="2" md="2">
            <MudNumericField T="decimal?" Value="_minAmount" ValueChanged="OnMinAmountChanged" Label="Min amount" Min="0m"
                             Immediate="false" HideSpinButtons="true" aria-label="Minimum amount" />
        </MudItem>
        <MudItem xs="6" sm="2" md="2">
            <MudNumericField T="decimal?" Value="_maxAmount" ValueChanged="OnMaxAmountChanged" Label="Max amount" Min="0m"
                             Immediate="false" HideSpinButtons="true" aria-label="Maximum amount" />
        </MudItem>
        <MudItem xs="12" sm="8" md="6">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Immediate="true" DebounceInterval="300" Label="Search description or merchant" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          aria-label="Search transactions" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3" Class="d-flex align-center">
            <MudCheckBox T="bool" Value="_includeHidden" ValueChanged="OnIncludeHiddenChanged" Label="Include hidden accounts" Dense="true"
                         aria-label="Include hidden accounts" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3" Class="d-flex align-center">
            <MudCheckBox T="bool" @bind-Value="_applyToMerchant" Label="Apply category changes to same merchant" Dense="true" />
        </MudItem>
        <MudItem xs="12" sm="12" md="3" Class="d-flex align-end">
            <MudButton StartIcon="@Icons.Material.Filled.Search"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="LoadAsync"
                       FullWidth="true"
                       aria-label="Reload transactions">
                Reload
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <CardSkeleton />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (!_loading && _transactions.Count == 0 && _error is null)
{
    <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong"
                Title="No transactions"
                Description="No transactions match these filters yet.">
        <Action>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearFilters">
                Clear filters
            </MudButton>
        </Action>
    </EmptyState>
}

<MudDataGrid T="FlowLedger.Contracts.TransactionDto"
             Items="Visible"
             Filterable="true"
             FilterMode="DataGridFilterMode.ColumnFilterRow"
             SortMode="SortMode.None"
             Hover="true"
             Striped="false"
             Dense="true"
             Virtualize="false"
             RowsPerPage="@PageSize"
             MultiSelection="true"
             SelectedItems="_selected"
             SelectedItemsChanged="OnSelectionChanged"
             aria-label="Transactions table">
    <ToolBarContent>
        @if (_selected.Count > 0)
        {
            <MudMenu Dense="true" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Category"
                     Label="@($"Set category for {_selected.Count} selected")" Disabled="_bulkBusy" aria-label="Set category for selected transactions"
                     data-testid="bulk-category">
                @foreach (var c in _sortedCategories)
                {
                    var target = c;
                    <MudMenuItem OnClick="@(() => BulkSetCategory(target))">@target.Path</MudMenuItem>
                }
            </MudMenu>
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="ml-2" OnClick="ClearSelection">Clear selection</MudButton>
        }
        <MudText Typo="Typo.body2" Class="ml-auto mud-text-secondary" role="status" data-testid="tx-count">@RangeText</MudText>
    </ToolBarContent>
    <Columns>
        <SelectColumn T="FlowLedger.Contracts.TransactionDto" ShowInHeader="true" ShowInFooter="false" />
        <TemplateColumn Title="Date" Sortable="false">
            <HeaderTemplate>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="fl-sort-btn" EndIcon="@SortIcon("date")"
                           OnClick='() => SortByAsync("date")' aria-label="@SortLabel("date", "Date")" data-testid="sort-date">Date</MudButton>
            </HeaderTemplate>
            <CellTemplate>
                <MudText Typo="Typo.body2">@Format.DayMonth(context.Item.EffectiveDate)</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Merchant" Sortable="false">
            <HeaderTemplate>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="fl-sort-btn" EndIcon="@SortIcon("merchant")"
                           OnClick='() => SortByAsync("merchant")' aria-label="@SortLabel("merchant", "Merchant")" data-testid="sort-merchant">Merchant</MudButton>
            </HeaderTemplate>
            <CellTemplate>
                @{
                    var row = context.Item;
                    var display = string.IsNullOrWhiteSpace(row.MerchantName) ? row.SuggestedName : row.MerchantName;
                    var showDesc = !string.IsNullOrWhiteSpace(row.Description);
                    _accountById.TryGetValue(row.AccountId, out var rowAcct);
                }
                <div class="fl-merch fl-cell-truncate">
                    <div class="fl-merch-text">
                        <div class="fl-merch-name" title="@display">@(string.IsNullOrWhiteSpace(display) ? row.Description : display)</div>
                        @if (showDesc)
                        {
                            <div class="fl-merch-desc fl-md-only" title="@row.Description">@row.Description</div>
                        }
                        @if (rowAcct is not null)
                        {
                            <div class="fl-merch-desc fl-md-only" title="@rowAcct.Name">@rowAcct.Name</div>
                        }
                        @if (row.Tags is { Count: > 0 })
                        {
                            <div class="fl-merch-tags">
                                @foreach (var tag in row.Tags)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="my-0">@tag</MudChip>
                                }
                            </div>
                        }
                    </div>
                    <div class="fl-merch-actions">
                        <MudIconButton Icon="@Icons.Material.Outlined.Info" Size="Size.Small"
                                       OnClick="@(() => ShowDetails(row))"
                                       aria-label="@($"Show details for {row.Description}")" title="Show details" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditAlias(row))"
                                       aria-label="@($"Rename merchant for {row.Description}")" title="Rename merchant" />
                        <MudIconButton Icon="@(string.IsNullOrWhiteSpace(row.Notes) ? Icons.Material.Outlined.NoteAdd : Icons.Material.Filled.StickyNote2)" Size="Size.Small"
                                       Color="@(string.IsNullOrWhiteSpace(row.Notes) ? Color.Default : Color.Primary)"
                                       OnClick="@(() => EditNote(row))"
                                       aria-label="@($"Note for {row.Description}")" title="@(string.IsNullOrWhiteSpace(row.Notes) ? "Add a note" : row.Notes)" />
                        <MudIconButton Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small"
                                       Color="@(row.Splits is { Count: > 0 } ? Color.Primary : Color.Default)"
                                       OnClick="@(() => EditSplits(row))"
                                       aria-label="@($"Split {row.Description} across categories")" title="@(row.Splits is { Count: > 0 } ? "Edit split" : "Split across categories")" />
                    </div>
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Description" Sortable="false" HeaderClass="fl-hide-md" CellClass="fl-hide-md">
            <HeaderTemplate>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="fl-sort-btn" EndIcon="@SortIcon("description")"
                           OnClick='() => SortByAsync("description")' aria-label="@SortLabel("description", "Description")" data-testid="sort-description">Description</MudButton>
            </HeaderTemplate>
            <CellTemplate>
                <span class="fl-cell-truncate fl-desc-cell" title="@context.Item.Description">@context.Item.Description</span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Amount" Sortable="false">
            <HeaderTemplate>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="fl-sort-btn" EndIcon="@SortIcon("amount")"
                           OnClick='() => SortByAsync("amount")' aria-label="@SortLabel("amount", "Amount")" data-testid="sort-amount">Amount</MudButton>
            </HeaderTemplate>
            <CellTemplate>
                <MudText Class="fl-num" Color="@Format.Delta(context.Item.Direction == "Credit" ? context.Item.Amount : -context.Item.Amount)">
                    @Format.Signed(context.Item.Amount, context.Item.Direction == "Credit")
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" HeaderClass="fl-hide-lg" CellClass="fl-hide-lg">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)" Variant="Variant.Text">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Category" Sortable="false">
            <CellTemplate>
                @{
                    var cat = context.Item.CategoryId is { } catId && _categoryById.TryGetValue(catId, out var foundCat) ? foundCat : null;
                    var item = context.Item;
                }
                <MudMenu Dense="true" Label="@(cat?.DisplayName ?? "Uncategorized")" Variant="Variant.Text" Size="Size.Small"
                         Color="@(cat is null ? Color.Default : Color.Primary)" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         aria-label="@($"Change category for {item.Description}")">
                    @foreach (var c in _sortedCategories)
                    {
                        var target = c;
                        <MudMenuItem OnClick="@(() => SetCategory(item, target))">@target.Path</MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Account" Sortable="false" HeaderClass="fl-hide-md" CellClass="fl-hide-md">
            <CellTemplate>
                @{
                    _accountById.TryGetValue(context.Item.AccountId, out var acct);
                }
                <span class="fl-cell-clip" title="@(acct?.Name)">@(acct?.Name ?? "–")</span>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

<nav class="fl-pager" aria-label="Transactions pages">
    <MudSelect T="int" Value="PageSize" ValueChanged="OnPageSizeChanged" Dense="true" Variant="Variant.Outlined" Label="Rows per page"
               Class="fl-select-md" aria-label="Rows per page">
        @foreach (var size in PageSizes)
        {
            <MudSelectItem T="int" Value="@size">@size</MudSelectItem>
        }
    </MudSelect>
    <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="tx-range">@RangeText</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(_page == 0 || _loading)" OnClick="PreviousPageAsync" aria-label="Previous page" />
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(!HasNextPage || _loading)" OnClick="NextPageAsync" aria-label="Next page" />
</nav>

@code {
    private bool _loading = true;
    private string? _error;

    private List<FlowLedger.Contracts.TransactionDto> _transactions = [];
    private List<FlowLedger.Contracts.AccountDto> _accounts = [];
    private List<FlowLedger.Contracts.CategoryDto> _categories = [];

    private DateTime? _fromDate;
    private DateTime? _toDate;
    private Guid? _filterAccountId;
    private bool _includeHidden;
    private string? _search;
    private const string UncategorizedFilter = "uncategorized";
    private static readonly string[] StatusOptions = ["Posted", "Pending", "Matched", "Reconciled", "NeedsReview"];
    private string? _filterCategory;
    private string? _filterStatus;
    private decimal? _minAmount;
    private decimal? _maxAmount;
    private HashSet<FlowLedger.Contracts.TransactionDto> _selected = [];
    private bool _bulkBusy;
    private bool _applyToMerchant;
    private bool _categorizing;
    private static readonly int[] PageSizes = [25, 50, 100, 250];
    private int PageSize = 50;
    private int _page;
    private int? _total;
    private int _loadSeq;

    // "1–50 of 1,234": the server reports the total, so the grid never silently hides older rows behind a client-side cap.
    private string RangeText =>
        _transactions.Count == 0
            ? "No transactions"
            : _total is { } total
                ? $"{Format.Count(_page * PageSize + 1)}–{Format.Count(_page * PageSize + _transactions.Count)} of {Format.Count(total)}"
                : $"{Format.Count(_page * PageSize + 1)}–{Format.Count(_page * PageSize + _transactions.Count)}";

    private bool HasNextPage => _total is { } total ? (_page + 1) * PageSize < total : _transactions.Count >= PageSize;

    private List<FlowLedger.Contracts.TransactionDto> _visible = [];
    private Dictionary<Guid, FlowLedger.Contracts.CategoryDto> _categoryById = [];
    private List<FlowLedger.Contracts.CategoryDto> _sortedCategories = [];
    private Dictionary<Guid, FlowLedger.Contracts.AccountDto> _accountById = [];

    private List<FlowLedger.Contracts.TransactionDto> Visible => _visible;

    // Server-side sort (#209): the order applies to the whole result, not only the page on screen. Newest first until a header is clicked.
    private string _sortKey = "date";
    private bool _sortDescending = true;

    private Task SortByAsync(string key)
    {
        // Same column flips direction; a new column starts descending for amount/date and ascending for text.
        if (_sortKey == key)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortKey = key;
            _sortDescending = key is "date" or "amount";
        }

        return LoadAsync();
    }

    private string SortIcon(string key) =>
        _sortKey != key ? Icons.Material.Filled.UnfoldMore
        : _sortDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward;

    private string SortLabel(string key, string title) =>
        _sortKey != key ? $"Sort by {title}"
        : $"Sort by {title}, currently {(_sortDescending ? "descending" : "ascending")}";

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return LoadAsync();
    }

    private void RecomputeVisible() => _visible = _transactions;

    private void RebuildLookups()
    {
        _categoryById = _categories.GroupBy(c => c.Id).ToDictionary(g => g.Key, g => g.First());
        _sortedCategories = _categories.OrderBy(c => c.Path).ToList();
        _accountById = _accounts.GroupBy(a => a.Id).ToDictionary(g => g.Key, g => g.First());
    }

    /// <summary>Replaces one row in place and refreshes the cached view (avoids a full reload for single-row edits).</summary>
    private void PatchRow(Guid id, Func<FlowLedger.Contracts.TransactionDto, FlowLedger.Contracts.TransactionDto> patch)
    {
        var i = _transactions.FindIndex(t => t.Id == id);
        if (i >= 0)
        {
            _transactions[i] = patch(_transactions[i]);
            RecomputeVisible();
        }
    }

    /// <summary>Deep link from the dashboard account strip: /transactions?account={id}.</summary>
    [SupplyParameterFromQuery(Name = "account")] public Guid? AccountQuery { get; set; }

    /// <summary>Deep link from "Needs a Look": /transactions?uncategorized=true.</summary>
    [SupplyParameterFromQuery(Name = "uncategorized")] public bool UncategorizedQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await ApiClient.GetAccountsAsync();
            _categories = await ApiClient.GetCategoriesAsync();
            RebuildLookups();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load accounts or categories for transaction filters");
            Snackbar.Add("Couldn't load account and category filters — some dropdowns may be empty.", Severity.Warning);
        }
        _filterAccountId ??= AccountQuery;
        if (UncategorizedQuery)
        {
            _filterCategory = UncategorizedFilter; // deep link from the dashboard's "Needs a Look" card
        }

        await LoadAsync();
    }

    /// <summary>Reloads from the first page; every filter, search or page-size change starts here.</summary>
    private Task LoadAsync()
    {
        _page = 0;
        return LoadPageAsync();
    }

    private Task NextPageAsync()
    {
        _page++;
        return LoadPageAsync();
    }

    private Task PreviousPageAsync()
    {
        _page = Math.Max(0, _page - 1);
        return LoadPageAsync();
    }

    private Task OnPageSizeChanged(int size)
    {
        PageSize = size;
        return LoadAsync();
    }

    /// <summary>Loads the current page from the server (filters, search and paging are applied there).</summary>
    private async Task LoadPageAsync()
    {
        var seq = ++_loadSeq;
        _loading = true;
        _error = null;
        try
        {
            var from = _fromDate.HasValue ? DateOnly.FromDateTime(_fromDate.Value) : (DateOnly?)null;
            var to = _toDate.HasValue ? DateOnly.FromDateTime(_toDate.Value) : (DateOnly?)null;

            var page = await ApiClient.GetTransactionPageAsync(
                accountId: _filterAccountId,
                from: from,
                to: to,
                skip: _page * PageSize,
                take: PageSize,
                includeHidden: _includeHidden,
                search: _search,
                sort: _sortKey,
                descending: _sortDescending,
                filter: ColumnFilter);
            if (seq != _loadSeq)
            {
                return; // a newer filter or search superseded this response
            }

            _transactions = page.Items;
            _total = page.Total;
            _selected = [];
            RecomputeVisible();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load transactions");
            if (seq == _loadSeq)
            {
                _error = SnackbarExtensions.ProblemText(ex, "Failed to load transactions. Please try again.");
            }
        }
        finally
        {
            if (seq == _loadSeq)
            {
                _loading = false;
            }
        }
    }

    // Filters apply as soon as they change (one reload each), no separate Filter press needed.
    private Task OnFromChanged(DateTime? value) { _fromDate = value; return LoadAsync(); }

    private Task OnToChanged(DateTime? value) { _toDate = value; return LoadAsync(); }

    private FlowLedger.Web.ApiClient.TransactionColumnFilter? ColumnFilter =>
        _filterCategory is null && _filterStatus is null && _minAmount is null && _maxAmount is null
            ? null
            : new FlowLedger.Web.ApiClient.TransactionColumnFilter(
                Guid.TryParse(_filterCategory, out var category) ? category : null,
                _filterCategory == UncategorizedFilter,
                _filterStatus, _minAmount, _maxAmount);

    private void OnSelectionChanged(HashSet<FlowLedger.Contracts.TransactionDto> items) => _selected = items;

    private void ClearSelection() => _selected = [];

    /// <summary>Sets one category on every selected row (a single server call), then reloads the page. Selection is per page.</summary>
    private async Task BulkSetCategory(FlowLedger.Contracts.CategoryDto category)
    {
        if (_selected.Count == 0)
        {
            return;
        }

        var ids = _selected.Select(t => t.Id).ToList();
        _bulkBusy = true;
        try
        {
            var changed = await ApiClient.SetCategoryBulkAsync(ids, category.Id);
            Snackbar.Add($"Set {changed} transaction{(changed == 1 ? "" : "s")} to {category.Path}", Severity.Success);
            _selected = [];
            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bulk category change failed");
            Snackbar.AddFailure(ex, "Couldn't set the category on the selected transactions");
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private Task OnCategoryFilterChanged(string? value) { _filterCategory = value; return LoadAsync(); }

    private Task OnStatusFilterChanged(string? value) { _filterStatus = value; return LoadAsync(); }

    private Task OnMinAmountChanged(decimal? value) { _minAmount = value; return LoadAsync(); }

    private Task OnMaxAmountChanged(decimal? value) { _maxAmount = value; return LoadAsync(); }

    private Task OnAccountChanged(Guid? value) { _filterAccountId = value; return LoadAsync(); }

    private Task OnIncludeHiddenChanged(bool value) { _includeHidden = value; return LoadAsync(); }

    private async Task SetCategory(FlowLedger.Contracts.TransactionDto tx, FlowLedger.Contracts.CategoryDto category)
    {
        try
        {
            var applyToMerchant = _applyToMerchant;
            // The server counts with the exact rule the change uses (uncategorized or auto-categorized rows of the same merchant, whole history).
            var others = applyToMerchant ? await ApiClient.GetSameMerchantCountAsync(tx.Id) : 0;
            if (others > 0)
            {
                // Bulk recategorisation must be explicit: say how many rows it touches and let the user narrow it.
                var choice = await Dialogs.ShowMessageBoxAsync(
                    "Apply to the same merchant?",
                    $"Set {others} other transaction{(others == 1 ? "" : "s")} from {MerchantMatch.Key(tx)} to {category.Path} as well? " +
                    "Rows you categorized by hand are left alone, and you can undo this.",
                    yesText: $"Apply to {others + 1}", noText: "Only this one", cancelText: "Cancel");
                if (choice is null)
                {
                    return;
                }

                applyToMerchant = choice == true;
            }

            var previous = tx.CategoryId;

            // Send the version the user last saw (If-Match); a 409 means the row changed elsewhere (another tab or a sync).
            uint? savedVersion = null;
            IReadOnlyList<FlowLedger.Web.ApiClient.CategoryRestoreDto> restore = [];
            var changed = await ApiClient.SetTransactionCategoryAsync(
                tx.Id, category.Id, applyToMerchant, expectedVersion: tx.Version == 0 ? null : tx.Version, newVersion: v => savedVersion = v,
                restore: rows => restore = rows);
            if (changed > 1 && restore.Count > 0)
            {
                // A merchant-wide change is reversible too: Undo puts every touched row back (rows changed since are left alone).
                Snackbar.AddWithUndo($"Set {changed} transactions to {category.Path}", async () =>
                {
                    await ApiClient.RestoreCategoriesAsync(category.Id, restore);
                    await InvokeAsync(async () =>
                    {
                        await LoadPageAsync();
                        StateHasChanged();
                    });
                });
            }
            else if (changed == 1 && previous is { } before)
            {
                // A single-row change can be reverted exactly; bulk changes were already confirmed with their count.
                var versionAfterSet = savedVersion;
                Snackbar.AddWithUndo($"Set to {category.Path}", async () =>
                {
                    // The undo is itself a versioned write against the row as this change left it.
                    uint? undoVersion = null;
                    await ApiClient.SetTransactionCategoryAsync(
                        tx.Id, before, applyToMerchant: false, expectedVersion: versionAfterSet, newVersion: v => undoVersion = v);
                    await InvokeAsync(() =>
                    {
                        PatchRow(tx.Id, t => t with { CategoryId = before, Version = undoVersion ?? t.Version });
                        StateHasChanged();
                    });
                });
            }
            else
            {
                Snackbar.Add(changed > 1 ? $"Set {changed} transactions to {category.Path}" : $"Set to {category.Path}", Severity.Success);
            }

            if (changed > 1)
            {
                await LoadAsync();
            }
            else
            {
                PatchRow(tx.Id, t => t with { CategoryId = category.Id, Version = savedVersion ?? t.Version });
            }
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
            if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
            {
                await LoadAsync(); // pick up the current versions
            }
        }
    }

