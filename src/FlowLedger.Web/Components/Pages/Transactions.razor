    private static Color StatusColor(string status) => status switch
    {
        "Posted" => Color.Success,
        "Pending" => Color.Warning,
        "Matched" => Color.Info,
        "Reconciled" => Color.Primary,
        "NeedsReview" => Color.Error,
        _ => Color.Default
    };
