@page "/recurring-flows"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<RecurringFlows> Logger

<PageTitle>Recurring Flows — FlowLedger</PageTitle>

<PageHeader Title="Recurring Flows">
        <div class="d-flex gap-2 align-center" style="flex-wrap:wrap">
        <DateRangeSelector Label="Active during" Presets="@DateRangeSelector.ForwardPresets" Preset="@_rangePreset"
                           From="@(_rangeFrom ?? default)" To="@_rangeTo" Changed="OnRangeChanged" />
        <MudButton StartIcon="@Icons.Material.Filled.AutoFixHigh"
                   Color="Color.Default"
                   Variant="Variant.Outlined"
                   Disabled="_busy"
                   OnClick="DetectNow"
                   aria-label="Re-run recurring detection">
            Detect now
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="OpenCreateDialog"
                   aria-label="Add recurring flow">
            Add Flow
        </MudButton>
        </div>
</PageHeader>

@if (_suggestions.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Outlined="true" aria-label="Suggested recurring flows">
        <div class="d-flex align-center justify-space-between mb-2">
            <div>
                <MudText Typo="Typo.h6">Suggested recurring flows</MudText>
                <MudText Typo="Typo.caption" Class="fl-muted">
                    Found in your transactions. Add the ones you want so forecasts and upcoming-bill alerts include them.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                       Disabled="_busy" OnClick="AcceptAllSuggestions"
                       aria-label="Add all suggested recurring flows">
                Add all (@_suggestions.Count)
            </MudButton>
        </div>
        <div class="fl-cards">
            @foreach (var s in _suggestions)
            {
                <div class="fl-period">
                    <div class="d-flex justify-space-between align-center">
                        <span class="fl-li__title">@s.Name</span>
                        <span class="fl-pill @(s.Confidence >= 0.85 ? "fl-pill--pos" : "")">@($"{s.Confidence:P0}") · @s.Occurrences×</span>
                    </div>
                    <div class="fl-tile__value fl-num @(s.Direction == "Credit" ? "fl-pos" : "")">
                        @Format.Signed(s.Amount, s.Direction == "Credit")@(s.AmountModel == "Estimated" ? " ≈" : "")
                    </div>
                    <MudText Typo="Typo.caption" Class="fl-muted">@DescribeSuggestion(s) · next @Format.DayMonth(s.NextExpected) · @s.AccountName</MudText>
                    <div class="d-flex justify-end mt-1">
                        <MudButton Size="Size.Small" Color="Color.Primary" Disabled="_busy"
                                   OnClick="() => AcceptSuggestion(s)" aria-label="@($"Add {s.Name} as a recurring flow")">Add</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Default" Disabled="_busy"
                                   OnClick="() => DismissSuggestion(s)" aria-label="@($"Dismiss suggestion {s.Name}")">Dismiss</MudButton>
                    </div>
                </div>
            }
        </div>
    </MudPaper>
}

@if (_loading)
{
    <CardSkeleton />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (!_loading && _error is null && _flows.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.Repeat"
                Title="No recurring flows"
                Description="@($"Add a recurring flow. {OnboardingCopy.LoadData(Status?.Environment)}")">
        <Action>
            <MudButton StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="OpenCreateDialog"
                       aria-label="Add recurring flow">
                Add Flow
            </MudButton>
        </Action>
    </EmptyState>
}

@if (_flows.Count > 0)
{
    var inflow = MonthlyTotal("Credit");
    var outflow = MonthlyTotal("Debit");
    var net = inflow - outflow;
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4"><MudPaper Class="pa-4 fl-card-hover" Outlined="true"><div class="fl-tile__label">Income / month</div><div class="fl-tile__value fl-num fl-pos">+@Format.Money(inflow)</div></MudPaper></MudItem>
        <MudItem xs="12" sm="4"><MudPaper Class="pa-4 fl-card-hover" Outlined="true"><div class="fl-tile__label">Bills / month</div><div class="fl-tile__value fl-num fl-neg">−@Format.Money(outflow)</div></MudPaper></MudItem>
        <MudItem xs="12" sm="4"><MudPaper Class="pa-4 fl-card-hover" Outlined="true"><div class="fl-tile__label">Left over</div><div class="fl-tile__value fl-num @(net >= 0 ? "fl-pos" : "fl-neg")">@Format.Signed(net)</div></MudPaper></MudItem>
    </MudGrid>

    @foreach (var (title, dir) in new[] { ("Bills & expenses", "Debit"), ("Income", "Credit") })
    {
        var items = _flows.Where(f => f.Direction == dir).OrderByDescending(f => f.IsActive).ThenByDescending(f => f.MonthlyAmount).ToList();
        if (items.Count == 0) { continue; }
        var max = items.Max(f => f.MonthlyAmount);
        <section class="mb-4" aria-label="@title">
            <div class="fl-section__head">
                <span class="fl-dot @(dir == "Credit" ? "fl-tone-cash" : "fl-tone-loan")"></span>
                <MudText Typo="Typo.subtitle1">@title</MudText>
                <MudText Typo="Typo.caption" Class="fl-muted">@items.Count</MudText>
            </div>
            <MudPaper Class="fl-list" Outlined="true">
                @foreach (var f in items)
                {
                    var acct = _accounts.FirstOrDefault(a => a.Id == f.AccountId);
                    var w = max == 0 ? 0 : (double)(f.MonthlyAmount / max * 100);
                    <div class="fl-li @(f.IsActive ? "" : "fl-li--off")">
                        <MudAvatar Color="@(dir == "Credit" ? Color.Success : Color.Error)" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@(dir == "Credit" ? Icons.Material.Filled.SouthWest : Icons.Material.Filled.NorthEast)" />
                        </MudAvatar>
                        <div class="fl-li__main">
                            <div class="fl-li__title">@f.Name</div>
                            <div class="fl-li__sub">@DescribeSchedule(f) · @(acct?.Name ?? "–")@(f.IsActive ? "" : " · inactive")@(f.EndDate.HasValue ? $" · ends {Format.FullDate(f.EndDate.Value)}" : "")</div>
                            <div class="fl-meter mt-1" style="max-width:260px"><span style="width:@(w.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;background:@(dir == "Credit" ? "var(--mud-palette-success)" : "var(--mud-palette-error)")"></span></div>
                        </div>
                        <div class="text-right">
                            <div class="fl-li__amt fl-num @(dir == "Credit" ? "fl-pos" : "")">@Format.Signed(f.Amount, dir == "Credit")</div>
                            <div class="fl-li__sub fl-hide-md" style="justify-content:flex-end" title="@($"{PerMonthCount(f):0.##} occurrence(s) a month on average")">≈ @Format.Money(f.MonthlyAmount)/mo</div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="() => OpenEditDialog(f)" aria-label="@($"Edit flow {f.Name}")" />
                        <MudTooltip Text="Not recurring: remove and never detect again">
                            <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Warning"
                                           OnClick="() => FlagNotRecurring(f)" aria-label="@($"Flag {f.Name} as not recurring")" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => DeleteFlow(f)" aria-label="@($"Delete flow {f.Name}")" />
                    </div>
                }
            </MudPaper>
        </section>
    }
}

@code {
    /// <summary>Environment from the layout; drives which empty-state instruction is shown.</summary>
    [CascadingParameter] private FlowLedger.Web.Services.LayoutStatus? Status { get; set; }

    private bool _loading = true;
    private string? _error;
    private List<FlowLedger.Contracts.RecurringFlowDto> _allFlows = [];
    private string _rangePreset = "All time";
    private DateOnly? _rangeFrom;
    private DateOnly _rangeTo = DateOnly.FromDateTime(DateTime.Today);

    // A flow counts when its start/end window overlaps the chosen range ("All time" keeps everything).
    private List<FlowLedger.Contracts.RecurringFlowDto> FilterFlows() => _rangePreset == "All time"
        ? _allFlows
        : _allFlows.Where(f => f.StartDate <= _rangeTo && (f.EndDate is null || f.EndDate >= (_rangeFrom ?? DateOnly.MinValue))).ToList();

    private void OnRangeChanged(DateRangeSelector.DateRange r)
    {
        _rangePreset = r.Preset;
        _rangeFrom = r.From;
        _rangeTo = r.To;
        _flows = FilterFlows();
    }
    private List<FlowLedger.Contracts.RecurringFlowDto> _flows = [];
    private List<FlowLedger.Contracts.AccountDto> _accounts = [];
    private List<FlowLedger.Contracts.RecurringSuggestionDto> _suggestions = [];
    private bool _busy;

    private static string DescribeSuggestion(FlowLedger.Contracts.RecurringSuggestionDto s) => s.Frequency switch
    {
        "Weekly" => $"Weekly on {s.AnchorDayOfWeek}",
        "EveryNWeeks" => $"Every {s.IntervalWeeks} weeks on {s.AnchorDayOfWeek}",
        "TwiceMonthly" => $"Twice a month ({s.DayOfMonth} & {s.SecondDayOfMonth})",
        "Monthly" => $"Monthly on the {s.DayOfMonth}{Ordinal(s.DayOfMonth ?? 0)}",
        _ => s.Frequency,
    };

    private static string Ordinal(int n) => (n % 100) is >= 11 and <= 13 ? "th" : (n % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" };

    private async Task LoadSuggestionsAsync()
    {
        try
        {
            _suggestions = await ApiClient.GetRecurringSuggestionsAsync();
        }
        catch (Exception ex)
        {
            // Suggestions are a convenience: never block the page if detection fails.
            Logger.LogWarning(ex, "Failed to load recurring suggestions");
            _suggestions = [];
        }
    }

    private async Task AcceptSuggestion(FlowLedger.Contracts.RecurringSuggestionDto s)
    {
        _busy = true;
        try
        {
            if (await ApiClient.AcceptRecurringSuggestionAsync(s.Key))
            {
                Snackbar.Add($"Added “{s.Name}”.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add("Couldn't add that flow.", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DismissSuggestion(FlowLedger.Contracts.RecurringSuggestionDto s)
    {
        _busy = true;
        try
        {
            if (await ApiClient.DismissRecurringSuggestionAsync(s.Key))
            {
                _suggestions.Remove(s);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FlagNotRecurring(FlowLedger.Contracts.RecurringFlowDto flow)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Remove '{flow.Name}' and never detect it as a recurring flow again?" },
            { x => x.ConfirmText, "Remove & ignore" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Not recurring", parameters, new DialogOptions { CloseButton = true });
        if ((await dialog.Result) is not { Canceled: false })
        {
            return;
        }

        _busy = true;
        try
        {
            if (await ApiClient.FlagRecurringFlowNotRecurringAsync(flow.Id))
            {
                Snackbar.Add($"Removed “{flow.Name}”; it won't be detected again.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add("Couldn't flag that flow.", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DetectNow()
    {
        _busy = true;
        try
        {
            var result = await ApiClient.AutoAddRecurringFlowsAsync();
            Snackbar.Add(result is null ? "Detection failed." : $"Detection finished: added {result.Added} flow(s).",
                result is null ? Severity.Error : Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AcceptAllSuggestions()
    {
        _busy = true;
        var added = 0;
        try
        {
            foreach (var s in _suggestions.ToList())
            {
                if (await ApiClient.AcceptRecurringSuggestionAsync(s.Key))
                {
                    added++;
                }
            }

            Snackbar.Add($"Added {added} recurring flow(s).", Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await ApiClient.GetAccountsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load accounts for recurring flows page");
            Snackbar.Add("Couldn't load account names — account labels may be missing.", Severity.Warning);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _allFlows = await ApiClient.GetRecurringFlowsAsync();
            _flows = FilterFlows();
            await LoadSuggestionsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load recurring flows");
            _error = ex is FlowLedger.Web.ApiClient.ApiClientException ace
                ? ace.Message
                : "Failed to load recurring flows. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<RecurringFlowFormDialog>("Create Recurring Flow",
            new DialogParameters<RecurringFlowFormDialog>
            {
                { x => x.Flow, null },
                { x => x.Accounts, _accounts }
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FlowLedger.Contracts.CreateRecurringFlowRequest req })
        {
            try
            {
                await ApiClient.CreateRecurringFlowAsync(req);
                Snackbar.Add("Flow created", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to create recurring flow");
                Snackbar.AddFailure(ex, fallback: "Couldn't create flow. Please try again.");
            }
        }
    }

    private async Task OpenEditDialog(FlowLedger.Contracts.RecurringFlowDto flow)
    {
        var dialog = await DialogService.ShowAsync<RecurringFlowFormDialog>("Edit Recurring Flow",
            new DialogParameters<RecurringFlowFormDialog>
            {
                { x => x.Flow, flow },
                { x => x.Accounts, _accounts }
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FlowLedger.Contracts.UpdateRecurringFlowRequest updateReq })
        {
            try
            {
                // If-Match: the version the user last saw; a 409 means the flow changed elsewhere (another tab or a sync).
                await ApiClient.UpdateRecurringFlowAsync(flow.Id, updateReq, expectedVersion: flow.Version == 0 ? null : flow.Version);
                Snackbar.Add("Flow updated", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to update recurring flow {FlowId}", flow.Id);
                Snackbar.AddFailure(ex, fallback: "Couldn't update flow. Please try again.");
                if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
                {
                    await LoadAsync(); // pick up the current versions
                }
            }
        }
    }

    private async Task DeleteFlow(FlowLedger.Contracts.RecurringFlowDto flow)
    {
        var options = new DialogOptions { CloseButton = true };
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Delete '{flow.Name}'? This cannot be undone." },
            { x => x.ConfirmText, "Delete" }
        };
        var confirmDialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Flow", parameters, options);
        var confirmResult = await confirmDialog.Result;
        if (confirmResult is { Canceled: false })
        {
            try
            {
                await ApiClient.DeleteRecurringFlowAsync(flow.Id, expectedVersion: flow.Version == 0 ? null : flow.Version);
                Snackbar.Add("Flow deleted", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to delete recurring flow {FlowId}", flow.Id);
                Snackbar.AddFailure(ex, fallback: "Couldn't delete flow. Please try again.");
                if (ex is FlowLedger.Web.ApiClient.ApiClientException { StatusCode: System.Net.HttpStatusCode.Conflict })
                {
                    await LoadAsync(); // pick up the current versions
                }
            }
        }
    }

    private decimal MonthlyTotal(string direction) =>
        _flows.Where(f => f.IsActive && f.Direction == direction).Sum(f => f.MonthlyAmount);

    private static decimal PerMonthCount(FlowLedger.Contracts.RecurringFlowDto f) =>
        f.Amount > 0 ? f.MonthlyAmount / f.Amount : 0;

    // Sort key for the Schedule column: monthly flows order by their due day (like the bill sheet's Due column);
    // twice-monthly use their first day; flows without a fixed day of the month (weekly, every-N-weeks, daily)
    // follow, grouped by how often they repeat.
    internal static int ScheduleSortKey(FlowLedger.Contracts.RecurringFlowDto f) => f.RecurrenceFrequency switch
    {
        "Monthly" or "TwiceMonthly" when f.DayOfMonth.HasValue => f.DayOfMonth.Value,
        "Monthly" or "TwiceMonthly" => 50,
        "EveryNWeeks" => 100 + (f.IntervalWeeks ?? 2),
        "Weekly" => 100,
        "Daily" => 99,
        _ => 200,
    };

    private static string DescribeSchedule(FlowLedger.Contracts.RecurringFlowDto flow)
    {
        return flow.RecurrenceFrequency switch
        {
            "Monthly" when flow.DayOfMonth.HasValue => $"On the {flow.DayOfMonth}{OrdinalSuffix(flow.DayOfMonth.Value)}",
            "Monthly" => "Monthly",
            "Weekly" when flow.AnchorDayOfWeek is not null => $"Every {flow.AnchorDayOfWeek}",
            "Weekly" => "Weekly",
            "EveryNWeeks" when flow.IntervalWeeks.HasValue => $"Every {flow.IntervalWeeks} weeks on {flow.AnchorDayOfWeek}",
            "TwiceMonthly" => $"Twice a month ({flow.DayOfMonth} & {flow.SecondDayOfMonth})",
            "Daily" => "Daily",
            _ => flow.RecurrenceFrequency
        };
    }

    private static string OrdinalSuffix(int day)
    {
        // Handle teens (11th, 12th, 13th) first — they never take 1st/2nd/3rd.
        int lastTwo = day % 100;
        if (lastTwo is >= 11 and <= 13)
        {
            return "th";
        }
        return (day % 10) switch
        {
            1 => "st",
            2 => "nd",
            3 => "rd",
            _ => "th"
        };
    }
}
