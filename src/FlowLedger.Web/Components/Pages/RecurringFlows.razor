@page "/recurring-flows"
@rendermode InteractiveServer
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<RecurringFlows> Logger

<PageTitle>Recurring Flows — FlowLedger</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">Recurring Flows</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Color="Color.Primary"
               Variant="Variant.Filled"
               OnClick="OpenCreateDialog"
               aria-label="Add recurring flow">
        Add Flow
    </MudButton>
</div>

@if (_suggestions.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Outlined="true" aria-label="Suggested recurring flows">
        <div class="d-flex align-center justify-space-between mb-2">
            <div>
                <MudText Typo="Typo.h6">Suggested recurring flows</MudText>
                <MudText Typo="Typo.caption" Class="fl-muted">
                    Found in your transactions. Add the ones you want so forecasts and upcoming-bill alerts include them.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                       Disabled="_busy" OnClick="AcceptAllSuggestions"
                       aria-label="Add all suggested recurring flows">
                Add all (@_suggestions.Count)
            </MudButton>
        </div>
        <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto;">
            <thead>
                <tr><th>Name</th><th>Account</th><th>Amount</th><th>Repeats</th><th>Next</th><th>Confidence</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var s in _suggestions)
            {
                <tr>
                    <td>@s.Name</td>
                    <td><MudText Typo="Typo.caption">@s.AccountName</MudText></td>
                    <td>
                        <MudText Class="fl-num" Color="@(s.Direction == "Credit" ? Color.Success : Color.Error)">
                            @Format.Signed(s.Amount, s.Direction == "Credit")@(s.AmountModel == "Estimated" ? " ≈" : "")
                        </MudText>
                    </td>
                    <td>@DescribeSuggestion(s)</td>
                    <td>@Format.DayMonth(s.NextExpected)</td>
                    <td><MudChip T="string" Size="Size.Small" Color="@(s.Confidence >= 0.85 ? Color.Success : Color.Warning)">@($"{s.Confidence:P0}") · @s.Occurrences×</MudChip></td>
                    <td style="white-space:nowrap;">
                        <MudButton Size="Size.Small" Color="Color.Primary" Disabled="_busy"
                                   OnClick="() => AcceptSuggestion(s)" aria-label="@($"Add {s.Name} as a recurring flow")">Add</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Default" Disabled="_busy"
                                   OnClick="() => DismissSuggestion(s)" aria-label="@($"Dismiss suggestion {s.Name}")">Dismiss</MudButton>
                    </td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@if (_loading)
{
    <CardSkeleton />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (!_loading && _error is null && _flows.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.Repeat"
                Title="No recurring flows"
                Description="Add a recurring flow or use Connect & Sync to load demo data.">
        <Action>
            <MudButton StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="OpenCreateDialog"
                       aria-label="Add recurring flow">
                Add Flow
            </MudButton>
        </Action>
    </EmptyState>
}

<MudDataGrid T="FlowLedger.Web.ApiClient.RecurringFlowDto"
             Items="_flows"
             Filterable="true"
             FilterMode="DataGridFilterMode.ColumnFilterRow"
             SortMode="SortMode.Multiple"
             Hover="true"
             Striped="false"
             Dense="true"
             aria-label="Recurring flows table">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Name" Sortable="true" />
        <TemplateColumn Title="Account">
            <CellTemplate>
                @{
                    var acct = _accounts.FirstOrDefault(a => a.Id == context.Item.AccountId);
                }
                <MudText Typo="Typo.body2">@(acct?.Name ?? "–")</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Amount" Sortable="true" SortBy="x => x.Amount">
            <CellTemplate>
                <MudText Class="fl-num" Color="@(context.Item.Direction == "Credit" ? Color.Success : Color.Error)">
                    @Format.Signed(context.Item.Amount, context.Item.Direction == "Credit") @context.Item.Currency
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.RecurrenceFrequency" Title="Frequency" Sortable="true" />
        <TemplateColumn Title="Schedule">
            <CellTemplate>
                <MudText Typo="Typo.body2">@DescribeSchedule(context.Item)</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Window">
            <CellTemplate>
                <MudText Typo="Typo.caption">
                    @Format.DayMonth(context.Item.StartDate)
                    @(context.Item.EndDate.HasValue ? $" → {Format.FullDate(context.Item.EndDate.Value)}" : " (ongoing)")
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                    @(context.Item.IsActive ? "Active" : "Inactive")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="() => OpenEditDialog(context.Item)"
                               aria-label="@($"Edit flow {context.Item.Name}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="() => DeleteFlow(context.Item)"
                               aria-label="@($"Delete flow {context.Item.Name}")" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private bool _loading = true;
    private string? _error;
    private List<FlowLedger.Web.ApiClient.RecurringFlowDto> _flows = [];
    private List<FlowLedger.Web.ApiClient.AccountDto> _accounts = [];
    private List<FlowLedger.Web.ApiClient.RecurringSuggestionDto> _suggestions = [];
    private bool _busy;

    private static string DescribeSuggestion(FlowLedger.Web.ApiClient.RecurringSuggestionDto s) => s.Frequency switch
    {
        "Weekly" => $"Weekly on {s.AnchorDayOfWeek}",
        "EveryNWeeks" => $"Every {s.IntervalWeeks} weeks on {s.AnchorDayOfWeek}",
        "TwiceMonthly" => $"Twice a month ({s.DayOfMonth} & {s.SecondDayOfMonth})",
        "Monthly" => $"Monthly on the {s.DayOfMonth}{Ordinal(s.DayOfMonth ?? 0)}",
        _ => s.Frequency,
    };

    private static string Ordinal(int n) => (n % 100) is >= 11 and <= 13 ? "th" : (n % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" };

    private async Task LoadSuggestionsAsync()
    {
        try
        {
            _suggestions = await ApiClient.GetRecurringSuggestionsAsync();
        }
        catch (Exception ex)
        {
            // Suggestions are a convenience: never block the page if detection fails.
            Logger.LogWarning(ex, "Failed to load recurring suggestions");
            _suggestions = [];
        }
    }

    private async Task AcceptSuggestion(FlowLedger.Web.ApiClient.RecurringSuggestionDto s)
    {
        _busy = true;
        try
        {
            if (await ApiClient.AcceptRecurringSuggestionAsync(s.Key))
            {
                Snackbar.Add($"Added “{s.Name}”.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add("Couldn't add that flow.", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DismissSuggestion(FlowLedger.Web.ApiClient.RecurringSuggestionDto s)
    {
        _busy = true;
        try
        {
            if (await ApiClient.DismissRecurringSuggestionAsync(s.Key))
            {
                _suggestions.Remove(s);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AcceptAllSuggestions()
    {
        _busy = true;
        var added = 0;
        try
        {
            foreach (var s in _suggestions.ToList())
            {
                if (await ApiClient.AcceptRecurringSuggestionAsync(s.Key))
                {
                    added++;
                }
            }

            Snackbar.Add($"Added {added} recurring flow(s).", Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await ApiClient.GetAccountsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load accounts for recurring flows page");
            Snackbar.Add("Couldn't load account names — account labels may be missing.", Severity.Warning);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _flows = await ApiClient.GetRecurringFlowsAsync();
            await LoadSuggestionsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load recurring flows");
            _error = ex is FlowLedger.Web.ApiClient.ApiClientException ace
                ? ace.Message
                : "Failed to load recurring flows. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<RecurringFlowFormDialog>("Create Recurring Flow",
            new DialogParameters<RecurringFlowFormDialog>
            {
                { x => x.Flow, null },
                { x => x.Accounts, _accounts }
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FlowLedger.Web.ApiClient.CreateRecurringFlowRequest req })
        {
            try
            {
                await ApiClient.CreateRecurringFlowAsync(req);
                Snackbar.Add("Flow created", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to create recurring flow");
                Snackbar.Add(ex is FlowLedger.Web.ApiClient.ApiClientException ? ex.Message : "Couldn't create flow. Please try again.", Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(FlowLedger.Web.ApiClient.RecurringFlowDto flow)
    {
        var dialog = await DialogService.ShowAsync<RecurringFlowFormDialog>("Edit Recurring Flow",
            new DialogParameters<RecurringFlowFormDialog>
            {
                { x => x.Flow, flow },
                { x => x.Accounts, _accounts }
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FlowLedger.Web.ApiClient.UpdateRecurringFlowRequest updateReq })
        {
            try
            {
                await ApiClient.UpdateRecurringFlowAsync(flow.Id, updateReq);
                Snackbar.Add("Flow updated", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to update recurring flow {FlowId}", flow.Id);
                Snackbar.Add(ex is FlowLedger.Web.ApiClient.ApiClientException ? ex.Message : "Couldn't update flow. Please try again.", Severity.Error);
            }
        }
    }

    private async Task DeleteFlow(FlowLedger.Web.ApiClient.RecurringFlowDto flow)
    {
        var options = new DialogOptions { CloseButton = true };
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Delete '{flow.Name}'? This cannot be undone." },
            { x => x.ConfirmText, "Delete" }
        };
        var confirmDialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Flow", parameters, options);
        var confirmResult = await confirmDialog.Result;
        if (confirmResult is { Canceled: false })
        {
            try
            {
                await ApiClient.DeleteRecurringFlowAsync(flow.Id);
                Snackbar.Add("Flow deleted", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to delete recurring flow {FlowId}", flow.Id);
                Snackbar.Add(ex is FlowLedger.Web.ApiClient.ApiClientException ? ex.Message : "Couldn't delete flow. Please try again.", Severity.Error);
            }
        }
    }

    private static string DescribeSchedule(FlowLedger.Web.ApiClient.RecurringFlowDto flow)
    {
        return flow.RecurrenceFrequency switch
        {
            "Monthly" when flow.DayOfMonth.HasValue => $"On the {flow.DayOfMonth}{OrdinalSuffix(flow.DayOfMonth.Value)}",
            "Monthly" => "Monthly",
            "Weekly" when flow.AnchorDayOfWeek is not null => $"Every {flow.AnchorDayOfWeek}",
            "Weekly" => "Weekly",
            "BiWeekly" when flow.IntervalWeeks.HasValue => $"Every {flow.IntervalWeeks} weeks",
            "Daily" => "Daily",
            _ => flow.RecurrenceFrequency
        };
    }

    private static string OrdinalSuffix(int day)
    {
        // Handle teens (11th, 12th, 13th) first — they never take 1st/2nd/3rd.
        int lastTwo = day % 100;
        if (lastTwo is >= 11 and <= 13)
        {
            return "th";
        }
        return (day % 10) switch
        {
            1 => "st",
            2 => "nd",
            3 => "rd",
            _ => "th"
        };
    }
}
