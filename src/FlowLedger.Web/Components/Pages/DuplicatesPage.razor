@page "/duplicates"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Duplicates — FlowLedger</PageTitle>

<PageHeader Title="Duplicate transactions" />
<MudText Typo="Typo.body2" Class="mb-4 fl-muted">
    The same purchase can arrive twice, for example a CSV import that overlaps what your bank already synced, or a pending charge
    that never settled. Unambiguous pairs are merged automatically after every sync and import; anything that could be two real
    purchases is listed here for you to decide. A merge keeps your category, notes and splits, and the removed row can never be
    re-synced.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_scan is null || _scan.Total == 0)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">No duplicates found.</MudAlert>
}
else
{
    <div class="d-flex align-center gap-3 mb-3 flex-wrap">
        <MudText>@_scan.Total suspected pair(s); @_scan.AutoMergeable safe to merge automatically.</MudText>
        @if (_scan.AutoMergeable > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AutoMerge" Disabled="_busy">Merge the @_scan.AutoMergeable safe pair(s)</MudButton>
        }
    </div>

    @foreach (var s in _scan.Suggestions)
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <div class="d-flex align-center gap-2 mb-1 flex-wrap">
                <MudChip T="string" Size="Size.Small" Color="@(s.Confidence == "High" ? Color.Success : Color.Warning)">@s.Confidence</MudChip>
                <MudText Typo="Typo.caption" Class="fl-muted">@s.Reason@(s.DaysApart > 0 ? $" · {s.DaysApart} day(s) apart" : "")</MudText>
            </div>
            <div class="d-flex gap-4 flex-wrap">
                @Side("Keep", s.Keep)
                @Side("Remove", s.Remove)
            </div>
            <div class="d-flex gap-2 mt-2">
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                           OnClick="@(() => Merge(s.Keep.Id, s.Remove.Id))">Merge</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy"
                           OnClick="@(() => Dismiss(s.Keep.Id, s.Remove.Id))">Not a duplicate</MudButton>
            </div>
        </MudPaper>
    }
}

@code {
    private FlowLedger.Web.ApiClient.DuplicateScanDto? _scan;
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _scan = await ApiClient.ScanDuplicatesAsync();
        _loading = false;
    }

    private RenderFragment Side(string label, FlowLedger.Contracts.DuplicateSideDto t) => __builder =>
    {
        <div style="min-width:min(280px,100%)">
            <MudText Typo="Typo.overline">@label</MudText>
            <MudText><strong>@t.Description</strong></MudText>
            <MudText Typo="Typo.body2" Class="fl-muted">
                @t.EffectiveDate.ToString("yyyy-MM-dd") · @t.Amount.ToString("C") · @t.Status · @(t.BankSynced ? "bank-synced" : "imported/manual")@(t.CategoryId is null ? "" : " · categorized (" + t.CategorySource + ")")
            </MudText>
        </div>
    };

    private async Task Run(Func<Task> action, string ok)
    {
        _busy = true;
        try
        {
            await action();
            Snackbar.Add(ok, Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.AddFailure(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Merge(Guid keep, Guid remove)
    {
        if (!await DialogService.ConfirmAsync("Merge duplicates", "Merge these transactions? The duplicate is removed and cannot be restored.", "Merge"))
        {
            return;
        }

        await Run(() => ApiClient.MergeDuplicateAsync(keep, remove), "Merged.");
    }

    private Task Dismiss(Guid a, Guid b) => Run(() => ApiClient.DismissDuplicateAsync(a, b), "Marked as separate transactions.");

    private Task AutoMerge() => Run(async () => { await ApiClient.AutoMergeDuplicatesAsync(); }, "Merged.");
}
