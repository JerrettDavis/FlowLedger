@page "/Error"
@using System.Diagnostics
@inject NavigationManager Navigation

<PageTitle>Something went wrong</PageTitle>

<StatusMessage Icon="@Icons.Material.Filled.ErrorOutline" IconColor="Color.Error"
               Title="Something went wrong"
               Description="We couldn't complete that request. It's been logged. Try again, or head back to the dashboard.">
    <ChildContent>
        @if (ShowRequestId)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Request ID: <code>@RequestId</code></MudText>
        }
    </ChildContent>
    <Actions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Retry">Try again</MudButton>
    </Actions>
</StatusMessage>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    private void Retry() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
