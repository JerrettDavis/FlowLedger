@page "/sheet"
@rendermode InteractiveServer
@using FlowLedger.Web.ApiClient
@inject FlowLedgerApiClient ApiClient
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<SheetPage> Logger

<PageTitle>Sheet — FlowLedger</PageTitle>

<div class="d-flex align-center justify-space-between mb-4 fl-enter" style="flex-wrap:wrap;gap:8px">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1" tabindex="-1">Sheet</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Your bill sheet. Cells tick themselves when a matching payment syncs; click a cell to override.
        </MudText>
    </div>
    <div class="d-flex align-center" style="gap:8px;flex-wrap:wrap">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="() => ShiftAsync(-1)" aria-label="Previous month" />
        <MudText Typo="Typo.subtitle1" Class="fl-num" aria-live="polite">@MonthTitle(_selected)</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="() => ShiftAsync(1)" aria-label="Next month" />
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="GoToTodayAsync" Disabled="@(_selected == CurrentMonth)" aria-label="Jump to this month">This month</MudButton>
        <MudSelect T="int" Value="_monthCount" ValueChanged="SetMonthCountAsync" Label="Months shown" Dense="true" Variant="Variant.Outlined" Style="width:min(130px,100%)" aria-label="Months shown">
            <MudSelectItem T="int" Value="3">3 (prev · this · next)</MudSelectItem>
            <MudSelectItem T="int" Value="6">6</MudSelectItem>
            <MudSelectItem T="int" Value="12">12</MudSelectItem>
        </MudSelect>
        <MudButton StartIcon="@Icons.Material.Filled.Sync" Variant="Variant.Outlined" Color="Color.Primary"
                   OnClick="RefreshAsync" Disabled="_busy" aria-label="Check transactions and tick paid rows">Update from payments</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="() => EditAsync(null, null)" aria-label="Add a row">Add row</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.UploadFile" Variant="Variant.Text"
                   OnClick="ImportAsync" aria-label="Import from CSV">Import</MudButton>
    </div>
</div>

@if (_loading)
{
    <CardSkeleton Height="40px" Count="8" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (!_loading && _error is null && (_view is null || _view.Sections.Count == 0))
{
    <EmptyState Icon="@Icons.Material.Outlined.TableChart"
                Title="Your sheet is empty"
                Description="Add a row, or import the CSV export of your budget workbook to start from what you already track." />
}

@if (_view is { Sections.Count: > 0 })
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudCard Class="fl-card-hover"><MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Paid in @MonthTitle(_selected)</MudText>
                <MudText Typo="Typo.h5" Class="fl-num">@_view.Summary.PaidCount of @_view.Summary.TotalCount</MudText>
                <MudProgressLinear Value="@PaidPercent" Color="Color.Success" Class="mt-2" aria-label="Share of rows paid" />
            </MudCardContent></MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Class="fl-card-hover"><MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Paid so far</MudText>
                <MudText Typo="Typo.h5" Class="fl-num">@Format.Money(_view.Summary.PaidAmount)</MudText>
            </MudCardContent></MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Class="fl-card-hover"><MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Still to pay (estimated)</MudText>
                <MudText Typo="Typo.h5" Class="fl-num">@Format.Money(_view.Summary.RemainingEstimated)</MudText>
            </MudCardContent></MudCard>
        </MudItem>
    </MudGrid>

    <div class="fl-sheet-wrap">
        <table class="fl-sheet" aria-label="Bill sheet">
            <thead>
                <tr>
                    <th scope="col" class="fl-sheet-name" aria-sort="@AriaSort("name")"><button class="fl-sheet-sort" @onclick='() => SortBy("name")'>Bill@(SortArrow("name"))</button></th>
                    <th scope="col" class="fl-hide-lg" aria-sort="@AriaSort("payer")"><button class="fl-sheet-sort" @onclick='() => SortBy("payer")'>Payer@(SortArrow("payer"))</button></th>
                    <th scope="col" class="fl-hide-md" title="Debt · Perpetual · Optional · Business" aria-sort="@AriaSort("flags")"><button class="fl-sheet-sort" @onclick='() => SortBy("flags")'>Flags@(SortArrow("flags"))</button></th>
                    <th scope="col" class="fl-hide-lg" aria-sort="@AriaSort("pay")"><button class="fl-sheet-sort" @onclick='() => SortBy("pay")'>Pay@(SortArrow("pay"))</button></th>
                    <th scope="col" class="num" title="Bills that pay more than once a month stay at the bottom" aria-sort="@AriaSort("due")"><button class="fl-sheet-sort" @onclick='() => SortBy("due")'>Due@(SortArrow("due"))</button></th>
                    <th scope="col" class="num" aria-sort="@AriaSort("est")"><button class="fl-sheet-sort" @onclick='() => SortBy("est")'>Estimated@(SortArrow("est"))</button></th>
                    <th scope="col" class="num" aria-sort="@AriaSort("actual")"><button class="fl-sheet-sort" @onclick='() => SortBy("actual")'>Actual@(SortArrow("actual"))</button></th>
                    @foreach (var m in _view.Months)
                    {
                        <th scope="col" class="@(m == _view.SelectedMonth ? "fl-sheet-cur" : null)">@ShortMonth(m)</th>
                    }
                </tr>
            </thead>
            @foreach (var section in _view.Sections)
            {
                <tbody>
                    <tr class="fl-sheet-section"><th colspan="@(7 + _view.Months.Count)" scope="colgroup">@section.Name</th></tr>
                    @foreach (var row in Sorted(section.Rows))
                    {
                        <tr>
                            <th scope="row" class="fl-sheet-name">
                                <button class="fl-sheet-link" title="@row.Name" @onclick="() => EditAsync(row, section.Name)" aria-label="@($"Edit {row.Name}")">@row.Name</button>
                                @if (!string.IsNullOrWhiteSpace(row.Service))
                                {
                                    <span class="fl-sheet-sub">@row.Service</span>
                                }
                                @if (row.NeedsMatchText)
                                {
                                    <span class="fl-sheet-sub fl-sheet-hint" title="No payment has matched this row yet. Open it and set match text (words from the bank description).">not matching yet · set match text</span>
                                }
                            </th>
                            <td class="fl-hide-lg">@row.Payer</td>
                            <td class="fl-sheet-flags fl-hide-md">@Flags(row)</td>
                            <td class="fl-hide-lg">@(row.AutoPay ? "Auto" : "Manual")</td>
                            <td class="num">@DueText(row)</td>
                            <td class="num fl-num">
                                @Format.Money(MonthlyEstimated(row))
                                @if (SlotCount(row) > 1)
                                {
                                    <span class="fl-sheet-sub">@Format.Money(row.Estimated) × @SlotCount(row)</span>
                                }
                            </td>
                            <td class="num fl-num">@Format.Money(ActualFor(row))</td>
                            @foreach (var m in _view.Months)
                            {
                                var cell = row.Cells.GetValueOrDefault(m);
                                var slots = row.Slots?.GetValueOrDefault(m);
                                <td class="fl-sheet-cellwrap @(m == _view.SelectedMonth ? "fl-sheet-cur" : null)">
                                @if (slots is { Count: > 1 })
                                {
                                    @* A bill that repeats inside the month shows once per date. *@
                                    <div class="d-flex flex-column" style="gap:2px">
                                    @foreach (var slot in slots)
                                    {
                                        var slotLate = IsSlotLate(slot);
                                        <button class="fl-sheet-cell @(slot.Paid ? "paid" : slotLate ? "late" : null)"
                                                aria-pressed="@(slot.Paid ? "true" : "false")"
                                                aria-label="@SlotLabel(row, m, slot, slotLate)"
                                                title="@SlotTitle(slot)"
                                                @onclick="() => ToggleSlotAsync(row, m, slot)">
                                            @(slot.Due is { } due ? Format.DayMonth(due) : "—") @(slot.Paid ? (slot.Source == "Auto" ? "✓ auto" : "✓") : slotLate ? "!" : "·")
                                        </button>
                                    }
                                    </div>
                                }
                                else
                                {
                                    var late = IsLate(row, m, cell);
                                    <button class="fl-sheet-cell @(cell?.Paid == true ? "paid" : late ? "late" : null)"
                                            aria-pressed="@(cell?.Paid == true ? "true" : "false")"
                                            aria-label="@CellLabel(row, m, cell, late)"
                                            title="@CellTitle(cell)"
                                            @onclick="() => ToggleAsync(row, m, cell)">
                                        @(cell?.Paid == true ? (cell.Source == "Auto" ? "✓ auto" : "✓") : late ? "!" : "·")
                                    </button>
                                }
                                </td>
                            }
                        </tr>
                    }
                    @foreach (var (label, est, act) in TotalLines(section.Totals))
                    {
                        <tr class="fl-sheet-total">
                            <th scope="row" class="fl-sheet-name">@label</th><td class="fl-hide-lg"></td><td class="fl-hide-md"></td><td class="fl-hide-lg"></td><td></td>
                            <td class="num fl-num">@Format.Money(est)</td>
                            <td class="num fl-num">@Format.Money(act)</td>
                            <td colspan="@_view.Months.Count"></td>
                        </tr>
                    }
                </tbody>
            }
            <tfoot>
                <tr class="fl-sheet-grand">
                    <th scope="row" class="fl-sheet-name">Grand total</th><td class="fl-hide-lg"></td><td class="fl-hide-md"></td><td class="fl-hide-lg"></td><td></td>
                    <td class="num fl-num">@Format.Money(_view.GrandTotals.Estimated.Total)</td>
                    <td class="num fl-num">@Format.Money(_view.GrandTotals.Actual.Total)</td>
                    <td colspan="@_view.Months.Count"></td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    private SheetViewDto? _view;
    private static DateOnly CurrentMonth => FirstOfMonth(DateOnly.FromDateTime(DateTime.Today));
    private DateOnly _selected = CurrentMonth;
    // Default window: last month, this month and next month, so the current month is always in view. More can be chosen.
    private int _monthCount = 3;
    private bool _focusPending = true;
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    // ── Column sorting (view-only; the stored order is untouched) ──────────────────────
    private string? _sortKey;
    private bool _sortDesc;

    private void SortBy(string key)
    {
        // asc -> desc -> back to the sheet's own order
        if (_sortKey != key) { _sortKey = key; _sortDesc = false; }
        else if (!_sortDesc) { _sortDesc = true; }
        else { _sortKey = null; _sortDesc = false; }
    }

    private string AriaSort(string key) => _sortKey != key ? "none" : _sortDesc ? "descending" : "ascending";

    private MarkupString SortArrow(string key) =>
        new(_sortKey != key ? "" : _sortDesc ? " <span aria-hidden=\"true\">▼</span>" : " <span aria-hidden=\"true\">▲</span>");

    /// <summary>Weekly, every-other-week and twice-monthly bills (or any row with several dates this month) pay more than once a month.</summary>
    private bool IsMultiPayment(SheetRowDto row) => row.Frequency != "Monthly" || SlotCount(row) > 1;

    private IEnumerable<SheetRowDto> Sorted(List<SheetRowDto> rows)
    {
        if (_sortKey is null) return rows;

        decimal Num(SheetRowDto r) => _sortKey == "est" ? MonthlyEstimated(r) : ActualFor(r);
        var cmp = StringComparer.OrdinalIgnoreCase;

        // Sorting by due day keeps multi-payment bills grouped at the bottom whichever way the sort runs; "Flux" (no fixed
        // day) sits between them and the dated bills.
        if (_sortKey == "due")
        {
            var ordered = rows
                .OrderBy(r => IsMultiPayment(r) ? 2 : r.DueDay is null ? 1 : 0)
                .ThenBy(r => _sortDesc ? 0 : r.DueDay ?? 0)
                .ThenByDescending(r => _sortDesc ? r.DueDay ?? 0 : 0)
                .ThenBy(r => r.Name, cmp);
            return ordered;
        }

        IOrderedEnumerable<SheetRowDto> by = _sortKey switch
        {
            "name" => _sortDesc ? rows.OrderByDescending(r => r.Name, cmp) : rows.OrderBy(r => r.Name, cmp),
            "payer" => _sortDesc ? rows.OrderByDescending(r => r.Payer ?? "", cmp) : rows.OrderBy(r => r.Payer ?? "", cmp),
            "flags" => _sortDesc ? rows.OrderByDescending(r => Flags(r), cmp) : rows.OrderBy(r => Flags(r), cmp),
            "pay" => _sortDesc ? rows.OrderByDescending(r => r.AutoPay) : rows.OrderBy(r => r.AutoPay),
            _ => _sortDesc ? rows.OrderByDescending(Num) : rows.OrderBy(Num),
        };
        return by.ThenBy(r => r.Name, cmp);
    }

    private double PaidPercent => _view is { Summary.TotalCount: > 0 } ? 100.0 * _view.Summary.PaidCount / _view.Summary.TotalCount : 0;

    protected override async Task OnInitializedAsync()
    {
        // Backstop for the sync/import hooks: tick anything that has been paid since the last visit.
        try { await ApiClient.RefreshSheetAsync(); }
        catch (ApiClientException ex) { Logger.LogWarning(ex, "Sheet refresh on load failed"); }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _view = await ApiClient.GetSheetAsync(_selected.ToString("yyyy-MM"), _monthCount, ahead: 1);
        }
        catch (ApiClientException ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Failed to load sheet");
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && _view is not null)
        {
            _focusPending = false;
            try { await JS.InvokeVoidAsync("flowledgerFocusCurrentMonth"); }
            catch (JSException) { /* purely cosmetic */ }
            catch (InvalidOperationException) { }
        }
    }

    private async Task GoToTodayAsync()
    {
        _selected = CurrentMonth;
        _focusPending = true;
        await LoadAsync();
    }

    private async Task SetMonthCountAsync(int count)
    {
        _monthCount = count;
        _focusPending = true;
        await LoadAsync();
    }

    private async Task ShiftAsync(int months)
    {
        _selected = _selected.AddMonths(months);
        await LoadAsync();
    }

    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            var r = await ApiClient.RefreshSheetAsync();
            Snackbar.Add(r is { Marked: > 0 } or { Cleared: > 0 } or { Added: > 0 }
                ? $"Updated: {r.Marked} ticked, {r.Cleared} cleared, {r.Added} new row(s) detected."
                : "Already up to date.", Severity.Info);
            await LoadAsync();
        }
        catch (ApiClientException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleAsync(SheetRowDto row, string month, SheetCellDto? cell)
    {
        try
        {
            // auto tick -> manual "not paid" -> manual tick -> back to automatic
            if (cell is { Paid: true, Source: "Manual" })
                await ApiClient.ClearSheetPaymentAsync(row.Id, month);
            else if (cell is { Paid: true, Source: "Auto" })
                await ApiClient.SetSheetPaymentAsync(row.Id, month, paid: false);
            else
                await ApiClient.SetSheetPaymentAsync(row.Id, month, paid: true);
            await LoadAsync();
        }
        catch (ApiClientException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ToggleSlotAsync(SheetRowDto row, string month, SheetSlotDto slot)
    {
        try
        {
            // Same cycle as a single cell, but per payment: auto tick -> manual "not paid" -> manual tick -> automatic.
            if (slot is { Paid: true, Source: "Manual" })
                await ApiClient.ClearSheetPaymentAsync(row.Id, month, slot.Slot);
            else if (slot is { Paid: true, Source: "Auto" })
                await ApiClient.SetSheetPaymentAsync(row.Id, month, paid: false, slot: slot.Slot);
            else
                await ApiClient.SetSheetPaymentAsync(row.Id, month, paid: true, slot: slot.Slot);
            await LoadAsync();
        }
        catch (ApiClientException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static bool IsSlotLate(SheetSlotDto slot) =>
        !slot.Paid && slot.Due is { } due && due < DateOnly.FromDateTime(DateTime.Today);

    private static string SlotLabel(SheetRowDto row, string month, SheetSlotDto slot, bool late) =>
        $"{row.Name}, {(slot.Due is { } d ? Format.DayMonth(d) : ShortMonth(month))}: {(slot.Paid ? "paid" : late ? "overdue, not marked paid" : "not paid")}. Activate to {(slot.Paid ? "mark unpaid" : "mark paid")}.";

    private static string? SlotTitle(SheetSlotDto slot) =>
        slot.Paid
            ? $"{(slot.Source == "Auto" ? "Matched payment" : "Marked by you")}{(slot.Amount is { } a ? $" · {Format.Money(a)}" : "")}{(slot.PaidOn is { } d ? $" · {Format.DayMonth(d)}" : "")}"
            : null;

    private async Task EditAsync(SheetRowDto? row, string? section)
    {
        var sections = _view?.Sections.Select(s => s.Name).ToList() ?? [];
        if (!sections.Contains("Bills")) sections.Insert(0, "Bills");
        var dialog = await DialogService.ShowAsync<SheetBillDialog>(row is null ? "Add row" : "Edit row",
            new DialogParameters<SheetBillDialog>
            {
                { x => x.Row, row }, { x => x.RowSection, section }, { x => x.Sections, sections },
            }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false }) return;
        try
        {
            switch (result.Data)
            {
                case SaveBillRequest req:
                    await ApiClient.SaveSheetBillAsync(row?.Id, req);
                    break;
                case string s when s == SheetBillDialog.DeleteResult && row is not null:
                    await ApiClient.DeleteSheetBillAsync(row.Id);
                    break;
            }
            await LoadAsync();
        }
        catch (ApiClientException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ImportAsync()
    {
        var dialog = await DialogService.ShowAsync<SheetImportDialog>("Import",
            new DialogParameters<SheetImportDialog> { { x => x.HasExisting, _view is { Sections.Count: > 0 } } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: SheetImportResult r })
        {
            Snackbar.Add($"Imported {r.Bills} rows in {r.Sections} section(s), {r.PaidMarks} paid marks.", Severity.Success);
            await RefreshAsync();
        }
    }

    // ── Display helpers ──────────────────────────────────────────────────────

    private static DateOnly FirstOfMonth(DateOnly d) => new(d.Year, d.Month, 1);

    private static string MonthTitle(DateOnly d) => d.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    private static string ShortMonth(string key) =>
        DateOnly.ParseExact(key + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
            .ToString("MMM yy", System.Globalization.CultureInfo.InvariantCulture);

    private int SlotCount(SheetRowDto row) =>
        _view is not null && row.Slots?.GetValueOrDefault(_view.SelectedMonth) is { Count: > 1 } s ? s.Count : 1;

    private decimal MonthlyEstimated(SheetRowDto row) => row.Estimated * SlotCount(row);

    /// <summary>The "Actual Cost" column for the selected month: paid amounts plus the expected amount for each payment still due.</summary>
    private decimal ActualFor(SheetRowDto row)
    {
        if (_view is null) return row.Actual ?? row.Estimated;
        if (row.Slots?.GetValueOrDefault(_view.SelectedMonth) is { Count: > 1 } slots)
            return slots.Sum(s => s.Paid && s.Amount is { } a ? a : row.Actual ?? row.Estimated);
        return row.Cells.GetValueOrDefault(_view.SelectedMonth) is { Paid: true, Amount: { } p } ? p : row.Actual ?? row.Estimated;
    }

    private static string DueText(SheetRowDto row) => row.Frequency switch
    {
        "Weekly" when row.AnchorDate is { } a => $"Weekly · {a.DayOfWeek.ToString()[..3]}",
        "EveryNWeeks" when row.AnchorDate is { } a => $"Every {row.IntervalWeeks} wks · {a.DayOfWeek.ToString()[..3]}",
        "TwiceMonthly" => $"{row.DueDay} & {row.SecondDueDay}",
        _ => row.DueDay?.ToString() ?? "Flux",
    };

    private static string Flags(SheetRowDto r) =>
        string.Concat(r.IsDebt ? "D" : "", r.IsPerpetual ? "P" : "", r.IsOptional ? "O" : "", r.IsBusiness ? "B" : "");

    /// <summary>A row is late when its due day has passed this calendar month and nothing marks it paid.</summary>
    private static bool IsLate(SheetRowDto row, string month, SheetCellDto? cell)
    {
        if (cell is not null || row.DueDay is not { } due) return false;
        var today = DateOnly.FromDateTime(DateTime.Today);
        return month == today.ToString("yyyy-MM") && due < today.Day;
    }

    private static string CellLabel(SheetRowDto row, string month, SheetCellDto? cell, bool late) =>
        $"{row.Name}, {ShortMonth(month)}: {(cell?.Paid == true ? "paid" : late ? "overdue, not marked paid" : "not paid")}. Activate to {(cell?.Paid == true ? "mark unpaid" : "mark paid")}.";

    private static string? CellTitle(SheetCellDto? cell) =>
        cell?.Paid == true
            ? $"{(cell.Source == "Auto" ? "Matched payment" : "Marked by you")}{(cell.Amount is { } a ? $" · {Format.Money(a)}" : "")}{(cell.PaidOn is { } d ? $" · {Format.DayMonth(d)}" : "")}"
            : null;

    private static IEnumerable<(string Label, decimal Est, decimal Act)> TotalLines(SheetTotalsDto t)
    {
        yield return ("Total", t.Estimated.Total, t.Actual.Total);
        yield return ("Total optional", t.Estimated.Optional, t.Actual.Optional);
        yield return ("Total required", t.Estimated.Required, t.Actual.Required);
        yield return ("Total personal", t.Estimated.Personal, t.Actual.Personal);
        yield return ("Total business", t.Estimated.Business, t.Actual.Business);
    }
}
