@page "/forecasts"
@inject FlowLedger.Web.ApiClient.FlowLedgerApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILogger<Forecasts> Logger

<PageTitle>Forecasts — FlowLedger</PageTitle>

<div class="d-flex align-center justify-space-between mb-4" style="flex-wrap:wrap;gap:8px">
    <MudText Typo="Typo.h4" HtmlTag="h1" tabindex="-1">Forecasts</MudText>
    <div class="d-flex align-center" style="gap:8px">
        <MudSelect T="Guid" MultiSelection="true" SelectedValues="@_selectedIds" SelectedValuesChanged="OnAccountsChanged"
                   Label="Accounts" Style="width:min(220px,100%)" Clearable="true"
                   MultiSelectionTextFunc="@(v => _selectedIds.Count() == 0 ? "Liquid accounts" : $"{_selectedIds.Count()} account(s)")"
                   aria-label="Accounts to include in forecast">
            @foreach (var acct in _accounts)
            {
                <MudSelectItem T="Guid" Value="@acct.Id">@acct.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect @bind-Value="_horizonMonths" Label="Horizon" Style="width:min(140px,100%)"
                   aria-label="Forecast horizon in months">
            <MudSelectItem Value="1">1 month</MudSelectItem>
            <MudSelectItem Value="3">3 months</MudSelectItem>
            <MudSelectItem Value="6">6 months</MudSelectItem>
            <MudSelectItem Value="12">12 months</MudSelectItem>
        </MudSelect>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh"
                   Color="Color.Primary"
                   Variant="Variant.Outlined"
                   OnClick="LoadAsync"
                   aria-label="Run forecast">
            Run Forecast
        </MudButton>
    </div>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">@_error</MudAlert>
}

@if (_loading)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3"><CardSkeleton Height="110px" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><CardSkeleton Height="110px" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><CardSkeleton Height="110px" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><CardSkeleton Height="110px" /></MudItem>
    </MudGrid>
    <CardSkeleton Height="260px" />
}
else if (_forecast is not null)
{
    <!-- Summary row -->
    <MudGrid Class="mb-4">
        <!-- Hero: Aggregate Low -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="fl-hero fl-card-hover fl-enter fl-enter-1">
                <MudCardContent>
                    <MudText Typo="Typo.overline">Aggregate Low</MudText>
                    <MudText Typo="Typo.h3" Class="fl-num"
                             Color="@(_forecast.AggregateLowWaterMark?.MinBalanceAmount < 0 ? Color.Error : Color.Default)"
                             aria-label="Aggregate low water mark">
                        @Format.Money(_forecast.AggregateLowWaterMark?.MinBalanceAmount ?? 0)
                    </MudText>
                    <MudText Typo="Typo.caption">
                        @(_forecast.AggregateLowWaterMark is not null
                            ? Format.FullDate(_forecast.AggregateLowWaterMark.Date)
                            : "–")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Overdraft Risk -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="fl-card-hover fl-enter fl-enter-2">
                <MudCardContent>
                    <MudText Typo="Typo.overline">Overdraft Risk</MudText>
                    <div class="d-flex align-center" style="gap:8px">
                        <MudText Typo="Typo.h5" Class="fl-num"
                                 Color="@(_forecast.OverdraftWarnings.Count > 0 ? Color.Error : Color.Success)">
                            @(_forecast.OverdraftWarnings.Count > 0
                                ? $"{_forecast.OverdraftWarnings.Count} warning{(_forecast.OverdraftWarnings.Count == 1 ? "" : "s")}"
                                : "None")
                        </MudText>
                        @if (_forecast.OverdraftWarnings.Count > 0)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Warning" Color="Color.Error" Size="Size.Small" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Horizon -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="fl-card-hover fl-enter fl-enter-3">
                <MudCardContent>
                    <MudText Typo="Typo.overline">Horizon</MudText>
                    <MudText Typo="Typo.h5" Class="fl-num">
                        @Format.DayMonth(_forecast.HorizonStart)
                    </MudText>
                    <MudText Typo="Typo.caption">
                        → @Format.FullDate(_forecast.HorizonEnd)
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Accounts -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="fl-card-hover fl-enter fl-enter-4">
                <MudCardContent>
                    <MudText Typo="Typo.overline">Accounts</MudText>
                    <MudText Typo="Typo.h5" Class="fl-num">@_forecast.AccountSeries.Count</MudText>
                    <MudText Typo="Typo.caption">forecasted</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (_forecast.Warnings.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" aria-live="polite" data-testid="forecast-warnings">
            @foreach (var warning in _forecast.Warnings)
            {
                <MudText Typo="Typo.body2">@warning</MudText>
            }
        </MudAlert>
    }

    <!-- Overdraft warnings -->
    @if (_forecast.OverdraftWarnings.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" aria-live="assertive">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Overdraft Risk</MudText>
            @foreach (var w in _forecast.OverdraftWarnings)
            {
                var acct = _accounts.FirstOrDefault(a => a.Id == w.AccountId);
                <MudText Typo="Typo.body2">
                    @(acct?.Name ?? w.AccountId.ToString()): projected balance
                    @Format.Money(w.ProjectedBalanceAmount) on @Format.FullDate(w.FirstBreachDate)
                </MudText>
            }
        </MudAlert>
    }

    <!-- View mode -->
    <MudToggleGroup T="string" Value="_view" ValueChanged="OnViewChanged" Class="mb-4" Color="Color.Primary" aria-label="Forecast view">
        <MudToggleItem Value="@("aggregate")" Text="Aggregate" />
        <MudToggleItem Value="@("accounts")" Text="By account" />
    </MudToggleGroup>

    @if (_view == "aggregate")
    {
        <MudCard Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Aggregate (Household) Balance</MudText>
                    <MudText Typo="Typo.caption">@(_selectedIds.Count() == 0 ? "Liquid accounts" : $"{_selectedIds.Count()} selected account(s)")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (_forecast.AggregateSeries.Count > 0)
                {
                    <div style="max-width:900px;margin:0 auto">
                    <ChartFigure Title="Aggregate balance projection" Summary="@BalanceSummary("Aggregate balance", _forecast.AggregateSeries.Select(p => (p.Date, p.BalanceAmount)).ToList())">
                        @SvgChart.BuildBalanceProjection(
                            _forecast.AggregateSeries.Select(p => (p.Date, p.BalanceAmount)).ToList(),
                            zeroLine: 0m,
                            breaches: _forecast.OverdraftWarnings.Select(w => w.FirstBreachDate).ToList(),
                            lowWaterMark: _forecast.AggregateLowWaterMark is not null
                                ? (_forecast.AggregateLowWaterMark.Date, _forecast.AggregateLowWaterMark.MinBalanceAmount)
                                : null)
                    </ChartFigure>
                    </div>
                }
            </MudCardContent>
        </MudCard>

        @if (_forecast.Bands.Count > 0)
        {
            var endBand = _forecast.Bands[^1];
            <MudCard Class="mb-4">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">With everyday spending</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        The schedule above only counts bills and income. You also spend about
                        <strong class="fl-num">@Format.Money(_forecast.TypicalWeeklySpend)</strong> a week on everything else (including credit card payments)
                        (±<span class="fl-num">@Format.Money(_forecast.WeeklySpendStdDev)</span>, from the last @_forecast.SpendHistoryWeeks weeks).
                    </MudText>
                    <MudText Typo="Typo.body1">
                        By @Format.FullDate(endBand.Date): expected <strong class="fl-num">@Format.Money(endBand.Expected)</strong>,
                        80% likely between <span class="fl-num">@Format.Money(endBand.Low)</span> and <span class="fl-num">@Format.Money(endBand.High)</span>.
                    </MudText>
                </MudCardContent>
            </MudCard>
        }

        <MudCard Class="mb-4">
            <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Projected line items</MudText></CardHeaderContent></MudCardHeader>
            <MudCardContent>
                @{ var aggRows = AggregateRows(); }
                @if (aggRows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No projected activity in this horizon.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Class="fl-stack">
                        <thead><tr><th>Date</th><th class="fl-hide-lg">Account</th><th>Item</th><th style="text-align:right">Amount</th><th style="text-align:right">Total balance</th></tr></thead>
                        <tbody>
                        @foreach (var g in aggRows)
                        {
                            var first = true;
                            @foreach (var r in g.Items)
                            {
                                var isFirst = first;
                                <tr>
                                    <td>@(first ? Format.FullDate(g.Date) : "")</td>
                                    <td class="fl-hide-lg">@AccountName(r.AccountId)</td>
                                    <td>@r.Item.Label @if (r.Item.IsActual) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text">posted</MudChip> }</td>
                                    <td style="text-align:right" class="fl-num"><MudText Typo="Typo.body2" Color="@(r.Item.BalanceDeltaAmount >= 0 ? Color.Success : Color.Error)">@Format.Signed(r.Item.BalanceDeltaAmount)</MudText></td>
                                    <td data-label="Balance" style="text-align:right" class="fl-num">@(isFirst ? Format.Money(g.Balance) : "")</td>
                                </tr>
                                first = false;
                            }
                        }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudCardContent>
        </MudCard>
    }
    else
    {
        @foreach (var series in _forecast.AccountSeries)
        {
            var account = _accounts.FirstOrDefault(a => a.Id == series.AccountId);
            var lwm = _forecast.LowWaterMarks.FirstOrDefault(l => l.AccountId == series.AccountId);
            var chartPts = new List<(DateOnly, decimal)> { (_forecast.HorizonStart, series.StartingBalanceAmount) };
            chartPts.AddRange(series.Points.Select(p => (p.Date, p.BalanceAmount)));
            chartPts.Add((_forecast.HorizonEnd, series.Points.Count > 0 ? series.Points[^1].BalanceAmount : series.StartingBalanceAmount));

            <MudExpansionPanels Class="mb-2" MultiExpansion="true">
              <MudExpansionPanel Expanded="true"
                               Text="@($"{account?.Name ?? series.AccountId.ToString()} — start {Format.Money(series.StartingBalanceAmount)}, low {Format.Money(lwm?.MinBalanceAmount ?? series.StartingBalanceAmount)}")"
                               Dense="true">
                @if (chartPts.Count >= 2)
                {
                    <div style="max-width:900px;margin:0 auto">
                    <ChartFigure Title="@($"{account?.Name} balance projection")" Summary="@BalanceSummary($"{account?.Name} balance", chartPts)">
                        @SvgChart.BuildBalanceProjection(chartPts, zeroLine: 0m,
                            breaches: _forecast.OverdraftWarnings.Where(w => w.AccountId == series.AccountId).Select(w => w.FirstBreachDate).ToList(),
                            lowWaterMark: lwm is not null ? (lwm.Date, lwm.MinBalanceAmount) : null)
                    </ChartFigure>
                    </div>
                }
                @if (series.Points.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Nothing is projected for this account: no recurring flows or upcoming transactions are recorded. Balance holds at @Format.Money(series.StartingBalanceAmount). Add a recurring flow to project income or bills here.
                    </MudText>
                }
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead><tr><th>Date</th><th>Item</th><th style="text-align:right">Amount</th><th style="text-align:right">Balance</th></tr></thead>
                        <tbody>
                        <tr><td>@Format.FullDate(_forecast.AsOf)</td><td>Starting balance</td><td></td><td style="text-align:right" class="fl-num">@Format.Money(series.StartingBalanceAmount)</td></tr>
                        @foreach (var p in series.Points)
                        {
                            var first = true;
                            @foreach (var i in p.ContributingItems)
                            {
                                var isFirst = first;
                                <tr>
                                    <td>@(first ? Format.FullDate(p.Date) : "")</td>
                                    <td>@i.Label @if (i.IsActual) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text">posted</MudChip> }</td>
                                    <td style="text-align:right" class="fl-num"><MudText Typo="Typo.body2" Color="@(i.BalanceDeltaAmount >= 0 ? Color.Success : Color.Error)">@Format.Signed(i.BalanceDeltaAmount)</MudText></td>
                                    <td style="text-align:right" class="fl-num"><MudText Typo="Typo.body2" Color="@(p.BalanceAmount < 0 ? Color.Error : Color.Default)">@(isFirst ? Format.Money(p.BalanceAmount) : "")</MudText></td>
                                </tr>
                                first = false;
                            }
                        }
                        </tbody>
                    </MudSimpleTable>
              </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }
}
else
{
    <EmptyState Icon="@Icons.Material.Outlined.TrendingUp"
                Title="No forecast yet"
                Description="@OnboardingCopy.LoadData(Status?.Environment, "then run a forecast")" />
}

@code {
    private static string BalanceSummary(string subject, List<(DateOnly Date, decimal Balance)> pts) =>
        ChartSummary.Trend(subject, pts.Select(p => (Format.FullDate(p.Date), p.Balance)).ToList(), Format.Money);

    /// <summary>Environment from the layout; drives which empty-state instruction is shown.</summary>
    [CascadingParameter] private FlowLedger.Web.Services.LayoutStatus? Status { get; set; }

    private bool _loading = true;
    private string? _error;
    private int _horizonMonths = 3;
    private FlowLedger.Web.ApiClient.ForecastResultDto? _forecast;
    private List<FlowLedger.Contracts.AccountDto> _accounts = [];
    private IReadOnlyCollection<Guid> _selectedIds = new HashSet<Guid>();
    private string _view = "aggregate";

    private string AccountName(Guid id) => _accounts.FirstOrDefault(a => a.Id == id)?.Name ?? id.ToString()[..8];

    private async Task OnAccountsChanged(IEnumerable<Guid> ids)
    {
        _selectedIds = ids?.ToHashSet() ?? new HashSet<Guid>();
        await LoadAsync();
    }

    private void OnViewChanged(string v) => _view = v ?? "aggregate";

    private sealed record AggRow(Guid AccountId, FlowLedger.Web.ApiClient.ForecastLineItemDto Item);
    private sealed record AggGroup(DateOnly Date, decimal Balance, List<AggRow> Items);

    private List<AggGroup> AggregateRows()
    {
        if (_forecast is null) return [];
        var balances = _forecast.AggregateSeries.ToDictionary(p => p.Date, p => p.BalanceAmount);
        return _forecast.AccountSeries
            .SelectMany(s => s.Points.SelectMany(p => p.ContributingItems.Select(i => (p.Date, Row: new AggRow(s.AccountId, i)))))
            .GroupBy(x => x.Date)
            .OrderBy(g => g.Key)
            .Select(g => new AggGroup(g.Key, balances.GetValueOrDefault(g.Key), g.Select(x => x.Row).ToList()))
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await ApiClient.GetAccountsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load accounts for forecast page");
            Snackbar.Add("Couldn't load account names — account labels may be missing.", Severity.Warning);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _forecast = await ApiClient.GetForecastAsync(months: _horizonMonths, accountIds: _selectedIds.ToList());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load forecast");
            _error = ex is FlowLedger.Web.ApiClient.ApiClientException ace
                ? ace.Message
                : "Failed to load forecast data. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
