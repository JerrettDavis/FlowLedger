root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_indent_labels = one_less_than_current
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_prefer_braces = true:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning

# ---------------------------------------------------------------------------
# Analyzer severity plan (issue #113)
#
# Directory.Build.props sets AnalysisMode=Recommended and TreatWarningsAsErrors=true, so any
# rule at warning severity fails the build. The tree is clean for every rule at its Recommended
# default of warning, including the former backlog rules CA1848/CA1873 (logging goes through
# [LoggerMessage] source-generated partial methods), CA1859, CA1826, CA1822, CA1512, CA1845 and CA1725.
#
# Rules still parked at suggestion (visible in the IDE; flipping one to warning is that rule's cleanup milestone):
#   CA1716  identifiers that collide with VB keywords (Shared/Imports namespaces, parameter names such as
#           'end'/'error'); renaming changes public signatures, defer to the #121 API pass.
#   CA1068  CancellationToken-last parameter ordering; public signature change, defer to #121.
#   CA1711, CA1720, CA1001  public type/identifier naming and lifetime-shape changes, defer to #121.
# ---------------------------------------------------------------------------
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.CA1716.severity = suggestion
dotnet_diagnostic.CA1068.severity = suggestion
dotnet_diagnostic.CA1711.severity = suggestion
dotnet_diagnostic.CA1720.severity = suggestion
dotnet_diagnostic.CA1001.severity = suggestion

# ---------------------------------------------------------------------------
# Meziantou.Analyzer (#113): pinned in Directory.Packages.props, referenced for production projects only (Directory.Build.props).
# A CURATED set. Measured against this tree (3.0.340): the rules below are ON because each protects a runtime property and the tree is
# clean for them; every other rule is parked at none in eng/meziantou.globalconfig (the package's none.editorconfig plus the ON list), and
# the rules that actually report here carry their own reason below, which overrides that file. Flip one on only together with its cleanup.
#   ON  MA0009 regex match timeout (ReDoS)            MA0011 IFormatProvider / culture on Parse and ToLower
#       MA0023 RegexOptions.ExplicitCapture           MA0054 keep the inner exception when rethrowing
#       MA0061 override must not change defaults      MA0074 explicit StringComparison on path matching
#       MA0132 no implicit DateTime -> DateTimeOffset MA0134 observe the result of async calls
#       MA0158 System.Threading.Lock for lock gates   MA0008 StructLayout on structs
# ---------------------------------------------------------------------------
# Task.ConfigureAwait: ASP.NET Core, the Worker and Blazor Server code here do not rely on a SynchronizationContext; ~1,700 sites of noise.
dotnet_diagnostic.MA0004.severity = none
# File name must match type name: feature files group a request/response record set with its handler on purpose (~900 sites).
dotnet_diagnostic.MA0048.severity = none
# Prefer a collection abstraction in signatures: List/Dictionary on DTOs and records is the serialised contract; changing it changes the API surface.
dotnet_diagnostic.MA0016.severity = none
# string == vs String.Equals: ordinal == is intended and clear; churn with no behaviour change.
dotnet_diagnostic.MA0006.severity = none
# Missing IEqualityComparer on dictionaries/Contains: keys are ids and ordinal strings; the ordinal default is intended.
dotnet_diagnostic.MA0002.severity = none
# Method too long: a size heuristic with no runtime effect, left to review.
dotnet_diagnostic.MA0051.severity = none
# TODO comments: tracked as issues, not build failures.
dotnet_diagnostic.MA0026.severity = none
# EventHandler<T> for events: the Blazor services expose Action change notifications that components subscribe to; reshaping them touches every component for no behaviour change.
dotnet_diagnostic.MA0046.severity = none

# EF Core migrations are tool-generated; constant array arguments are the scaffolder's output.
[**/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none

# Test code: descriptive snake_case test names (CA1707) and micro-optimisation rules are noise.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1869.severity = none
# Test code logs ad hoc through ILogger extensions; source-generated delegates add nothing there.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.CA1875.severity = none
dotnet_diagnostic.CA1860.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA2211.severity = none
# Remaining culture hits in tests are ISO-literal Parse calls on fixture data (ratchet: pass InvariantCulture).
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
dotnet_diagnostic.CA1311.severity = suggestion

[*.{json,yaml,yml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.{razor,html}]
indent_size = 4

[Makefile]
indent_style = tab
